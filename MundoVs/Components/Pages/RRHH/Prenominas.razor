@page "/rrhh/prenominas"
@inject NavigationManager Navigation

@* Fusión prenómina→nómina: la página de prenómina se retiró (Etapa 4). La ruta sigue
   existiendo sólo para redirigir a la nómina fusionada y no romper bookmarks/links viejos.
   English: prenómina→nómina fusion — the prenomina page was retired (Stage 4). The route
   still exists only to redirect to the fused nómina and not break old bookmarks/links. *@

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Navigation.NavigateTo("/rrhh/nominas", replace: true);
        }
    }
}