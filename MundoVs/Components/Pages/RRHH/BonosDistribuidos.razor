@page "/rrhh/bonos-distribuidos"
@rendermode InteractiveServer
@using System.Text
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using MundoVs.Core.Entities
@using MundoVs.Core.Entities.Serigrafia
@using MundoVs.Core.Services
@using MundoVs.Infrastructure.Data
@inject IDbContextFactory<CrmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Bonos Distribuidos</PageTitle>

<div class="container-fluid px-4">
    @if (!_puedeVer)
    {
        <div class="alert alert-warning mt-3">No tienes permisos para ver bonos distribuidos.</div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-3 gap-2 flex-wrap">
            <div>
                <h1 class="h3 fw-bold mb-1"><i class="bi bi-percent me-2"></i>Bonos distribuidos</h1>
                <p class="text-muted mb-0">Captura por período los porcentajes de reparto para empleados con esquema de bono distribuido.</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="/configuracion/bonos"><i class="bi bi-gift me-1"></i>Maestro de bonos</a>
                <a class="btn btn-outline-secondary" href="/rrhh/nominas"><i class="bi bi-wallet2 me-1"></i>Nóminas</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }
        @if (!string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success">@ok</div>
        }

        @if (empleadoEnfoqueId.HasValue)
        {
            <div class="alert alert-primary py-2 px-3 d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
                <div>
                    <strong>Contexto desde nómina:</strong>
                    @if (!string.IsNullOrWhiteSpace(EmpleadoEnfoqueNombre))
                    {
                        <span>@EmpleadoEnfoqueNombre</span>
                    }
                    else
                    {
                        <span>Empleado filtrado</span>
                    }
                    <span class="text-muted">· @periodo</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="LimpiarEnfoqueEmpleado">Ver todos</button>
            </div>
        }

        <div class="alert alert-info py-2 px-3 small d-flex align-items-start gap-2 mb-3">
            <i class="bi bi-info-circle mt-1"></i>
            <div>
                Captura por rubro el <strong>% del rubro</strong> que gana cada empleado (0–100%; 100% = se lleva toda la asignación de ese rubro). El <strong>tope del rubro</strong> (ej. 30%) es su participación en el pool, no un límite sobre lo que capturas. El <strong>"Total %" por empleado</strong> = su % del pool = Σ(% × tope / 100), máximo Σ topes = 100%. El pool es por empleado: dos empleados al 100% cada uno es válido (no se suman entre sí).
            </div>
        </div>

        <div class="card mb-3 border-primary shadow-sm">
            <div class="card-header bg-primary text-white fw-semibold">Filtros de captura</div>
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Periodicidad</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="periodicidadSeleccionada" @bind-Value:after="OnPeriodicidadChangedAsync">
                            @foreach (var periodicidad in PeriodicidadesDisponibles)
                            {
                                <option value="@periodicidad">@periodicidad</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1" title="@ObtenerAyudaFechaReferencia(periodicidadSeleccionada)">Fecha de referencia</label>
                        <div class="d-flex gap-1 align-items-center">
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2" title="Periodo anterior" @onclick="PeriodoAnteriorAsync">‹</button>
                            <InputDate class="form-control form-control-sm" @bind-Value="fechaReferencia" @bind-Value:after="OnPeriodoEditadoAsync" />
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2" title="Periodo siguiente" @onclick="PeriodoSiguienteAsync">›</button>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Período (grilla de nómina)</label>
                        <div class="form-control form-control-sm d-flex justify-content-between align-items-center">
                            <span class="text-truncate">@periodo</span>
                            <span class="badge text-bg-light ms-2">@numeroNomina</span>
                        </div>
                        <div class="small text-muted">@fechaInicio.ToString("dd/MM/yyyy") – @fechaFin.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Área</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="departamentoFiltro">
                            <option value="">(todas)</option>
                            @foreach (var departamento in departamentosDisponibles)
                            {
                                <option value="@departamento">@departamento</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Posición</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="posicionSeleccionadaId">
                            <option value="">Seleccionar...</option>
                            <option value="@TodasLasPosicionesValue">Todas las posiciones</option>
                            @foreach (var posicion in posicionesDistribuidas)
                            {
                                <option value="@posicion.Id">@posicion.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Empleado</label>
                        <InputText class="form-control form-control-sm" @bind-Value="filtroEmpleado" placeholder="Nombre o área" />
                    </div>
                    <div class="col-xl-4 col-lg-5 col-md-12 d-flex gap-2 flex-wrap">
                        <button class="btn btn-outline-primary btn-sm" @onclick="CargarEmpleadosAsync"><i class="bi bi-search me-1"></i>Cargar empleados</button>
                        <button class="btn btn-outline-success btn-sm" @onclick="ExportarCsvAsync" disabled="@(gruposCaptura.Count == 0)"><i class="bi bi-filetype-csv me-1"></i>Exportar CSV</button>
                        @if (_puedeEditar)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="GuardarAsync" disabled="@(guardando || gruposCaptura.Count == 0)"><i class="bi bi-save me-1"></i>@(gruposCaptura.Count > 1 ? "Guardar capturas" : "Guardar captura")</button>
                        }
                    </div>
                </div>

                @if (gruposCaptura.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mt-3 small">
                        <span class="badge text-bg-light">Posiciones: @gruposCaptura.Count</span>
                        <span class="badge text-bg-light">Empleados: @TotalEmpleadosCapturados</span>
                        <span class="badge text-bg-light" title="Suma de los botes por posición (cada empleado puede ganar hasta su bote)">Monto base por posición: @MontoBaseTotal.ToString("C2")</span>
                        <span class="badge text-bg-success" title="Total pagado = Σ MontoAsignado de todos los empleados (puede exceder el base, el pool es por empleado)">Asignado: @MontoAsignadoTotal.ToString("C2")</span>
                        <span class="badge @(MontoRemanenteTotal > 0m ? "text-bg-warning" : "text-bg-light")" title="Bonus que cada empleado aún puede capturar de su bote (Σ max(0, bote − asignado por empleado))">Pendiente capturar: @MontoRemanenteTotal.ToString("C2")</span>
                    </div>
                }
            </div>
        </div>

        @if (_catalogosCargados)
        {
            <div class="card mb-3 shadow-sm border-@(nominasPeriodo.Count > 0 ? "success" : "warning")">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between gap-2 flex-wrap small">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <i class="bi bi-wallet2"></i>
                        <span class="fw-semibold">Nómina de este periodo:</span>
                        @if (nominasPeriodo.Count == 0)
                        {
                            <span class="text-warning-emphasis">No hay nómina para este periodo — el bono se guardará pero no llegará al recibo hasta que exista una nómina con estas fechas exactas (@fechaInicio.ToString("dd/MM/yyyy") – @fechaFin.ToString("dd/MM/yyyy")).</span>
                        }
                        else
                        {
                            @foreach (var n in nominasPeriodo)
                            {
                                <span class="badge @EstatusBadge(n.Estatus)">@n.Estatus</span>
                            }
                            <span class="text-muted">El bono se aplicará a esta(s) nómina(s) al Cerrar y calcular.</span>
                        }
                    </div>
                    <a class="btn btn-outline-secondary btn-sm" href="/rrhh/nominas"><i class="bi bi-box-arrow-up-right me-1"></i>Ver nóminas</a>
                </div>
            </div>
        }

        @if (gruposCaptura.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center text-muted py-5">
                    Selecciona un período y una posición para capturar la distribución. También puedes elegir <strong>Todas las posiciones</strong> para revisar varias tablas a la vez.
                </div>
            </div>
        }
        else
        {
            @foreach (var grupo in gruposCaptura.OrderBy(g => g.PosicionOrden).ThenBy(g => g.PosicionNombre))
            {
                var empleadosVisibles = ObtenerEmpleadosVisibles(grupo);
                <div class="card mb-3 shadow-sm border-@(GrupoDentroDeTopes(grupo) ? "success" : "danger")">
                    <div class="card-header bg-light d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
                        <div>
                            <div class="fw-semibold">@grupo.PosicionNombre</div>
                            <div class="small text-muted">@(string.IsNullOrWhiteSpace(grupo.EstructuraNombre) ? "Sin estructura" : grupo.EstructuraNombre) · @grupo.TipoCapturaTexto</div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 small">
                            @if (_puedeEditar)
                            {
                                // Monto base editable por periodo: al cambiarlo recalcula los montos
                                // por empleado de este periodo (RecalcularMontos). Así se puede abrir el
                                // periodo que se quiera, ajustar el monto y re-aplicar el bono sin tocar el
                                // maestro de Configuración (que sigue siendo forward-looking). El guardado
                                // persiste el nuevo MontoTotalDistribuir en la captura del periodo.
                                // English: Per-period editable base amount: changing it recalculates every
                                // employee's monto for this period (RecalcularMontos). So you can open any
                                // period, adjust the amount and re-apply the bonus without touching the
                                // Configuración master (which stays forward-looking). Saving persists the
                                // new MontoTotalDistribuir into the period capture.
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted">Monto base:</span>
                                    <InputNumber class="form-control form-control-sm text-end" style="max-width:130px" @bind-Value="grupo.MontoTotalDistribuir" @bind-Value:after="OnDistribucionRubroChangedAsync" />
                                </div>
                            }
                            else
                            {
                                <span class="badge text-bg-light">Monto base: @grupo.MontoTotalDistribuir.ToString("C2")</span>
                            }
                            <span class="badge text-bg-light">Empleados: @grupo.Empleados.Count</span>
                            @if (filtroEmpleadoActivo || empleadoEnfoqueId.HasValue)
                            {
                                <span class="badge text-bg-primary">Visibles: @empleadosVisibles.Count</span>
                            }
                            <span class="badge @(GrupoDentroDeTopes(grupo) ? "text-bg-success" : "text-bg-danger")" title="Promedio capturado por empleado (el tope es por empleado, no la suma del grupo)">Capturado: @ObtenerPromedioCapturaGrupo(grupo).ToString("0.##")%</span>
                            <span class="badge text-bg-light" title="Promedio pendiente por empleado hasta su tope personal">Remanente: @ObtenerRemanentePromedioGrupo(grupo).ToString("0.##")%</span>
                            <span class="badge text-bg-success">Asignado: @ObtenerMontoGrupo(grupo).ToString("C2")</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="px-3 py-2 border-bottom bg-body-tertiary">
                            <div class="row g-2 align-items-end">
                                <div class="col-lg-5 col-md-12">
                                    <label class="form-label small mb-1">Observaciones</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="grupo.Observaciones" />
                                </div>
                                <div class="col-lg-7 col-md-12">
                                    <div class="small text-muted">
                                        Rubros: @string.Join(", ", grupo.Rubros.Select(r => $"{r.Nombre} {r.TopePorcentaje:0.##}%"))
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th rowspan="2">Empleado</th>
                                        <th rowspan="2">Área</th>
                                        @foreach (var rubro in grupo.Rubros)
                                        {
                                            <th class="text-center" @key="@($"tope-{grupo.PosicionId}-{rubro.BonoRubroRrhhId}")">@rubro.TopePorcentaje.ToString("0.##")%</th>
                                        }
                                        <th rowspan="2" class="text-end">Total %</th>
                                        <th rowspan="2" class="text-end">Monto</th>
                                    </tr>
                                    <tr>
                                        @foreach (var rubro in grupo.Rubros)
                                        {
                                            <th class="text-center" @key="@($"nombre-{grupo.PosicionId}-{rubro.BonoRubroRrhhId}")">@rubro.Nombre</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (grupo.Empleados.Count == 0)
                                    {
                                        <tr><td colspan="@(grupo.Rubros.Count + 4)" class="text-center text-muted py-4">No hay empleados activos para esta posición con los filtros seleccionados.</td></tr>
                                    }
                                    else if (empleadosVisibles.Count == 0)
                                    {
                                        <tr><td colspan="@(grupo.Rubros.Count + 4)" class="text-center text-muted py-4">No hay empleados visibles con el filtro actual para esta posición.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in empleadosVisibles)
                                        {
                                            <tr class="@(EsEmpleadoEnfocado(item) ? "table-warning" : string.Empty)" @key="@($"{grupo.PosicionId}-{item.EmpleadoId}")">
                                                <td class="fw-semibold">@item.NombreEmpleado</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.Departamento) ? "—" : item.Departamento)</td>

                                                @foreach (var rubro in item.Detalles.OrderBy(d => d.Orden))
                                                {
                                                    <td class="text-end" style="min-width:140px" @key="@rubro.Id">
                                                        <InputNumber class="form-control form-control-sm text-end" @bind-Value="rubro.Porcentaje" @bind-Value:after="OnDistribucionRubroChangedAsync" />
                                                        <div class="small text-muted text-end mt-1">@rubro.MontoAsignado.ToString("C2")</div>
                                                    </td>
                                                }

                                                <td class="text-end fw-semibold @(ObtenerTotalFila(item) > ObtenerTopeTotalGrupo(grupo) ? "text-danger" : string.Empty)">@ObtenerTotalFila(item).ToString("0.##")%</td>
                                                <td class="text-end">@ObtenerMontoFila(item).ToString("C2")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                @if (grupo.Empleados.Count > 0)
                                {
                                    <tfoot>
                                        <tr class="table-light fw-semibold">
                                            <td colspan="2" class="text-end">Totales</td>
                                            @foreach (var rubro in grupo.Rubros)
                                            {
                                                var totalRubro = ObtenerTotalRubro(grupo, rubro.BonoRubroRrhhId);
                                                <td class="text-end text-muted" @key="@($"total-{grupo.PosicionId}-{rubro.BonoRubroRrhhId}")" title="Promedio capturado por empleado (el pool es por empleado, no compartido)">
                                                    @totalRubro.ToString("0.##")%
                                                </td>
                                            }
                                            <td class="text-end @(GrupoDentroDeTopes(grupo) ? string.Empty : "text-danger")">@ObtenerPromedioCapturaGrupo(grupo).ToString("0.##")%</td>
                                            <td class="text-end">@ObtenerMontoGrupo(grupo).ToString("C2")</td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

<style>
    .table td,
    .table th {
        vertical-align: middle;
    }
</style>

@code {
    private const string TodasLasPosicionesValue = "__TODAS__";
    [SupplyParameterFromQuery(Name = "inicio")]
    public DateTime? InicioQuery { get; set; }

    [SupplyParameterFromQuery(Name = "fin")]
    public DateTime? FinQuery { get; set; }

    [SupplyParameterFromQuery(Name = "posicionId")]
    public string? PosicionIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "empleadoId")]
    public string? EmpleadoIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "autocargar")]
    public bool? AutocargarQuery { get; set; }

    private List<string> departamentosDisponibles = [];
    private List<Posicion> posicionesDistribuidas = [];
    private List<PosicionCapturaDistribucion> gruposCaptura = [];
    private NominaCorteRrhh corteSemanal = new() { PeriodicidadPago = PeriodicidadPago.Semanal, DiaCorteSemana = DayOfWeek.Sunday, DiaPagoSugerido = DayOfWeek.Friday, IsActive = true };
    private NominaCorteRrhh corteQuincenal = new() { PeriodicidadPago = PeriodicidadPago.Quincenal, DiaCorteMes = 15, DiaPagoSugerido = DayOfWeek.Friday, IsActive = true };
    private NominaCorteRrhh corteMensual = new() { PeriodicidadPago = PeriodicidadPago.Mensual, DiaCorteMes = 31, DiaPagoSugerido = DayOfWeek.Friday, IsActive = true };
    // Periodicidad activa en el picker. El bono distribuido se captura sobre un periodo de
    // nómina concreto; el selector deja al usuario escoger la grilla (Semanal/Quincenal/Mensual)
    // y las fechas se reajustan a esa grilla — así siempre coinciden con una Nomina real y el
    // bono fluye al recibo al "Cerrar y calcular". // English: active periodicity in the picker.
    // The distributed bonus is captured against a concrete payroll period; the selector lets the
    // user pick the grid (Semanal/Quincenal/Mensual) and the dates re-snap to that grid — so they
    // always match a real Nomina and the bonus flows to the receipt on "Close and calculate".
    private PeriodicidadPago periodicidadSeleccionada = PeriodicidadPago.Semanal;
    private DateTime fechaReferencia = DateTime.Today;
    private DateTime fechaInicio;
    private DateTime fechaFin;
    private string periodo = string.Empty;
    private string numeroNomina = string.Empty;
    // Nóminas de la empresa cuyas fechas coinciden exactamente con el periodo seleccionado. El
    // bono capturado aquí se aplica a estas nóminas al "Cerrar y calcular" — si la lista está
    // vacía, el bono se guarda pero no llega al recibo hasta que exista una nómina con estas
    // fechas. // English: company nóminas whose dates exactly match the selected period. The
    // bonus captured here is applied to these nóminas on "Close and calculate" — if the list is
    // empty, the bonus is saved but won't reach the receipt until a nómina with these dates exists.
    private List<Nomina> nominasPeriodo = [];
    private static IReadOnlyList<PeriodicidadPago> PeriodicidadesDisponibles { get; } = [PeriodicidadPago.Semanal, PeriodicidadPago.Quincenal, PeriodicidadPago.Mensual];
    private string? departamentoFiltro = string.Empty;
    private string? filtroEmpleado;
    private string posicionSeleccionadaId = string.Empty;
    private bool guardando;
    private bool _puedeVer;
    private bool _puedeEditar;
    private Guid _empresaId;
    private string? error;
    private string? ok;
    private bool _disposed;
    private bool _catalogosCargados;
    private Guid? empleadoEnfoqueId;
    private string? _firmaContextoAplicado;
    private string? EmpleadoEnfoqueNombre => empleadoEnfoqueId.HasValue
        ? gruposCaptura.SelectMany(g => g.Empleados).FirstOrDefault(e => e.EmpleadoId == empleadoEnfoqueId.Value)?.NombreEmpleado
        : null;
    private bool filtroEmpleadoActivo => !string.IsNullOrWhiteSpace(filtroEmpleado);
    private int TotalEmpleadosCapturados => gruposCaptura.Sum(g => g.Empleados.Count);
    // "Monto base por posición": MontoTotalDistribuir es el pool POR POSICIÓN (un bote por
    // posición), no el presupuesto total — cada empleado puede ganar hasta el bote completo
    // (pool por-empleado). Se suma por posición sólo para mostrar el total de botes configurados,
    // NO como tope de gasto. / "Base amount per position": MontoTotalDistribuir is the PER-POSITION
    // pool (one pot per position), not the total budget — each employee can earn up to the full
    // pot (per-employee pool). Summed per position just to show total configured pots, NOT a
    // spend ceiling.
    private decimal MontoBaseTotal => gruposCaptura.Sum(g => g.MontoTotalDistribuir);
    // Total pagado = Σ MontoAsignado de todos los empleados. Puede exceder MontoBaseTotal porque
    // el pool es por-empleado: 2 empleados al 100% pagan 2× el bote. / Total paid = Σ MontoAsignado
    // of all employees. Can exceed MontoBaseTotal because the pool is per-employee: 2 employees
    // at 100% pay 2× the pot.
    private decimal MontoAsignadoTotal => gruposCaptura.Sum(ObtenerMontoGrupo);
    // Pendiente por capturar = capacidad NO capturada por empleado = Σ empleados max(0, bote −
    // MontoAsignado). El pool es por-empleado, así que "base − asignado" no tiene sentido (el
    // asignado puede superar a la base); lo significativo es cuánto bonus le queda a cada
    // empleado por capturar de SU bote. / Uncaptured capacity = per-employee headroom = Σ
    // employees max(0, pot − MontoAsignado). The pool is per-employee, so "base − assigned" is
    // meaningless (assigned can exceed base); what's meaningful is how much bonus each employee
    // still has left to capture from THEIR pot.
    private decimal MontoRemanenteTotal => gruposCaptura.Sum(g =>
        g.Empleados.Sum(e => Math.Max(0m, g.MontoTotalDistribuir - e.MontoAsignado)));

    protected override async Task OnInitializedAsync()
    {
        await CargarAccesoAsync();
        if (_disposed)
            return;

        if (_puedeVer)
        {
            await CargarConfiguracionAsync();
            if (_disposed)
                return;

            await CargarCatalogosAsync();
            if (_disposed)
                return;

            _catalogosCargados = true;

            await InicializarPeriodoAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_puedeVer || !_catalogosCargados || _disposed)
            return;

        var firma = string.Join("|",
            InicioQuery?.ToString("yyyy-MM-dd") ?? string.Empty,
            FinQuery?.ToString("yyyy-MM-dd") ?? string.Empty,
            PosicionIdQuery ?? string.Empty,
            EmpleadoIdQuery ?? string.Empty,
            AutocargarQuery?.ToString() ?? string.Empty);

        if (firma == _firmaContextoAplicado)
            return;

        _firmaContextoAplicado = firma;
        await AplicarContextoConsultaAsync();
    }

    private async Task CargarAccesoAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _puedeVer = state.User.HasClaim("Capacidad", "nominas.ver");
        _puedeEditar = state.User.HasClaim("Capacidad", "nominas.editar");
        _ = Guid.TryParse(state.User.FindFirst("EmpresaId")?.Value, out _empresaId);
    }

    private async Task CargarConfiguracionAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (_disposed)
            return;

        // Carga los tres cortes de la empresa (espejo de Nominas.razor). El picker de bonos
        // soporta las tres periodicidades para que la captura se alinee a la grilla de la
        // nómina real del empleado, sea semanal, quincenal o mensual. // English: load all three
        // company cortes (mirrors Nominas.razor). The bonus picker supports the three
        // periodicities so the capture aligns to the real payroll grid — weekly, biweekly or monthly.
        corteSemanal = await CargarCortePeriodoAsync(db, PeriodicidadPago.Semanal, 31);
        corteQuincenal = await CargarCortePeriodoAsync(db, PeriodicidadPago.Quincenal, 15);
        corteMensual = await CargarCortePeriodoAsync(db, PeriodicidadPago.Mensual, 31);
    }

    private async Task<NominaCorteRrhh> CargarCortePeriodoAsync(CrmDbContext db, PeriodicidadPago periodicidad, int diaCorteMesDefault)
        => await db.NominaCortesRrhh
            .AsNoTracking()
            .FirstOrDefaultAsync(c => c.EmpresaId == _empresaId && c.PeriodicidadPago == periodicidad && c.IsActive)
            ?? new NominaCorteRrhh
            {
                EmpresaId = _empresaId,
                PeriodicidadPago = periodicidad,
                DiaCorteSemana = DayOfWeek.Sunday,
                DiaCorteMes = diaCorteMesDefault,
                DiaPagoSugerido = DayOfWeek.Friday,
                IsActive = true
            };

    private NominaCorteRrhh ObtenerCortePeriodo(PeriodicidadPago periodicidad)
        => periodicidad switch
        {
            PeriodicidadPago.Quincenal => corteQuincenal,
            PeriodicidadPago.Mensual => corteMensual,
            _ => corteSemanal
        };

    private static string ObtenerAyudaFechaReferencia(PeriodicidadPago periodicidadPago)
        => periodicidadPago switch
        {
            PeriodicidadPago.Quincenal => "Elige cualquier fecha dentro de la quincena que quieres capturar.",
            PeriodicidadPago.Mensual => "Elige cualquier fecha dentro del mes o período mensual que quieres capturar.",
            _ => "Elige cualquier fecha dentro de la semana que quieres capturar."
        };

    // Badge de estatus de nómina (réplica mínima de Nominas.razor para el panel emparejado).
    // English: nómina status badge (minimal replica of Nominas.razor for the matched-period panel).
    private static string EstatusBadge(EstatusNomina e) => e switch
    {
        EstatusNomina.Borrador => "bg-secondary",
        EstatusNomina.Aprobada => "bg-info",
        EstatusNomina.Pagada => "bg-success",
        EstatusNomina.Cancelada => "bg-danger",
        _ => "bg-light"
    };

    private async Task CargarCatalogosAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (_disposed)
            return;

        posicionesDistribuidas = await db.Posiciones
            .AsNoTracking()
            .Include(p => p.BonoEstructuraRrhh)
                .ThenInclude(e => e!.Detalles)
                    .ThenInclude(d => d.BonoRubroRrhh)
            .Where(p => p.IsActive && p.BonoEstructuraRrhhId.HasValue && p.BonoEstructuraRrhh != null && p.BonoEstructuraRrhh.TipoCaptura == TipoCapturaBonoNomina.TotalDistribuido)
            .OrderBy(p => p.Orden)
            .ThenBy(p => p.Nombre)
            .ToListAsync();

        var departamentosCatalogo = await db.DepartamentosRrhh
            .AsNoTracking()
            .Where(d => d.IsActive)
            .OrderBy(d => d.Orden)
            .ThenBy(d => d.Nombre)
            .Select(d => d.Nombre)
            .ToListAsync();

        var departamentosEmpleados = await db.Empleados
            .AsNoTracking()
            .Where(e => e.IsActive && !string.IsNullOrWhiteSpace(e.Departamento))
            .Select(e => e.Departamento!)
            .Distinct()
            .ToListAsync();

        departamentosDisponibles = departamentosCatalogo
            .Concat(departamentosEmpleados)
            .Where(d => !string.IsNullOrWhiteSpace(d))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(d => d)
            .ToList();
    }

    private async Task AplicarContextoConsultaAsync()
    {
        var tieneContexto = InicioQuery.HasValue
            || FinQuery.HasValue
            || !string.IsNullOrWhiteSpace(PosicionIdQuery)
            || !string.IsNullOrWhiteSpace(EmpleadoIdQuery)
            || AutocargarQuery == true;

        if (!tieneContexto)
            return;

        // Si viene de una nómina (AbrirDistribucionBonos pasa inicio/fin exactos), inferir la
        // periodicidad probando cada corte: la que reproduzca esas fechas exactas con la grilla
        // de la empresa es la grilla de esa nómina. Así el picker arranca ya alineado. Si ninguna
        // coincide (fechas no-estándar), se dejan las fechas del query forzadas para no romper el
        // flujo desde la nómina. // English: when coming from a nómina (which passes exact
        // inicio/fin), infer the periodicity by trying each corte: the one that reproduces those
        // exact dates with the company grid is that nómina's grid. If none matches (non-standard
        // dates), the query dates are forced so the flow from the nómina doesn't break.
        var forzarFechasQuery = false;
        if (InicioQuery.HasValue && FinQuery.HasValue)
        {
            var inicioQ = InicioQuery.Value.Date;
            var finQ = FinQuery.Value.Date;
            var periodicidadInferida = (PeriodicidadPago?)null;
            foreach (var p in PeriodicidadesDisponibles)
            {
                var cal = NominaPeriodoHelper.ObtenerPeriodoContenedor(p, inicioQ, ObtenerCortePeriodo(p));
                if (cal.Inicio == inicioQ && cal.Fin == finQ)
                {
                    periodicidadInferida = p;
                    break;
                }
            }
            fechaReferencia = inicioQ;
            if (periodicidadInferida is not null)
            {
                periodicidadSeleccionada = periodicidadInferida.Value;
            }
            else
            {
                // Fechas no-estándar (nómina fuera de grilla): forzarlas tal cual, sin re-snap.
                // English: non-standard dates (off-grid nómina): force them as-is, no re-snap.
                periodicidadSeleccionada = PeriodicidadPago.Semanal;
                fechaInicio = inicioQ;
                fechaFin = finQ;
                periodo = NominaPeriodoHelper.ConstruirEtiquetaSemanal(inicioQ, finQ);
                numeroNomina = NominaPeriodoHelper.ConstruirNumeroNomina(PeriodicidadPago.Semanal, inicioQ, finQ);
                forzarFechasQuery = true;
            }
        }
        else if (InicioQuery.HasValue)
        {
            fechaReferencia = InicioQuery.Value.Date;
        }

        if (forzarFechasQuery)
            await CargarNominasPeriodoAsync();
        else
            await OnPeriodoEditadoAsync();

        if (!string.IsNullOrWhiteSpace(PosicionIdQuery))
            posicionSeleccionadaId = PosicionIdQuery!;

        empleadoEnfoqueId = Guid.TryParse(EmpleadoIdQuery, out var empleadoId) ? empleadoId : null;

        if (AutocargarQuery == true || !string.IsNullOrWhiteSpace(posicionSeleccionadaId))
            await CargarEmpleadosAsync();
    }

    private Task InicializarPeriodoAsync()
    {
        fechaReferencia = DateTime.Today;
        return RecomputarPeriodoAsync();
    }

    // Recalcula inicio/fin/periodo a partir de fechaReferencia + periodicidad + corte de la
    // empresa, usando la MISMA grilla que la página de nóminas
    // (NominaPeriodoHelper.ObtenerPeriodoContenedor). Así las fechas del bono siempre coinciden
    // con una Nomina real y el bono fluye al recibo al "Cerrar y calcular". También normaliza
    // fechaReferencia al inicio del periodo (prev/next estables) y refresca las nóminas
    // emparejadas. // English: recomputes inicio/fin/periodo from fechaReferencia + periodicity +
    // company corte, using the SAME grid as the payroll page. So bonus dates always match a real
    // Nomina and the bonus flows to the receipt on "Close and calculate". Also normalizes
    // fechaReferencia to the period start (stable prev/next) and refreshes the matched nóminas.
    private async Task RecomputarPeriodoAsync()
    {
        var cal = NominaPeriodoHelper.ObtenerPeriodoContenedor(
            periodicidadSeleccionada, fechaReferencia, ObtenerCortePeriodo(periodicidadSeleccionada));
        fechaInicio = cal.Inicio;
        fechaFin = cal.Fin;
        periodo = cal.Periodo;
        numeroNomina = cal.NumeroNomina;
        fechaReferencia = cal.Inicio;

        await CargarNominasPeriodoAsync();
    }

    // @bind-Value:after del InputDate de fechaReferencia y del InputSelect de periodicidad:
    // re-snap a la grilla tras cualquier edición. // English: @bind-Value:after for the
    // fechaReferencia InputDate and the periodicity InputSelect: re-snap to the grid after any edit.
    private Task OnPeriodoEditadoAsync() => RecomputarPeriodoAsync();

    private Task OnPeriodicidadChangedAsync() => RecomputarPeriodoAsync();

    private async Task PeriodoAnteriorAsync()
    {
        var cal = NominaPeriodoHelper.ObtenerPeriodoContenedor(
            periodicidadSeleccionada, fechaReferencia, ObtenerCortePeriodo(periodicidadSeleccionada));
        fechaReferencia = cal.FechaReferenciaAnterior();
        await RecomputarPeriodoAsync();
    }

    private async Task PeriodoSiguienteAsync()
    {
        var cal = NominaPeriodoHelper.ObtenerPeriodoContenedor(
            periodicidadSeleccionada, fechaReferencia, ObtenerCortePeriodo(periodicidadSeleccionada));
        fechaReferencia = cal.FechaReferenciaSiguiente();
        await RecomputarPeriodoAsync();
    }

    // Nóminas de la empresa cuyas fechas coinciden exactamente con el periodo seleccionado (excluye
    // canceladas). Es el match que usa la sincronización de nómina para aplicar el bono al recibo.
    // English: company nóminas whose dates exactly match the selected period (excludes cancelled).
    // This is the match the payroll sync uses to apply the bonus to the receipt.
    private async Task CargarNominasPeriodoAsync()
    {
        if (_empresaId == Guid.Empty)
        {
            nominasPeriodo = [];
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (_disposed)
            return;
        nominasPeriodo = await db.Nominas
            .AsNoTracking()
            .Where(n => n.EmpresaId == _empresaId
                && n.FechaInicio == fechaInicio.Date
                && n.FechaFin == fechaFin.Date
                && n.Estatus != EstatusNomina.Cancelada)
            .OrderBy(n => n.CreatedAt)
            .ToListAsync();
    }

    private async Task CargarEmpleadosAsync()
    {
        if (_disposed)
            return;

        error = ok = null;
        gruposCaptura = [];

        var posicionesSeleccionadas = ObtenerPosicionesFiltradas();
        if (posicionesSeleccionadas.Count == 0)
        {
            error = "Selecciona una posición.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var posiciones = await db.Posiciones
            .AsNoTracking()
            .Include(p => p.BonoEstructuraRrhh)
                .ThenInclude(e => e!.Detalles)
                    .ThenInclude(d => d.BonoRubroRrhh)
            .Where(p => posicionesSeleccionadas.Contains(p.Id))
            .OrderBy(p => p.Orden)
            .ThenBy(p => p.Nombre)
            .ToListAsync();

        if (_disposed)
            return;

        if (posiciones.Count == 0)
        {
            error = "La posición seleccionada no tiene un esquema de bono distribuido.";
            return;
        }

        if (posiciones.Any(p => p.BonoEstructuraRrhh?.TipoCaptura != TipoCapturaBonoNomina.TotalDistribuido))
        {
            error = "Una de las posiciones seleccionadas no tiene un esquema de bono distribuido.";
            return;
        }

        var departamento = NormalizarDepartamento(departamentoFiltro);
        var empleados = await db.Empleados
            .AsNoTracking()
            .Where(e => e.IsActive && e.PosicionId.HasValue && posicionesSeleccionadas.Contains(e.PosicionId.Value) && (departamento == null || e.Departamento == departamento))
            .OrderBy(e => e.Nombre)
            .ThenBy(e => e.ApellidoPaterno)
            .ToListAsync();

        var capturas = await db.BonosDistribucionesPeriodoRrhh
            .AsNoTracking()
            .Include(c => c.Detalles)
                .ThenInclude(d => d.Detalles)
            .Where(c => c.IsActive
                && c.FechaInicio == fechaInicio.Date
                && c.FechaFin == fechaFin.Date
                && posicionesSeleccionadas.Contains(c.PosicionId)
                && c.Departamento == departamento)
            .ToListAsync();

        if (_disposed)
            return;

        gruposCaptura = posiciones.Select(posicion =>
        {
            var captura = capturas.FirstOrDefault(c => c.PosicionId == posicion.Id);
            var detallesPorEmpleado = captura?.Detalles.ToDictionary(d => d.EmpleadoId, d => d) ?? [];
            var rubros = posicion.BonoEstructuraRrhh?.Detalles
                .Where(d => d.IsActive && d.BonoRubroRrhh.IsActive)
                .OrderBy(d => d.Orden)
                .ThenBy(d => d.BonoRubroRrhh.Nombre)
                .Select(d => new RubroPosicionDistribucion
                {
                    BonoRubroRrhhId = d.BonoRubroRrhhId,
                    Nombre = d.BonoRubroRrhh.Nombre,
                    TopePorcentaje = d.Porcentaje,
                    Orden = d.Orden
                })
                .ToList() ?? [];

            var empleadosPosicion = empleados
                .Where(e => e.PosicionId == posicion.Id)
                .OrderBy(e => e.NombreCompleto)
                .Select(e =>
                {
                    var detalle = detallesPorEmpleado.GetValueOrDefault(e.Id);
                    var detallesRubro = detalle?.Detalles.ToDictionary(d => d.BonoRubroRrhhId, d => d) ?? [];
                    return new EmpleadoCapturaDistribucion
                    {
                        EmpleadoId = e.Id,
                        NombreEmpleado = e.NombreCompleto,
                        Departamento = e.Departamento,
                        Detalles = rubros.Select(rubro =>
                        {
                            var detalleRubro = detallesRubro.GetValueOrDefault(rubro.BonoRubroRrhhId);
                            return new RubroCapturaDistribucion
                            {
                                BonoRubroRrhhId = rubro.BonoRubroRrhhId,
                                RubroNombre = rubro.Nombre,
                                TopePorcentaje = rubro.TopePorcentaje,
                                Orden = rubro.Orden,
                                Porcentaje = detalleRubro?.Porcentaje ?? 0m,
                                MontoAsignado = detalleRubro?.MontoAsignado ?? 0m
                            };
                        }).ToList()
                    };
                })
                .ToList();

            var grupo = new PosicionCapturaDistribucion
            {
                CapturaId = captura?.Id ?? Guid.Empty,
                PosicionId = posicion.Id,
                PosicionNombre = posicion.Nombre,
                PosicionOrden = posicion.Orden,
                BonoEstructuraRrhhId = posicion.BonoEstructuraRrhhId,
                EstructuraNombre = posicion.BonoEstructuraRrhh?.Nombre,
                TipoCapturaTexto = posicion.BonoEstructuraRrhh?.TipoCaptura.ToString() ?? "—",
                Departamento = departamento,
                MontoTotalDistribuir = captura?.MontoTotalDistribuir > 0m ? captura.MontoTotalDistribuir : posicion.MontoBonoDistribuido,
                Observaciones = captura?.Observaciones,
                Rubros = rubros,
                Empleados = empleadosPosicion
            };

            RecalcularGrupo(grupo);
            return grupo;
        })
        .Where(g => g.Rubros.Count > 0)
        .ToList();

        if (gruposCaptura.All(g => g.MontoTotalDistribuir <= 0m))
        {
            error = "Las posiciones seleccionadas no tienen monto configurado para distribuir. Configúralo en Bonos de Nómina.";
            gruposCaptura = [];
            return;
        }

        if (gruposCaptura.Sum(g => g.Empleados.Count) == 0)
            ok = "No se encontraron empleados activos con los filtros seleccionados.";

        if (empleadoEnfoqueId.HasValue && gruposCaptura.SelectMany(g => g.Empleados).All(e => e.EmpleadoId != empleadoEnfoqueId.Value))
            ok = "Se cargó la captura, pero el empleado enviado desde nómina no aparece en esta distribución.";
    }

    private Task OnDistribucionRubroChangedAsync()
    {
        RecalcularMontos();
        return Task.CompletedTask;
    }

    private void RecalcularMontos()
    {
        foreach (var grupo in gruposCaptura)
            RecalcularGrupo(grupo);
    }

    private async Task GuardarAsync()
    {
        if (_disposed)
            return;

        error = ok = null;
        if (!_puedeEditar)
        {
            error = "No tienes permisos para editar bonos distribuidos.";
            return;
        }

        if (gruposCaptura.Count == 0)
        {
            error = "No hay empleados para guardar.";
            return;
        }

        foreach (var grupo in gruposCaptura)
        {
            var errorValidacion = ValidarGrupo(grupo);
            if (!string.IsNullOrWhiteSpace(errorValidacion))
            {
                error = errorValidacion;
                return;
            }
        }

        guardando = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            foreach (var grupo in gruposCaptura)
                await GuardarGrupoAsync(db, grupo);

            await db.SaveChangesAsync();

            if (_disposed)
                return;

            ok = gruposCaptura.Count > 1 ? "Capturas de bonos guardadas." : "Distribución de bonos guardada.";
            await CargarEmpleadosAsync();
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private static string? NormalizarDepartamento(string? departamento)
        => string.IsNullOrWhiteSpace(departamento) ? null : departamento.Trim();

    private List<Guid> ObtenerPosicionesFiltradas()
    {
        if (string.IsNullOrWhiteSpace(posicionSeleccionadaId))
            return [];

        if (posicionSeleccionadaId == TodasLasPosicionesValue)
            return posicionesDistribuidas.Select(p => p.Id).ToList();

        return Guid.TryParse(posicionSeleccionadaId, out var posicionId) ? [posicionId] : [];
    }

    private List<EmpleadoCapturaDistribucion> ObtenerEmpleadosVisibles(PosicionCapturaDistribucion grupo)
        => grupo.Empleados
            .Where(EsEmpleadoVisible)
            .OrderBy(e => e.NombreEmpleado)
            .ToList();

    private bool EsEmpleadoVisible(EmpleadoCapturaDistribucion empleado)
    {
        var coincideEnfoque = !empleadoEnfoqueId.HasValue || empleado.EmpleadoId == empleadoEnfoqueId.Value;
        if (!coincideEnfoque)
            return false;

        if (string.IsNullOrWhiteSpace(filtroEmpleado))
            return true;

        var filtro = filtroEmpleado.Trim();
        return empleado.NombreEmpleado.Contains(filtro, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(empleado.Departamento) && empleado.Departamento.Contains(filtro, StringComparison.OrdinalIgnoreCase));
    }

    private bool EsEmpleadoEnfocado(EmpleadoCapturaDistribucion empleado)
        => empleadoEnfoqueId.HasValue && empleado.EmpleadoId == empleadoEnfoqueId.Value;

    private void LimpiarEnfoqueEmpleado()
    {
        empleadoEnfoqueId = null;
        filtroEmpleado = null;
    }

    private void RecalcularGrupo(PosicionCapturaDistribucion grupo)
    {
        foreach (var item in grupo.Empleados)
        {
            foreach (var detalle in item.Detalles)
                detalle.MontoAsignado = Math.Round(grupo.MontoTotalDistribuir * (detalle.Porcentaje / 100m) * (detalle.TopePorcentaje / 100m), 2);

            item.PorcentajeTotal = item.Detalles.Sum(d => (d.Porcentaje / 100m) * (d.TopePorcentaje / 100m) * 100m);
            item.MontoAsignado = item.Detalles.Sum(d => d.MontoAsignado);
        }
    }

    private string? ValidarGrupo(PosicionCapturaDistribucion grupo)
    {
        if (grupo.BonoEstructuraRrhhId is null)
            return $"La posición {grupo.PosicionNombre} no tiene una estructura de bono válida.";

        if (grupo.MontoTotalDistribuir <= 0m)
            return $"La posición {grupo.PosicionNombre} no tiene monto válido para distribuir.";

        // Porcentaje (por rubro y empleado) = fracción del rubro que gana el empleado (0–100%;
        // 100% = se lleva toda la asignación del rubro). TopePorcentaje = participación del rubro
        // en el pool (ej. 30%), NO un cap sobre Porcentaje. El "Total %" por empleado =
        // Σ (Porcentaje × Tope / 100) = su % del pool, máximo Σ Tope = 100%. Por eso dos
        // empleados al 100% cada uno es válido (el pool es POR EMPLEADO, no compartido): NO se
        // suma el Porcentaje de todos los empleados contra el tope — eso trata al tope como
        // bolsa compartida y bloquea guardados legítimos (bug: 2×100%=200%>100%).
        // English: Porcentaje (per rubro & employee) = fraction of the rubro the employee earns
        // (0–100%; 100% = takes the rubro's whole allocation). TopePorcentaje = the rubro's share
        // of the pool (e.g. 30%), NOT a cap on Porcentaje. The per-employee "Total %" =
        // Σ (Porcentaje × Tope / 100) = their % of the pool, max Σ Tope = 100%. That's why two
        // employees at 100% each is valid (the pool is PER EMPLOYEE, not shared): do NOT sum all
        // employees' Porcentaje against the tope — that treats the tope as a shared pool and
        // blocks legitimate saves (bug: 2×100%=200%>100%).
        foreach (var item in grupo.Empleados)
        {
            foreach (var detalle in item.Detalles)
            {
                if (detalle.Porcentaje < 0m)
                    return $"El rubro {detalle.RubroNombre} de {item.NombreEmpleado} no puede ser negativo.";

                if (Math.Round(detalle.Porcentaje, 2) > 100m)
                    return $"El rubro {detalle.RubroNombre} de {item.NombreEmpleado} no puede exceder 100%.";
            }
        }

        return null;
    }

    private async Task GuardarGrupoAsync(CrmDbContext db, PosicionCapturaDistribucion grupo)
    {
        var captura = grupo.CapturaId == Guid.Empty
            ? null
            : await db.BonosDistribucionesPeriodoRrhh
                .Include(c => c.Detalles)
                    .ThenInclude(d => d.Detalles)
                .FirstOrDefaultAsync(c => c.Id == grupo.CapturaId);

        if (_disposed)
            return;

        if (captura == null)
        {
            captura = new BonoDistribucionPeriodoRrhh
            {
                Id = Guid.NewGuid(),
                EmpresaId = _empresaId,
                Periodo = periodo,
                FechaInicio = fechaInicio.Date,
                FechaFin = fechaFin.Date,
                Departamento = grupo.Departamento,
                PosicionId = grupo.PosicionId,
                BonoEstructuraRrhhId = grupo.BonoEstructuraRrhhId!.Value,
                MontoTotalDistribuir = grupo.MontoTotalDistribuir,
                Observaciones = string.IsNullOrWhiteSpace(grupo.Observaciones) ? null : grupo.Observaciones.Trim(),
                IsActive = true,
                CreatedAt = DateTime.UtcNow,
                Detalles = []
            };
            db.BonosDistribucionesPeriodoRrhh.Add(captura);
            grupo.CapturaId = captura.Id;
        }
        else
        {
            captura.Periodo = periodo;
            captura.FechaInicio = fechaInicio.Date;
            captura.FechaFin = fechaFin.Date;
            captura.Departamento = grupo.Departamento;
            captura.PosicionId = grupo.PosicionId;
            captura.BonoEstructuraRrhhId = grupo.BonoEstructuraRrhhId!.Value;
            captura.MontoTotalDistribuir = grupo.MontoTotalDistribuir;
            captura.Observaciones = string.IsNullOrWhiteSpace(grupo.Observaciones) ? null : grupo.Observaciones.Trim();
            captura.UpdatedAt = DateTime.UtcNow;
        }

        var detallesExistentes = captura.Detalles.ToDictionary(d => d.EmpleadoId, d => d);
        var empleadosConPorcentaje = grupo.Empleados.Where(e => e.Detalles.Any(d => d.Porcentaje > 0m)).ToList();
        var idsActivos = empleadosConPorcentaje.Select(e => e.EmpleadoId).ToHashSet();
        var eliminar = captura.Detalles.Where(d => !idsActivos.Contains(d.EmpleadoId)).ToList();
        if (eliminar.Count > 0)
            db.BonosDistribucionesEmpleadosRrhh.RemoveRange(eliminar);

        foreach (var item in empleadosConPorcentaje)
        {
            if (!detallesExistentes.TryGetValue(item.EmpleadoId, out var detalle))
            {
                detalle = new BonoDistribucionEmpleadoRrhh
                {
                    Id = Guid.NewGuid(),
                    BonoDistribucionPeriodoRrhh = captura,
                    EmpleadoId = item.EmpleadoId,
                    Porcentaje = item.PorcentajeTotal,
                    MontoAsignado = item.MontoAsignado,
                    IsActive = true,
                    CreatedAt = DateTime.UtcNow,
                    Detalles = []
                };
                db.BonosDistribucionesEmpleadosRrhh.Add(detalle);
            }

            detalle.Porcentaje = item.PorcentajeTotal;
            detalle.MontoAsignado = item.MontoAsignado;
            detalle.IsActive = true;
            detalle.UpdatedAt = DateTime.UtcNow;

            var detallesRubroExistentes = detalle.Detalles.ToDictionary(d => d.BonoRubroRrhhId, d => d);
            var rubrosActivos = item.Detalles.Where(d => d.Porcentaje > 0m).ToList();
            var rubrosActivosIds = rubrosActivos.Select(d => d.BonoRubroRrhhId).ToHashSet();
            var eliminarRubros = detalle.Detalles.Where(d => !rubrosActivosIds.Contains(d.BonoRubroRrhhId)).ToList();
            if (eliminarRubros.Count > 0)
                db.BonosDistribucionesEmpleadosDetalleRrhh.RemoveRange(eliminarRubros);

            foreach (var rubro in rubrosActivos)
            {
                if (!detallesRubroExistentes.TryGetValue(rubro.BonoRubroRrhhId, out var detalleRubro))
                {
                    detalleRubro = new BonoDistribucionEmpleadoDetalleRrhh
                    {
                        Id = Guid.NewGuid(),
                        BonoDistribucionEmpleadoRrhh = detalle,
                        BonoRubroRrhhId = rubro.BonoRubroRrhhId,
                        Porcentaje = rubro.Porcentaje,
                        MontoAsignado = rubro.MontoAsignado,
                        Orden = rubro.Orden,
                        IsActive = true,
                        CreatedAt = DateTime.UtcNow
                    };
                    db.BonosDistribucionesEmpleadosDetalleRrhh.Add(detalleRubro);
                    continue;
                }

                detalleRubro.Porcentaje = rubro.Porcentaje;
                detalleRubro.MontoAsignado = rubro.MontoAsignado;
                detalleRubro.Orden = rubro.Orden;
                detalleRubro.IsActive = true;
                detalleRubro.UpdatedAt = DateTime.UtcNow;
            }
        }
    }

    private async Task ExportarCsvAsync()
    {
        error = ok = null;
        if (gruposCaptura.Count == 0)
        {
            error = "No hay datos cargados para exportar.";
            return;
        }

        var builder = new StringBuilder();
        builder.AppendLine("Periodo,FechaInicio,FechaFin,Area,Posicion,Estructura,Empleado,Rubro,TopeRubro,PorcentajeCapturado,MontoRubro,TotalEmpleado,MontoEmpleado,Observaciones");

        foreach (var grupo in gruposCaptura.OrderBy(g => g.PosicionOrden).ThenBy(g => g.PosicionNombre))
        {
            foreach (var empleado in grupo.Empleados.OrderBy(e => e.NombreEmpleado))
            {
                foreach (var rubro in empleado.Detalles.OrderBy(d => d.Orden))
                {
                    builder.AppendLine(string.Join(",",
                        EscapeCsv(periodo),
                        EscapeCsv(fechaInicio.ToString("yyyy-MM-dd")),
                        EscapeCsv(fechaFin.ToString("yyyy-MM-dd")),
                        EscapeCsv(empleado.Departamento),
                        EscapeCsv(grupo.PosicionNombre),
                        EscapeCsv(grupo.EstructuraNombre),
                        EscapeCsv(empleado.NombreEmpleado),
                        EscapeCsv(rubro.RubroNombre),
                        rubro.TopePorcentaje.ToString("0.##"),
                        rubro.Porcentaje.ToString("0.##"),
                        rubro.MontoAsignado.ToString("0.00"),
                        ObtenerTotalFila(empleado).ToString("0.##"),
                        ObtenerMontoFila(empleado).ToString("0.00"),
                        EscapeCsv(grupo.Observaciones)));
                }
            }
        }

        await JS.InvokeVoidAsync("mundoVsAuth.downloadCsv", $"bonos-distribuidos-{fechaInicio:yyyyMMdd}-{fechaFin:yyyyMMdd}.csv", builder.ToString());
        ok = "CSV exportado correctamente.";
    }

    private static string EscapeCsv(string? value)
    {
        var texto = value ?? string.Empty;
        return $"\"{texto.Replace("\"", "\"\"")}\"";
    }

    // "Total %" por empleado = su % del pool = Σ (Porcentaje × Tope / 100). NO es la suma cruda
    // de Porcentaje (que daría 400% para 4 rubros al 100%): cada rubro contribuye su
    // TopePorcentaje cuando el empleado lo captura al 100%, así Σ Tope = 100% = pool completo.
    // English: Per-employee "Total %" = their pool share = Σ (Porcentaje × Tope / 100). NOT the
    // raw sum of Porcentaje (which would be 400% for 4 rubros at 100%): each rubro contributes
    // its TopePorcentaje when captured at 100%, so Σ Tope = 100% = the full pool.
    private decimal ObtenerTotalFila(EmpleadoCapturaDistribucion empleado)
        => empleado.Detalles.Sum(d => (d.Porcentaje / 100m) * (d.TopePorcentaje / 100m) * 100m);

    private decimal ObtenerMontoFila(EmpleadoCapturaDistribucion empleado)
        => empleado.Detalles.Sum(d => d.MontoAsignado);

    // Promedio del Porcentaje capturado por empleado para un rubro. El modelo es por-empleado
    // (el pool NO es compartido), así que la métrica de pie consistente con la grid es el
    // promedio, no la suma: 2 empleados al 100% → 100% (no 200%, que leía como sobrepasó bajo
    // un encabezado que muestra el tope del rubro). / Average Porcentaje captured per employee
    // for a rubro. The model is per-employee (the pool is NOT shared), so the footer metric
    // consistent with the grid is the average, not the sum: 2 employees at 100% → 100% (not
    // 200%, which read as an overshoot under a header showing the rubro's tope).
    private decimal ObtenerTotalRubro(PosicionCapturaDistribucion grupo, Guid bonoRubroRrhhId)
        => grupo.Empleados.Count == 0 ? 0m
            : grupo.Empleados.Average(e =>
                e.Detalles.Where(d => d.BonoRubroRrhhId == bonoRubroRrhhId).Sum(d => d.Porcentaje));

    private decimal ObtenerMontoGrupo(PosicionCapturaDistribucion grupo)
        => grupo.Empleados.Sum(ObtenerMontoFila);

    private decimal ObtenerTopeTotalGrupo(PosicionCapturaDistribucion grupo)
        => grupo.Rubros.Sum(r => r.TopePorcentaje);

    // Promedio del PorcentajeTotal por empleado. El tope es por empleado, así que el promedio
    // (no la suma) es la métrica correcta del grupo: dos empleados al 100% dan promedio 100%,
    // no 200%. / Average of per-employee PorcentajeTotal. The cap is per employee, so the
    // average (not the sum) is the right group metric: two employees at 100% average 100%.
    private decimal ObtenerPromedioCapturaGrupo(PosicionCapturaDistribucion grupo)
        => grupo.Empleados.Count == 0 ? 0m : grupo.Empleados.Average(ObtenerTotalFila);

    // Tope máximo por empleado = Σ TopePorcentaje = el 100% del pool (cada rubro al 100%).
    // Como Porcentaje ∈ [0,100] (fracción del rubro, NO del tope) y el monto =
    // MontoTotal × (Tope/100) × (Porcentaje/100), el PorcentajeTotal máximo de un empleado es
    // Σ Tope, NO Σ Tope²/100. / Per-employee max = Σ TopePorcentaje = 100% of the pool (every
    // rubro at 100%). Since Porcentaje ∈ [0,100] (fraction of the rubro, NOT of the tope) and
    // monto = MontoTotal × (Tope/100) × (Porcentaje/100), an employee's max PorcentajeTotal is
    // Σ Tope, NOT Σ Tope²/100.
    private static decimal ObtenerMaxCapturaEmpleado(EmpleadoCapturaDistribucion empleado)
        => empleado.Detalles.Sum(d => Math.Round(d.TopePorcentaje, 2));

    // Promedio del remanente por empleado hasta su tope personal. / Average per-employee
    // headroom to their personal cap.
    private decimal ObtenerRemanentePromedioGrupo(PosicionCapturaDistribucion grupo)
        => grupo.Empleados.Count == 0 ? 0m
            : grupo.Empleados.Average(e => Math.Max(0m, ObtenerMaxCapturaEmpleado(e) - ObtenerTotalFila(e)));

    // Dentro de topes = NINGÚN empleado excede SU pool personal (Σ Topes = 100% del pool por
    // empleado). El candado es por-empleado sobre el PorcentajeTotal ponderado, NO por-rubro
    // contra TopePorcentaje: ese era el modelo viejo (tope del rubro = cap sobre Porcentaje) y
    // daba falso rojo cuando un empleado capturaba 100% en un rubro con tope < 100 (ej. 30%):
    // 100 > 30 → rojo, aunque el guardado sí procedía. Como Porcentaje ∈ [0,100] (validado en
    // ValidarGrupo) y PorcentajeTotal = Σ (Porcentaje × Tope / 100), el máximo por empleado es
    // Σ Tope, así que este guard ya casi nunca dispara — pero es el check semánticamente correcto
    // y mantiene la UI (borde/pie/badge "Capturado") consistente con ValidarGrupo. El pool es por
    // empleado, no compartido: 2 empleados al 100% cada uno es válido (promedio 100%, no 200%).
    // English: Within topes = NO employee exceeds THEIR personal pool (Σ Topes = 100% of the
    // per-employee pool). The check is per-employee on the weighted PorcentajeTotal, NOT per-rubro
    // against TopePorcentaje: that was the old model (rubro tope = cap on Porcentaje) and gave a
    // false red when an employee captured 100% in a rubro with tope < 100 (e.g. 30%): 100 > 30 →
    // red, even though the save succeeded. Since Porcentaje ∈ [0,100] (validated in ValidarGrupo)
    // and PorcentajeTotal = Σ (Porcentaje × Tope / 100), the per-employee max is Σ Tope, so this
    // guard almost never fires now — but it's the semantically correct check and keeps the UI
    // (border/footer/"Capturado" badge) consistent with ValidarGrupo. The pool is per employee,
    // not shared: 2 employees at 100% each is valid (average 100%, not 200%).
    private bool GrupoDentroDeTopes(PosicionCapturaDistribucion grupo)
        => grupo.Empleados.All(e =>
            Math.Round(ObtenerTotalFila(e), 2) <= Math.Round(ObtenerMaxCapturaEmpleado(e), 2));

    public void Dispose()
    {
        _disposed = true;
    }

