        public decimal MontoTotalDistribuir { get; set; }
        public string? Observaciones { get; set; }
        public List<RubroPosicionDistribucion> Rubros { get; set; } = [];
        public List<EmpleadoCapturaDistribucion> Empleados { get; set; } = [];
    }

