@page "/rrhh/asistencias-semanal"
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using MundoVs.Core.Entities
@using MundoVs.Core.Models
@using MundoVs.Core.Services
@using MundoVs.Infrastructure.Data
@using MundoVs.Core.Interfaces
@inject IDbContextFactory<CrmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IRrhhResolucionPeriodoService ResolucionPeriodo
@inject IRrhhAsistenciaProcessor RrhhAsistenciaProcessor
@rendermode InteractiveServer

<PageTitle>Resumen semanal de asistencias</PageTitle>


<div class="container-fluid px-4">
    @if (!_puedeVer)
    {
        <div class="alert alert-warning mt-3">No tienes permisos para ver el resumen semanal de asistencias.</div>
    }
    else
    {
        <div class="d-flex align-items-start justify-content-between mb-3 gap-3 flex-wrap">
            <div>
                <h1 class="display-6 fw-bold"><i class="bi bi-calendar-week me-2"></i>Resumen semanal</h1>
                <p class="text-muted mb-0">Consulta horas trabajadas por empleado y día usando las asistencias ya procesadas.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-outline-secondary" href="/rrhh/asistencias"><i class="bi bi-arrow-left me-1"></i>Volver a asistencias</a>
                <button class="btn btn-primary" @onclick="CargarAsync" disabled="@cargando"><i class="bi bi-arrow-repeat me-1"></i>Actualizar</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        @if (!string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success">@ok</div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Empleados</div><div class="fs-4 fw-bold">@resumenes.Count</div></div></div></div>
            <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Días del periodo</div><div class="fs-4 fw-bold">@diasPeriodo.Count</div></div></div></div>
            <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Horas pagadas</div><div class="fs-4 fw-bold">@FormatearMinutos(totalMinutosPagadosPeriodo)</div></div></div></div>
            <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Promedio pagado</div><div class="fs-4 fw-bold">@FormatearMinutos(promedioMinutosPagadosEmpleado)</div></div></div></div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark text-white">Filtros</div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label">Periodicidad de nómina</label>
                        <InputSelect class="form-select" @bind-Value="periodicidadSeleccionada" @bind-Value:after="AlCambiarPeriodicidadAsync">
                            <option value="@((int)PeriodicidadPago.Semanal)">Semanal</option>
                            <option value="@((int)PeriodicidadPago.Quincenal)">Quincenal</option>
                            <option value="@((int)PeriodicidadPago.Mensual)">Mensual</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Periodo de nómina</label>
                        <div class="input-group">
                            <button class="btn btn-outline-secondary" @onclick="() => MoverPeriodoAsync(-1)" disabled="@cargando" title="Periodo anterior"><i class="bi bi-chevron-left"></i></button>
                            <input type="text" class="form-control text-center fw-semibold" readonly value="@periodoEtiquetaActual" />
                            <button class="btn btn-outline-secondary" @onclick="() => MoverPeriodoAsync(1)" disabled="@cargando" title="Periodo siguiente"><i class="bi bi-chevron-right"></i></button>
                            <button class="btn btn-outline-secondary" @onclick="IrAPeriodoActualAsync" disabled="@cargando" title="Ir al periodo que contiene hoy"><i class="bi bi-calendar3"></i></button>
                        </div>
                        <small class="text-muted d-block mt-1">Ventana: @periodoFechaInicio.ToString("dd/MM/yyyy") – @periodoFechaFin.ToString("dd/MM/yyyy")</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Empleado</label>
                        <InputText class="form-control" @bind-Value="filtroEmpleado" @bind-Value:after="GuardarFiltrosPersistidosAsync" placeholder="Nombre, número o código" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Turno</label>
                        <InputSelect class="form-select" @bind-Value="filtroTurnoIdTexto" @bind-Value:after="GuardarFiltrosPersistidosAsync">
                            <option value="">Todos</option>
                            @foreach (var turno in turnos)
                            {
                                <option value="@turno.Id.ToString()">@turno.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Estatus</label>
                        <InputSelect class="form-select" @bind-Value="filtroEstatus" @bind-Value:after="GuardarFiltrosPersistidosAsync">
                            <option value="todos">Todos</option>
                            @foreach (var estatus in estatusDisponibles)
                            {
                                <option value="@((int)estatus).ToString()">@ObtenerTextoEstatus(estatus)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Revisión</label>
                        <InputSelect class="form-select" @bind-Value="filtroRevision" @bind-Value:after="GuardarFiltrosPersistidosAsync">
                            <option value="todos">Todos</option>
                            <option value="si">Con revisión</option>
                            <option value="no">Sin revisión</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ordenar por</label>
                        <InputSelect class="form-select" @bind-Value="filtroOrden" @bind-Value:after="GuardarFiltrosPersistidosAsync">
                            <option value="nombre">Nombre</option>
                            <option value="numero">No.</option>
                            <option value="checador">Checador</option>
                        </InputSelect>
                    </div>
                    <div class="col-12 d-flex gap-2 flex-wrap">
                        <button class="btn btn-primary" @onclick="CargarAsync" disabled="@cargando"><i class="bi bi-search me-1"></i>Aplicar filtros</button>
                        <button class="btn btn-outline-secondary" @onclick="LimpiarFiltrosAsync" disabled="@cargando">Limpiar</button>
                        <button class="btn btn-outline-success" @onclick="ExportarCsvAsync" disabled="@(cargando || exportandoCsv || resumenes.Count == 0)"><i class="bi bi-filetype-csv me-1"></i>@(exportandoCsv ? "Exportando..." : "Exportar CSV")</button>
                    </div>
                    <div class="col-12">
                        <small class="text-muted">La ventana se alinea al ciclo de nómina configurado (DiaCorteSemana/DiaCorteMes). Solo se muestran empleados con la periodicidad seleccionada; los de destajo se excluyen. La información viene de `RrhhAsistencias` ya procesadas.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="asis-week-legend">
                    <span class="asis-week-legend__item"><span class="asis-week-legend__dot asis-week-legend__dot--ok"></span>En objetivo o arriba del debido</span>
                    <span class="asis-week-legend__item"><span class="asis-week-legend__dot asis-week-legend__dot--warn"></span>Faltante leve</span>
                    <span class="asis-week-legend__item"><span class="asis-week-legend__dot asis-week-legend__dot--danger"></span>Faltante fuerte</span>
                    <span class="asis-week-legend__item"><span class="asis-week-legend__dot asis-week-legend__dot--extra-pending"></span>Tiempo extra pendiente</span>
                    <span class="asis-week-legend__item"><span class="asis-week-legend__dot asis-week-legend__dot--extra-reviewed"></span>Tiempo extra revisado</span>
                    <span class="asis-week-legend__item"><span class="asis-week-legend__dot asis-week-legend__dot--muted"></span>Sin tiempo registrado</span>
                </div>
                @if (_puedeAprobarTiempoExtra && EmpleadosConExtraCount > 0)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-bottom bg-light">
                        <div class="small">
                            @if (PendientesAceptacionCount == 0)
                            {
                                <span class="text-success"><i class="bi bi-check2-circle me-1"></i>Tiempo del periodo aceptado — puedes generar la prenómina.</span>
                            }
                            else
                            {
                                <span class="text-warning-emphasis"><i class="bi bi-stopwatch me-1"></i>@AceptadosCount de @EmpleadosConExtraCount con tiempo aceptado — faltan @PendientesAceptacionCount para habilitar la prenómina.</span>
                            }
                        </div>
                        @if (PendientesAceptacionCount > 0)
                        {
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-success" @onclick="() => AbrirConfirmacionLote(true)" disabled="@cargando"><i class="bi bi-check2-all me-1"></i>Aceptar y pagar todo</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirConfirmacionLote(false)" disabled="@cargando"><i class="bi bi-check2 me-1"></i>Aceptar sin pagar</button>
                            </div>
                        }
                    </div>
                }
                <div class="asis-week-table-wrap">
                    <table class="table table-hover table-sm mb-0 align-middle asis-week-table asis-week-table--compact">
                        <colgroup>
                            <col class="asis-week-col--employee" />
                            <col class="asis-week-col--days" />
                            <col class="asis-week-col--num" />
                            <col class="asis-week-col--num" />
                            <col class="asis-week-col--num" />
                            <col class="asis-week-col--num" />
                            <col class="asis-week-col--num" />
                            <col class="asis-week-col--num" />
                            <col class="asis-week-col--num" />
                            <col class="asis-week-col--num" />
                            <col class="asis-week-col--num" />
                            <col class="asis-week-col--action" />
                        </colgroup>
                        <thead class="table-dark">
                            <tr>
                                <th class="asis-week-sticky-col asis-week-sticky-col--employee">Empleado</th>
                                <th class="asis-week-col-days__head">Días del periodo (@diasPeriodo.Count)</th>
                                <th class="text-end">Total Hrs</th>
                                <th class="text-end">Hrs Pagadas</th>
                                <th class="text-end">Entro a Banco</th>
                                <th class="text-end">Usaste Banco</th>
                                <th class="text-end">Saldo Banco</th>
                                <th class="text-end">Adic. a Pago</th>
                                <th class="text-end text-danger">Ded. faltante</th>
                                <th class="text-end text-danger">Ded. retardo</th>
                                <th class="text-end text-danger">Ded. salida</th>
                                <th class="text-center">Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (resumenes.Count == 0)
                            {
                                <tr>
                                    <td colspan="@ObtenerTotalColumnasTabla()" class="text-center text-muted py-4">No hay asistencias procesadas para el rango seleccionado.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var resumen in resumenes)
                                {
                                    var resolucionEmpleado = resolucionPorEmpleado.GetValueOrDefault(resumen.EmpleadoId);
                                    var autorizadaEmpleado = resolucionEmpleado is { Estatus: RrhhResolucionPeriodoEstatus.Autorizada };
                                    // Resumen neteado del periodo para este empleado (batch): las mismas
                                    // 9 columnas del drawer. Null si no hay asistencias en el rango.
                                    // English: Netted period summary for this employee (batch): the same
                                    // 9 columns as the drawer. Null if no attendances in the range.
                                    var resumenNeteo = resumenNeteoPorEmpleado.GetValueOrDefault(resumen.EmpleadoId);
                                    <tr class="@(_detalleVisible && _detalleEmpleadoId == resumen.EmpleadoId ? "asis-week-row--active" : string.Empty)">
                                        <td class="asis-week-sticky-col asis-week-sticky-col--employee">
                                            <div class="fw-semibold">@resumen.NombreCompleto</div>
                                            <div class="small text-muted">
                                                @(string.IsNullOrWhiteSpace(resumen.NumeroEmpleado) ? "—" : resumen.NumeroEmpleado)
                                                @(string.IsNullOrWhiteSpace(resumen.CodigoChecador) ? string.Empty : $" · {resumen.CodigoChecador}")
                                            </div>
                                            @if (resumen.EsPorHoras)
                                            {
                                                <div class="mt-1">
                                                    <span class="badge bg-info-subtle text-info-emphasis" title="Esquema por horas: se paga el tiempo trabajado"><i class="bi bi-clock-history me-1"></i>Por horas</span>
                                                </div>
                                            }
                                            @if (_puedeAprobarTiempoExtra && (resumen.TotalMinutosExtra > 0 || resolucionPorEmpleado.ContainsKey(resumen.EmpleadoId)))
                                            {
                                                <div class="d-flex flex-wrap gap-1 align-items-center mt-1">
                                                    <span class="badge @ObtenerClaseEstatusResolucion(resolucionEmpleado)">@ObtenerEtiquetaEstatusResolucion(resolucionEmpleado)</span>
                                                </div>
                                            }
                                        </td>
                                        <td class="asis-week-col-days__cell">
                                            <div class="asis-strip">
                                                @foreach (var dia in diasPeriodo)
                                                {
                                                    var presentacionDia = ObtenerPresentacionDia(resumen, dia);
                                                    <button type="button" class="asis-strip__cell @presentacionDia.CssClass @(EsFinSemana(dia) ? "asis-strip__cell--weekend" : string.Empty)" title="@presentacionDia.Tooltip" @onclick="() => AbrirCorreccionDiaAsync(resumen.EmpleadoId, dia)">
                                                        <span class="asis-strip__dow">@ObtenerAbreviaturaDia(dia)</span>
                                                        <span class="asis-strip__day">@dia.ToString("dd")</span>
                                                        <span class="asis-strip__value">@presentacionDia.Acreditado</span>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-end asis-week-num">@FormatearMinutos(resumenNeteo?.MinutosTrabajadosNetosDetectado ?? 0)</td>
                                        <td class="text-end asis-week-num asis-week-num--total">@FormatearMinutos(resumenNeteo?.MinutosBasePagadaPeriodo ?? 0)</td>
                                        <td class="text-end asis-week-num">
                                            @* Por horas: no hay extra/banco/deducciones (paga = trabajado). Se muestran
                                               sólo Total Hrs / Hrs Pagadas / Saldo Banco; el resto en guion para no
                                               ensuciar la fila con ceros que no aplican a este esquema.
                                               English: By-the-hour: no extra/bank/deductions (pay = worked). Only
                                               Total Hrs / Paid Hrs / Bank Balance are shown; the rest as a dash so
                                               the row isn't cluttered with zeros that don't apply to this scheme. *@
                                            @if (resumen.EsPorHoras)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else if (resolucionEmpleado is { MinutosExtraBanco: > 0 })
                                            {
                                                <span class="badge bg-info text-dark" title="Extra a banco: @FormatearMinutos(resolucionEmpleado.MinutosExtraBanco) @resumen.ExtraBancoFactorDetalle">@FormatearMinutos(resolucionEmpleado.MinutosExtraBanco) <small class="opacity-75">@resumen.ExtraBancoFactorDetalle</small></span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end asis-week-num">
                                            @if (resumen.EsPorHoras) { <span class="text-muted">—</span> } else { @FormatearMinutos(resumenNeteo?.MinutosBancoConsumidoPeriodo ?? 0) }
                                        </td>
                                        <td class="text-end asis-week-num">@FormatearMinutos(resumenNeteo?.SaldoBancoHorasMinutos ?? 0)</td>
                                        <td class="text-end asis-week-num">
                                            @if (resumen.EsPorHoras)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else if (resumen.PeriodoAutorizado && resumen.ExtraDescartado)
                                            {
                                                <span class="badge bg-secondary" title="Extra descartado: sin pago ni compensación">0:00</span>
                                            }
                                            else if (resolucionEmpleado is { MinutosExtraPago: > 0 })
                                            {
                                                <span class="badge bg-success" title="Extra a pago: @FormatearMinutos(resolucionEmpleado.MinutosExtraPago) @resumen.ExtraPagoFactorDetalle">@FormatearMinutos(resolucionEmpleado.MinutosExtraPago) <small class="opacity-75">@resumen.ExtraPagoFactorDetalle</small></span>
                                            }
                                            else if (resumen.TotalMinutosExtra > 0)
                                            {
                                                <span class="badge bg-warning text-dark" title="Extra detectado pendiente de autorizar">Pendiente</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end asis-week-num text-danger">
                                            @if (resumen.EsPorHoras) { <span class="text-muted">—</span> } else { @FormatearMinutos(CalcularDedFaltanteNeta(resumenNeteo)) }
                                        </td>
                                        <td class="text-end asis-week-num text-danger">
                                            @if (resumen.EsPorHoras) { <span class="text-muted">—</span> } else { @FormatearMinutos(CalcularDedRetardoNeta(resumenNeteo)) }
                                        </td>
                                        <td class="text-end asis-week-num text-danger">
                                            @if (resumen.EsPorHoras) { <span class="text-muted">—</span> } else { @FormatearMinutos(CalcularDedSalidaNeta(resumenNeteo)) }
                                        </td>
                                        <td class="asis-week-col-action__cell">
                                            <div class="d-flex flex-column gap-1 align-items-stretch">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirDetalleAsync(resumen.EmpleadoId)">
                                                    <i class="bi bi-eye me-1"></i>Ver detalle
                                                </button>
                                                @if (_puedeAprobarTiempoExtra && (resumen.TotalMinutosExtra > 0 || resolucionPorEmpleado.ContainsKey(resumen.EmpleadoId)))
                                                {
                                                    <button type="button" class="btn btn-sm @(autorizadaEmpleado ? "btn-outline-success" : "btn-outline-primary")" @onclick="() => AbrirResolucionAsync(resumen)">
                                                        <i class="bi @(autorizadaEmpleado ? "bi-check2-circle" : "bi-stopwatch") me-1"></i>@(autorizadaEmpleado ? "Aceptado" : "Aceptar tiempo")
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }

                                <tr class="table-light fw-semibold">
                                    <td class="asis-week-sticky-col asis-week-sticky-col--employee">Totales</td>
                                    <td class="asis-week-col-days__cell">
                                        <div class="asis-strip asis-strip--totals">
                                            @foreach (var dia in diasPeriodo)
                                            {
                                                <div class="asis-strip__cell asis-strip__cell--total @(EsFinSemana(dia) ? "asis-strip__cell--weekend" : string.Empty)" title="@dia.ToString("dddd, dd/MM/yyyy", CulturaEsMx)">
                                                    <span class="asis-strip__dow">@ObtenerAbreviaturaDia(dia)</span>
                                                    <span class="asis-strip__day">@dia.ToString("dd")</span>
                                                    <span class="asis-strip__value">@FormatearMinutos(totalesPorDia.GetValueOrDefault(dia))</span>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end asis-week-num">@FormatearMinutos(resumenNeteoPorEmpleado.Values.Sum(x => x.MinutosTrabajadosNetosDetectado))</td>
                                    <td class="text-end asis-week-num asis-week-num--total">@FormatearMinutos(resumenNeteoPorEmpleado.Values.Sum(x => x.MinutosBasePagadaPeriodo))</td>
                                    <td class="text-end asis-week-num">@FormatearMinutos(resolucionPorEmpleado.Values.Sum(r => Math.Max(0, r.MinutosExtraBanco)))</td>
                                    <td class="text-end asis-week-num">@FormatearMinutos(resumenNeteoPorEmpleado.Values.Sum(x => x.MinutosBancoConsumidoPeriodo))</td>
                                    <td class="text-end asis-week-num">@FormatearMinutos(resumenNeteoPorEmpleado.Values.Sum(x => x.SaldoBancoHorasMinutos))</td>
                                    <td class="text-end asis-week-num">@FormatearMinutos(resolucionPorEmpleado.Values.Sum(r => Math.Max(0, r.MinutosExtraPago)))</td>
                                    <td class="text-end asis-week-num text-danger">@FormatearMinutos(resumenNeteoPorEmpleado.Values.Sum(CalcularDedFaltanteNeta))</td>
                                    <td class="text-end asis-week-num text-danger">@FormatearMinutos(resumenNeteoPorEmpleado.Values.Sum(CalcularDedRetardoNeta))</td>
                                    <td class="text-end asis-week-num text-danger">@FormatearMinutos(resumenNeteoPorEmpleado.Values.Sum(CalcularDedSalidaNeta))</td>
                                    <td class="asis-week-col-action__cell"></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<AsistenciasCorreccionModal
    Visible="@(mostrarCorreccionDia && asistenciaSeleccionada != null)"
    Asistencia="asistenciaSeleccionada"
    Turnos="turnos"
    PuedeReprocesar="@_puedeReprocesar"
    PuedeAprobarTiempoExtra="@_puedeAprobarTiempoExtra"
    PeriodoAutorizado="@PeriodoSeleccionAutorizado"
    OnClose="CerrarCorreccionDia"
    OnUpdated="RecargarResumenSemanalAsync"
    OnCambioDiaSolicitado="CambiarDiaCorreccionAsync"
    FechaMinimaPeriodo="@(diasPeriodo.Count > 0 ? diasPeriodo[0] : (DateOnly?)null)"
    FechaMaximaPeriodo="@(diasPeriodo.Count > 0 ? diasPeriodo[^1] : (DateOnly?)null)" />

<AsistenciasResolucionModal
    Visible="@_resolucionVisible"
    EmpleadoId="@_resolucionEmpleadoId"
    NombreEmpleado="@_resolucionNombre"
    FechaReferencia="@(DateOnly.FromDateTime(fechaReferenciaPeriodo))"
    FechaInicioPeriodo="@periodoFechaInicio"
    FechaFinPeriodo="@periodoFechaFin"
    MinutosExtraDetectado="@_resolucionMinutosExtra"
    SaldoBancoHoras="@_resolucionSaldoBanco"
    PuedeAprobarTiempoExtra="@_puedeAprobarTiempoExtra"
    OnClose="CerrarResolucion"
    OnUpdated="RecargarResumenSemanalAsync" />

<RecalcularPeriodoModal
    Visible="@_recalcPeriodoVisible"
    Contexto="@($"Empleado: {DetalleResumen?.NombreCompleto ?? string.Empty} · Periodo: {periodoEtiquetaActual}")"
    OnClose="CerrarRecalcPeriodo"
    OnConfirmar="ConfirmarRecalcPeriodoAsync" />

@if (_mostrarConfirmacionLote)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@( _lotePagarTodo ? "Aceptar y pagar todo el tiempo" : "Aceptar sin pagar el tiempo")</h5>
                    <button type="button" class="btn-close" @onclick="CancelarLote" disabled="@cargando" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>Se aceptará el tiempo extra de <strong>@PendientesAceptacionCount</strong> empleado(s) del periodo.</p>
                    @if (_lotePagarTodo)
                    {
                        <p class="text-muted small mb-0">Cada empleado se autoriza con <em>PagarTodo</em> al factor de configuración (nada al banco). Si alguien necesita parte al banco o distintos factores, edítalo uno a uno con <strong>Aceptar tiempo</strong>.</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">El tiempo detectado se acepta <strong>sin pago ni compensación</strong>: el extra se descarta y el faltante/retardo del periodo se descuenta <strong>completo</strong> en la nómina. Úsalo cuando no vas a autorizar el extra — el periodo sí queda autorizado y desbloquea la prenómina.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelarLote" disabled="@cargando">Cancelar</button>
                    <button type="button" class="btn @(_lotePagarTodo ? "btn-success" : "btn-primary")" @onclick="ConfirmarLoteAsync" disabled="@cargando">
                        @(cargando ? "Procesando..." : (_lotePagarTodo ? "Aceptar y pagar todo" : "Aceptar sin pagar"))
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_detalleVisible && DetalleResumen is { } detalle)
{
    var resolucionDetalle = resolucionPorEmpleado.GetValueOrDefault(detalle.EmpleadoId);
    var autorizadaDetalle = resolucionDetalle is { Estatus: RrhhResolucionPeriodoEstatus.Autorizada };
    <div class="asis-drawer-backdrop" @onclick="CerrarDetalle"></div>
    <aside class="asis-drawer">
        @* Overlay de recálculo: cubre el drawer mientras se reprocesa el periodo para
           que el usuario vea que está trabajando (no se trabó). / Recalc overlay:
           covers the drawer while the period is being reprocessed so the user sees
           it is working (not frozen). *@
        @if (_recalcPeriodo)
        {
            <div class="asis-drawer__overlay" role="status" aria-live="polite">
                <div class="spinner-border text-primary" style="width:2.5rem;height:2.5rem" aria-hidden="true"></div>
                <div class="asis-drawer__overlay-text">Recalculando periodo…</div>
                <div class="asis-drawer__overlay-sub">Reprocesando los días; no cierres el panel.</div>
            </div>
        }
        <header class="asis-drawer__header">
            <div>
                <h5 class="mb-0 fw-bold">@detalle.NombreCompleto</h5>
                <div class="small text-muted">
                    @(string.IsNullOrWhiteSpace(detalle.NumeroEmpleado) ? "Sin número" : detalle.NumeroEmpleado)
                    @(string.IsNullOrWhiteSpace(detalle.CodigoChecador) ? string.Empty : $" · {detalle.CodigoChecador}")
                    · @periodoEtiquetaActual
                </div>
            </div>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarDetalle"></button>
        </header>

        <div class="asis-drawer__body">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <span class="badge @ObtenerClaseEstatusResolucion(resolucionDetalle)">@ObtenerEtiquetaEstatusResolucion(resolucionDetalle)</span>
                @if (detalle.TotalIncidencias > 0)
                {
                    <span class="badge bg-danger-subtle text-danger-emphasis" title="Ausentismo / Retardo / Incompleto">@detalle.TotalIncidencias incidencia(s)</span>
                }
                @if (_puedeAprobarTiempoExtra && (detalle.TotalMinutosExtra > 0 || resolucionPorEmpleado.ContainsKey(detalle.EmpleadoId)))
                {
                    <button type="button" class="btn btn-sm @(autorizadaDetalle ? "btn-outline-success" : "btn-primary")" @onclick="() => AbrirResolucionAsync(detalle)">
                        <i class="bi @(autorizadaDetalle ? "bi-check2-circle" : "bi-stopwatch") me-1"></i>@(autorizadaDetalle ? "Aceptado" : "Aceptar tiempo")
                    </button>
                }
            </div>

            @if (detalle.TotalIncidencias > 0)
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (detalle.TotalDiasAusentismo > 0)
                    {
                        <span class="badge bg-danger-subtle text-danger-emphasis"><i class="bi bi-person-x me-1"></i>Ausentismo: @detalle.TotalDiasAusentismo</span>
                    }
                    @if (detalle.TotalDiasRetardo > 0)
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis"><i class="bi bi-clock me-1"></i>Retardo: @detalle.TotalDiasRetardo</span>
                    }
                    @if (detalle.TotalDiasIncompleto > 0)
                    {
                        <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-hourglass-split me-1"></i>Incompleto: @detalle.TotalDiasIncompleto</span>
                    }
                </div>
            }

            <h6 class="asis-drawer__section">Días del periodo</h6>
            <div class="asis-strip asis-strip--detail">
                @foreach (var dia in diasPeriodo)
                {
                    var presentacionDia = ObtenerPresentacionDia(detalle, dia, _detalleBrutoPorDia);
                    <button type="button" class="asis-strip__cell @presentacionDia.CssClass @(EsFinSemana(dia) ? "asis-strip__cell--weekend" : string.Empty)" title="@presentacionDia.Tooltip" @onclick="() => AbrirCorreccionDiaAsync(detalle.EmpleadoId, dia)">
                        <span class="asis-strip__dow">@ObtenerAbreviaturaDia(dia)</span>
                        <span class="asis-strip__day">@dia.ToString("dd")</span>
                        <span class="asis-strip__value">@presentacionDia.Acreditado</span>
                        <span class="asis-strip__delta">@presentacionDia.Delta</span>
                    </button>
                }
            </div>

            <h6 class="asis-drawer__section mt-3">Resumen de nómina del periodo</h6>
            @if (_detalleResumen is not null)
            {
                <div class="table-responsive">
                    <table class="table table-sm table-bordered text-center mb-0 align-middle small asis-res-nomina-tabla">
                        <thead class="table-light">
                            <tr>
                                <th>Total Hrs</th>
                                <th>Hrs Pagadas</th>
                                <th>Entro a Banco</th>
                                <th>Usaste Banco</th>
                                <th>Saldo Banco</th>
                                <th>Adic. a Pago</th>
                                <th class="text-danger">Ded. faltante</th>
                                <th class="text-danger">Ded. retardo</th>
                                <th class="text-danger">Ded. salida</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@FormatearMinutos(_detalleResumen.MinutosTrabajadosNetosDetectado)</td>
                                <td>@FormatearMinutos(CalcularJornadaProgramadaDetalle())</td>
                                <td>@FormatearMinutos(_detalleResolucion?.MinutosExtraBanco ?? 0)</td>
                                <td>@FormatearMinutos(_detalleResumen.MinutosBancoConsumidoPeriodo)</td>
                                <td>@FormatearMinutos(_detalleResumen.SaldoBancoHorasMinutos)</td>
                                <td>@FormatearMinutos(_detalleResolucion?.MinutosExtraPago ?? 0)</td>
                                <td class="text-danger">@FormatearMinutos(CalcularDedFaltanteNetaDetalle())</td>
                                <td class="text-danger">@FormatearMinutos(CalcularDedRetardoNetoDetalle())</td>
                                <td class="text-danger">@FormatearMinutos(CalcularDedSalidaNetaDetalle())</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="small text-muted mt-1">
                    <strong>Total Hrs</strong> = tiempo trabajado neto (incluye el extra detectado, aún no autorizado). <strong>Hrs Pagadas</strong> = base pagada <em>neteada</em> por el extra del periodo = jornada − deducciones que el extra NO tapó. El extra de un día tapa el faltante/retardo/salida de otro, así que la base refleja esa compensación cruzada (puede ser &gt; Σ del día). <em>Ded. faltante/retardo/salida</em> = lo que realmente se descuenta en $ tras el neteo. Comprobación: <em>Hrs Pagadas + Ded. faltante + Ded. retardo + Ded. salida = jornada</em>. El extra autorizado va en <em>Adic. a Pago</em>.
                </div>

                @* Neteo del periodo (read-only): cómo el extra detectado se convierte en el
                   "Adic. a Pago" autorizado del resumen. El extra tapa primero faltante, luego
                   retardo, luego repone banco; el sobrante es lo pagable. Espejo del modal de
                   resolución. Sin botón de autorizar aquí — eso se hace con "Aceptar tiempo"
                   arriba (abre el modal). *@
                <h6 class="asis-drawer__section mt-3">Neteo del periodo</h6>
                <div class="asis-res-neteo">
                    <div class="asis-res-neteo__row">
                        <div class="asis-res-neteo__item asis-res-neteo__item--info">
                            <span class="asis-res-neteo__label">Extra detectado</span>
                            <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.MinutosExtraDetectado)</span>
                        </div>
                        @if (_detalleResumen.MinutosExtraBajoUmbralNoPagadero > 0)
                        {
                            <div class="asis-res-neteo__item asis-res-neteo__item--info">
                                <span class="asis-res-neteo__label">Extra bajo umbral (no pagadero)</span>
                                <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.MinutosExtraBajoUmbralNoPagadero)</span>
                            </div>
                        }
                        @if (_detalleResumen.MinutosPermisoConGocePeriodo > 0)
                        {
                            <div class="asis-res-neteo__item asis-res-neteo__item--info">
                                <span class="asis-res-neteo__label">Permiso c/goce</span>
                                <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.MinutosPermisoConGocePeriodo)</span>
                            </div>
                        }
                        <div class="asis-res-neteo__item asis-res-neteo__item--bad">
                            <span class="asis-res-neteo__label">Faltante neto</span>
                            <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.MinutosFaltanteNetoPeriodo)</span>
                        </div>
                        <div class="asis-res-neteo__item asis-res-neteo__item--info">
                            <span class="asis-res-neteo__label">Extra tapa faltante</span>
                            <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.MinutosFaltanteAbsorbidoExtra)</span>
                        </div>
                        @if (_detalleResumen.MinutosRetardoAbsorbidoExtra > 0)
                        {
                            <div class="asis-res-neteo__item asis-res-neteo__item--warn">
                                <span class="asis-res-neteo__label">Extra tapa retardo</span>
                                <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.MinutosRetardoAbsorbidoExtra)</span>
                            </div>
                        }
                        @if (_detalleResumen.MinutosSalidaAnticipadaAbsorbidoExtra > 0)
                        {
                            <div class="asis-res-neteo__item asis-res-neteo__item--warn">
                                <span class="asis-res-neteo__label">Extra tapa salida</span>
                                <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.MinutosSalidaAnticipadaAbsorbidoExtra)</span>
                            </div>
                        }
                        @if (_detalleResumen.MinutosBancoConsumidoPeriodo > 0)
                        {
                            <div class="asis-res-neteo__item asis-res-neteo__item--info">
                                <span class="asis-res-neteo__label">Banco consumido</span>
                                <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.MinutosBancoConsumidoPeriodo)</span>
                            </div>
                            <div class="asis-res-neteo__item asis-res-neteo__item--good">
                                <span class="asis-res-neteo__label">Extra restaura banco</span>
                                <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.MinutosBancoRestauradoExtra)</span>
                            </div>
                        }
                        <div class="asis-res-neteo__item asis-res-neteo__item--good asis-res-neteo__item--destacado">
                            <span class="asis-res-neteo__label">Extra absorbible (pagable)</span>
                            <span class="asis-res-neteo__value">@FormatearMinutos(CalcularExtraAbsorbibleDetalle())</span>
                        </div>
                        <div class="asis-res-neteo__item asis-res-neteo__item--good">
                            <span class="asis-res-neteo__label">Saldo banco</span>
                            <span class="asis-res-neteo__value">@FormatearMinutos(_detalleResumen.SaldoBancoHorasMinutos)</span>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">Neteo del periodo: el extra detectado tapa primero el faltante neto (@FormatearMinutos(_detalleResumen.MinutosFaltanteAbsorbidoExtra) min), luego el retardo (@FormatearMinutos(_detalleResumen.MinutosRetardoAbsorbidoExtra) min), luego la salida anticipada (@FormatearMinutos(_detalleResumen.MinutosSalidaAnticipadaAbsorbidoExtra) min), y por último repone el banco consumido en el periodo (@FormatearMinutos(_detalleResumen.MinutosBancoRestauradoExtra) min). Solo el extra absorbible (@FormatearMinutos(CalcularExtraAbsorbibleDetalle()) min) se reparte entre las líneas — y el operador decide cuánto va a Pago. Por eso "Adic. a Pago" del resumen puede ser menor al "Extra detect." de un día. @if (_detalleResumen.MinutosExtraBajoUmbralNoPagadero > 0) {<text>El extra <em>bajo umbral</em> (@FormatearMinutos(_detalleResumen.MinutosExtraBajoUmbralNoPagadero) min: días cuyo excedente no superó el umbral) entra al pool del neteo y ayuda a tapar faltante/retardo/salida/banco, pero <em>no se paga</em>: el sobrante pagable se topa al extra detectado (sobre umbral).</text>}</small>
                </div>

                @* Desglose por día sobre la base (bruto per-día, mismo cálculo que el "Hrs
                   Pagadas" del listado antes de netear), NO marcaciones en bruto (esas son
                   comparativas). Permite ver de qué día sale la diferencia entre el total
                   trabajado ("Total Hrs") y la base pagada ("Hrs Pagadas") del detalle. *@
                @if (_detalleResumen.Dias.Count > 0)
                {
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-bordered text-center align-middle mb-0 small asis-res-dia-tabla">
                            <thead class="table-light">
                                <tr>
                                    <th>Día</th>
                                    <th>Total Hrs</th>
                                    <th>Hrs Pagadas</th>
                                    <th title="Extra detectado en el día (el pago autorizado se ve en el resumen superior)">Extra detect.</th>
                                    <th class="text-danger" title="Faltante neto detectado en el día (bruto; el neteo es a nivel periodo)">Faltante det.</th>
                                    <th class="text-danger" title="Retardo detectado en el día (bruto; el neteo es a nivel periodo)">Retardo det.</th>
                                    <th class="text-danger" title="Salida anticipada detectada en el día (bruto; el neteo es a nivel periodo)">Salida det.</th>
                                    <th title="Jornada neta programada del turno (referencia: si Hrs Pagadas &lt; Jornada, ese día descuenta)">Jornada</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _detalleResumen.Dias.OrderBy(x => x.Fecha))
                                {
                                    var shortfall = d.MinutosBasePagada < d.MinutosJornadaProgramada;
                                    var clasePagada = shortfall ? "text-danger fw-semibold" : "";
                                    var titlePagada = shortfall ? "Shortfall: trabajó menos que su jornada" : "";
                                    <tr>
                                        <td class="text-start text-nowrap">@(d.Fecha.ToString("ddd dd/MM"))</td>
                                        <td>@FormatearMinutos(d.MinutosTrabajadosNetos)</td>
                                        <td class="@clasePagada" title="@titlePagada">@FormatearMinutos(d.MinutosBasePagada)</td>
                                        <td>@FormatearMinutos(d.MinutosExtra)</td>
                                        <td class="text-danger">@FormatearMinutos(d.MinutosFaltanteNeto)</td>
                                        <td class="text-danger">@FormatearMinutos(d.MinutosRetardo)</td>
                                        <td class="text-danger">@FormatearMinutos(d.MinutosSalidaAnticipada)</td>
                                        <td>@FormatearMinutos(d.MinutosJornadaProgramada)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="fw-semibold table-light">
                                <tr>
                                    <td class="text-start">Totales</td>
                                    <td>@FormatearMinutos(_detalleResumen.Dias.Sum(x => x.MinutosTrabajadosNetos))</td>
                                    <td>@FormatearMinutos(_detalleResumen.Dias.Sum(x => x.MinutosBasePagada))</td>
                                    <td>@FormatearMinutos(_detalleResumen.Dias.Sum(x => x.MinutosExtra))</td>
                                    <td class="text-danger">@FormatearMinutos(_detalleResumen.Dias.Sum(x => x.MinutosFaltanteNeto))</td>
                                    <td class="text-danger">@FormatearMinutos(_detalleResumen.Dias.Sum(x => x.MinutosRetardo))</td>
                                    <td class="text-danger">@FormatearMinutos(_detalleResumen.Dias.Sum(x => x.MinutosSalidaAnticipada))</td>
                                    <td>@FormatearMinutos(_detalleResumen.Dias.Sum(x => x.MinutosJornadaProgramada))</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="small text-muted mt-1">
                        Desglose por día = <strong>detectado (bruto)</strong>; el <strong>periodo se netea</strong>: el extra de un día tapa el faltante/retardo/salida de otro. Por eso la Σ del día puede diferir del resumen superior (las columnas <em>Ded.</em> del resumen ya están neteadas; las <em>det.</em> de aquí no). El día con <span class="text-danger">Hrs Pagadas &lt; Jornada</span> es el que descuenta horas (shortfall).
                    </div>
                }
            }
            else
            {
                <div class="small text-muted">No hay resumen de nómina para este periodo.</div>
            }
        </div>

        <footer class="asis-drawer__footer">
            @if (_puedeReprocesar)
            {
                <button type="button" class="btn btn-outline-primary" @onclick="() => AbrirRecalcPeriodo(detalle.EmpleadoId)" disabled="@(cargando || _recalcPeriodo)" title="Pregunta bajo qué método recalculo los días del periodo de este empleado (default / Vs horario / Marcaje de reloj).">
                    <i class="bi bi-arrow-repeat me-1"></i>Recalcular periodo
                </button>
            }
            <button type="button" class="btn btn-outline-secondary" @onclick="CerrarDetalle"><i class="bi bi-x-lg me-1"></i>Cerrar</button>
        </footer>
    </aside>
}

