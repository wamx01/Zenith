    // Número de semana ISO del periodo de la nómina (columna SEMANA). Todas las filas del
    // mismo periodo comparten el valor. / ISO week number of the nómina's period (SEMANA
    // column). All rows of the same period share the value.
    private int ObtenerNumeroSemanaIso()
        => nominaSeleccionada == null ? 0 : System.Globalization.ISOWeek.GetWeekOfYear(nominaSeleccionada.FechaInicio);

    // Total de Ingresos = percepciones brutas (suma de todos los componentes antes de
    // descuentos). Refleja el lado positivo de NominaDetalle.TotalPagar. Mientras la captura
    // está abierta los campos de $ son 0 (se calculan al "Cerrar periodo y calcular").
    // English: Total Ingresos = gross percepciones (sum of all components before deductions).
    // Mirrors the positive side of NominaDetalle.TotalPagar. While capture is open the $
    // fields are 0 (calculated on "Close period and calculate").
    private decimal ObtenerTotalIngresos(NominaDetalle d)
        => Math.Max(0m, d.SueldoBase)
         + Math.Max(0m, d.MontoDestajo)
         + Math.Max(0m, d.MontoBono)
         + Math.Max(0m, d.MontoFestivoTrabajado)
         + Math.Max(0m, d.MontoDescansoTrabajado)
         + Math.Max(0m, d.MontoPrimaDominical)
         + Math.Max(0m, d.MontoPrimaVacacional)
         + Math.Max(0m, d.ComplementoSalarioMinimo)
         + Math.Max(0m, ObtenerMontoHorasExtraPreview(d))
         + Math.Max(0m, d.Bonos)
         + Math.Max(0m, d.SubsidioEmpleo);

    // INCENTIVOS = bono de producción (MontoBono) + percepciones adicionales (Bonos).
    // English: INCENTIVOS = production bonus (MontoBono) + additional perceptions (Bonos).
    private static decimal ObtenerIncentivos(NominaDetalle d)
        => Math.Max(0m, d.MontoBono) + Math.Max(0m, d.Bonos);

    // DESEMPEÑO % = incentivos / sueldo base × 100 (— si no hay sueldo). El desempeño nace
    // de los bonos (incentivos) expresado como porcentaje del sueldo del periodo.
    // English: DESEMPEÑO % = incentives / base salary × 100 (— when no salary). Performance
    // derives from bonuses (incentives) as a percentage of the period's salary.
    private static string ObtenerDesempenoPct(NominaDetalle d)
        => d.SueldoBase <= 0m ? "—" : (ObtenerIncentivos(d) / d.SueldoBase * 100m).ToString("0") + "%";

    // Abono a Deuda = deducciones estructuradas de tipo Préstamo (Clave "PRESTAMO" o Nombre
    // contiene "Préstamo"). No existe saldo de deuda persistente → Saldo Deuda es siempre "—".
    // English: Abono a Deuda = structured deductions of type Préstamo (Clave "PRESTAMO" or
    // Nombre contains "Préstamo"). There is no persistent debt balance → Saldo Deuda is "—".
    private static decimal ObtenerAbonoDeuda(NominaDetalle d)
        => (d.DeduccionesEstructuradas ?? [])
            .Where(x => x.IsActive && x.TipoDeduccion != null
                && (string.Equals(x.TipoDeduccion.Clave, "PRESTAMO", StringComparison.OrdinalIgnoreCase)
                    || (x.TipoDeduccion.Nombre ?? string.Empty).Contains("Préstamo", StringComparison.OrdinalIgnoreCase)
                    || (x.TipoDeduccion.Nombre ?? string.Empty).Contains("Prestamo", StringComparison.OrdinalIgnoreCase)))
            .Sum(x => Math.Max(0m, x.Importe));

    // Formateadores compactos para la tabla de 18 columnas. / Compact formatters for the
    // 18-column table.
    private static string FmtDineroPos(decimal v) => v > 0m ? v.ToString("C2") : "—";
    private static string FmtDineroNeg(decimal v) => v > 0m ? (-v).ToString("C2") : "—";
    private static string FmtHorasNeg(decimal v) => FormatearHorasResumen(v == 0m ? 0m : -v);

