            return;
        }

        if (nominaSeleccionada != null && EstaBloqueadaNomina(nominaSeleccionada.Estatus))
        {
            error = ObtenerMensajeBloqueoNomina(nominaSeleccionada.Estatus);
            return;
        }

        error = ok = null;
        editandoDetalle = new();
        mostrarFormDetalle = true;
    }

    private async Task OnEmpleadoSeleccionado(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var empId))
        {
            editandoDetalle.EmpleadoId = empId;
            var emp = empleados.FirstOrDefault(x => x.Id == empId);
            if (emp != null)
            {
                var diasPeriodo = Math.Max(1, ((nominaSeleccionada?.FechaFin ?? DateTime.Today).Date - (nominaSeleccionada?.FechaInicio ?? DateTime.Today).Date).Days + 1);
                editandoDetalle.SueldoBase = NominaLegalPolicy.CalcularSueldoBasePeriodo(emp, null, diasPeriodo, configuracionNomina);
            }
        }
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Fusión prenómina→nómina — Fase A "Resumen y captura del periodo".
    // La nómina carga su asistencia directo desde el snapshot de RrhhAsistencia (no necesita
    // una prenómina ligada). "Cerrar periodo y calcular" congela la captura
    // (FechaCierreCaptura + SnapshotConfiguracionJson) y dispara el cálculo (que lee
    // NominaDetalle); "Reabrir captura" la vuelve editable.
    // English: prenómina→nómina fusion — Phase A "Period summary and capture". The nómina
    // loads its attendance straight from the RrhhAsistencia snapshot (no linked prenomina
    // required). "Close period and calculate" freezes capture (FechaCierreCaptura +
    // SnapshotConfiguracionJson) and runs calculation (which reads NominaDetalle); "Reopen
    // capture" makes it editable again.
    // ─────────────────────────────────────────────────────────────────────────────

    private async Task<string?> ObtenerUsuarioActualAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        return state.User.Identity?.Name
            ?? state.User.FindFirst("name")?.Value
            ?? state.User.FindFirst("email")?.Value
            ?? state.User.FindFirst("preferred_username")?.Value;
    }

    // Carga los empleados del periodo cerrado desde el snapshot de asistencias y pobla los
    // campos de asistencia de NominaDetalle (días/extra/banco/minutos/complemento/destajo
    // informativo). Preserva MinutosDescuentoManual y los NominaBono/NominaPercepcion/
    // NominaDeduccion existentes (no los toca). Sólo si la captura está abierta
    // (FechaCierreCaptura == null) y la nómina no está bloqueada.
    // English: Loads the closed-period employees from the attendance snapshot and fills the
    // NominaDetalle attendance fields (days/extra/bank/minutes/complement/informational
    // destajo). Preserves MinutosDescuentoManual and existing NominaBono/NominaPercepcion/
    // NominaDeduccion (untouched). Only when capture is open (FechaCierreCaptura == null)
    // and the nómina isn't locked.
    private async Task CargarEmpleadosDesdeSnapshotAsync()
    {
        error = ok = null;
        if (nominaSeleccionada == null)
            return;

        if (!PuedeModificarCapturaNominaSeleccionada)
        {
            error = CapturaCerradaNominaSeleccionada
                ? "La captura del periodo está cerrada. Reabre la captura para volver a cargar desde asistencias."
                : ObtenerMensajeBloqueoNomina(nominaSeleccionada.Estatus);
            return;
        }

        cargandoSnapshot = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var nomina = await db.Nominas.SingleAsync(n => n.Id == nominaSeleccionada.Id);
            var inicio = nomina.FechaInicio.Date;
            var fin = nomina.FechaFin.Date;

            // Gate duro: tiempo extra detectado sin resolución Autorizada del periodo no se
            // congela (secuencia: autorizar en Asistencias Semanal → cargar → cerrar y calcular).
            // English: Hard gate: detected overtime without an Authorized resolution for the
            // period can't be frozen (sequence: authorize in Weekly Attendances → load → close).
            if (reglasPrenomina.RequiereResolucionAutorizadaParaNomina)
            {
                var sinAutorizar = await ResolucionPeriodo.ObtenerEmpleadosConExtraSinAutorizarAsync(
                    db, _empresaId, nomina.PeriodicidadPago, inicio, fin);
                if (sinAutorizar.Count > 0)
                {
                    error = $"Falta autorizar el tiempo extra de {sinAutorizar.Count} empleado(s) del periodo en Asistencias Semanal antes de cargar la nómina.";
                    return;
                }
            }

            var snapshots = (await PrenominaSnapshotService.ConstruirSnapshotPeriodoAsync(db, inicio, fin, configuracionNomina))
                .Where(s => s.Empleado.PeriodicidadPago == nomina.PeriodicidadPago)
                .ToList();

            var existentes = await db.NominaDetalles
                .Where(d => d.NominaId == nomina.Id)
                .ToListAsync();
            var porEmpleado = existentes.ToDictionary(d => d.EmpleadoId, d => d);

            // Bono distribuido del periodo: el preview de "Cargar empleados" debe reflejar el bono
            // capturado en Bonos distribuidos (misma lectura que "Cerrar y calcular" en
            // SincronizarNominaAsync), no esperar al cierre para mostrar la percepción. Si no hay
            // captura para el empleado, se preserva el MontoBono existente (p.ej. bono manual o
            // legacy) en lugar de forzarlo a 0.
            // English: Distributed bonus for the period: the "Cargar empleados" preview must
            // reflect the bonus captured in Bonos distribuidos (same read as "Cerrar y calcular"
            // in SincronizarNominaAsync), not wait until close to show the perception. When there
            // is no capture for the employee, the existing MontoBono is preserved (e.g. a manual or
            // legacy bonus) instead of forcing it to 0.
            var bonosDistribuidosPeriodo = await db.BonosDistribucionesPeriodoRrhh
                .AsNoTracking()
                .Include(b => b.Detalles)
                    .ThenInclude(d => d.Detalles)
                .Where(b => b.IsActive && b.FechaInicio == inicio && b.FechaFin == fin)
                .ToListAsync();
            var montoBonoPorEmpleado = bonosDistribuidosPeriodo
                .SelectMany(b => b.Detalles.Where(d => d.IsActive))
                .GroupBy(d => d.EmpleadoId)
                .ToDictionary(g => g.Key, g => g.SelectMany(d => d.Detalles.Where(r => r.IsActive)).Sum(r => r.MontoAsignado));

            foreach (var snapshot in snapshots)
            {
                var empleado = snapshot.Empleado;
                var detalle = porEmpleado.TryGetValue(empleado.Id, out var actual)
                    ? actual
                    : new NominaDetalle { Id = Guid.NewGuid(), NominaId = nomina.Id, EmpleadoId = empleado.Id };

                detalle.EsquemaPagoId = snapshot.AsignacionEsquema?.EsquemaPagoId;
                detalle.AplicaImss = snapshot.AplicaImss;
                detalle.MontoDestajoInformativo = snapshot.MontoDestajoInformativo;
                detalle.DiasTrabajados = snapshot.DiasTrabajados;
                detalle.DiasPagados = snapshot.DiasPagados;
                detalle.DiasVacaciones = snapshot.DiasVacaciones;
                detalle.DiasFaltaJustificada = snapshot.DiasFaltaJustificada;
                detalle.DiasFaltaInjustificada = snapshot.DiasFaltaInjustificada;
                detalle.DiasIncapacidad = snapshot.DiasIncapacidad;
                detalle.DiasDescansoTrabajado = snapshot.DiasDescansoTrabajado;
                detalle.DiasConMarcacion = snapshot.DiasConMarcacion;
                detalle.DiasDomingoTrabajado = snapshot.DiasDomingoTrabajado;
                detalle.DiasFestivoTrabajado = snapshot.DiasFestivoTrabajado;
                detalle.DiasPorHorasTrabajados = snapshot.DiasPorHorasTrabajados;
                detalle.MinutosPorHorasNetos = snapshot.MinutosPorHorasNetos;
                detalle.MinutosPorHorasFestivoNetos = snapshot.MinutosPorHorasFestivoNetos;
                detalle.DiasFestivoTrabajadoFija = snapshot.DiasFestivoTrabajadoFija;
                detalle.HorasExtraBase = snapshot.HorasExtraBase;
                detalle.HorasExtra = snapshot.HorasExtra;
                detalle.HorasTrabajadasNetas = snapshot.HorasTrabajadasNetas;
                detalle.HorasBancoAcumuladas = snapshot.HorasBancoAcumuladas;
                detalle.HorasBancoConsumidas = snapshot.HorasBancoConsumidas;
                detalle.HorasBancoSaldoActual = snapshot.HorasBancoSaldoActual;
                detalle.HorasDescansoTomado = snapshot.HorasDescansoTomado;
                detalle.HorasDescansoPagado = snapshot.HorasDescansoPagado;
                detalle.HorasDescansoNoPagado = snapshot.HorasDescansoNoPagado;
                detalle.MinutosRetardo = snapshot.MinutosRetardo;
                detalle.MinutosSalidaAnticipada = snapshot.MinutosSalidaAnticipada;
                detalle.MinutosPerdonadosManual = snapshot.MinutosPerdonadosManual;
                detalle.MinutosFaltanteDescontable = snapshot.MinutosFaltanteDescontable;
                detalle.DiasVacacionesDisponibles = snapshot.DiasVacacionesDisponibles;
                detalle.DiasVacacionesRestantes = Math.Max(0m, snapshot.DiasVacacionesDisponibles - snapshot.DiasVacaciones);
                detalle.ComplementoSalarioMinimoSugerido = snapshot.ComplementoSalarioMinimoSugerido;
                detalle.Notas = snapshot.Notas;
                detalle.FactorPagoTiempoExtra = snapshot.FactorPagoTiempoExtra;
                // Bono distribuido: refleja la captura del periodo en el preview (ver carga arriba).
                // Se preserva el valor existente si no hay captura para el empleado.
                // English: Distributed bonus: reflects the period capture in the preview (see load
                // above). The existing value is preserved when there is no capture for the employee.
                if (montoBonoPorEmpleado.TryGetValue(empleado.Id, out var montoBono))
                    detalle.MontoBono = montoBono;
                // MinutosDescuentoManual se preserva (no viene del snapshot; es captura manual
                // del operador). / MinutosDescuentoManual is preserved (not from the snapshot;
                // it's operator manual capture).

                if (!porEmpleado.ContainsKey(empleado.Id))
                {
                    db.NominaDetalles.Add(detalle);
                    porEmpleado[empleado.Id] = detalle;
                }
            }

            await db.SaveChangesAsync();
            await AuditService.LogAsync("Cargar empleados nómina", nameof(Nomina), nomina.Id,
                $"Carga desde snapshot de asistencias: {snapshots.Count} empleado(s).", _empresaId);

            await Cargar();
            await CargarDetalles();
            await CargarDesgloseValesAsync();
            ok = $"Se cargaron {snapshots.Count} empleado(s) desde asistencias del periodo cerrado.";
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            cargandoSnapshot = false;
        }
    }

    // "Cerrar periodo y calcular": congela la captura (FechaCierreCaptura + SnapshotConfiguracionJson)
    // y dispara el cálculo (SincronizarNominaAsync lee NominaDetalle + la config congelada).
    // English: "Close period and calculate": freezes capture (FechaCierreCaptura +
    // SnapshotConfiguracionJson) and runs calculation (SincronizarNominaAsync reads NominaDetalle +
    // the frozen config).
    private async Task CerrarCapturaYCalcularAsync()
    {
        error = ok = null;
        if (nominaSeleccionada == null)
            return;

        if (!PuedeModificarNominaSeleccionada)
        {
            error = ObtenerMensajeBloqueoNomina(nominaSeleccionada.Estatus);
            return;
        }

        guardando = true;
        try
        {
            var usuarioActual = await ObtenerUsuarioActualAsync();
            await CargarConfiguracionNominaAsync();
            await using var db = await DbFactory.CreateDbContextAsync();
            var nomina = await db.Nominas.SingleAsync(n => n.Id == nominaSeleccionada.Id);
            // Congela la configuración vigente al cierre dentro de la propia nómina: el cálculo
            // la reutiliza aunque la config viva cambie después (auditoría del punto de corte).
            // English: freezes the config in effect at close onto the nómina itself: calculation
            // reuses it even if the live config changes later (cut-off audit point).
            nomina.SnapshotConfiguracionJson ??= System.Text.Json.JsonSerializer.Serialize(configuracionNomina);
            nomina.FechaCierreCaptura ??= DateTime.UtcNow;
            nomina.CerradaCapturaPor = string.IsNullOrWhiteSpace(nomina.CerradaCapturaPor) ? usuarioActual : nomina.CerradaCapturaPor;
            nomina.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            await AuditService.LogAsync("Cerrar captura nómina", nameof(Nomina), nomina.Id,
                $"Captura del periodo congelada por {nomina.CerradaCapturaPor}.", _empresaId);

            // Cálculo: Sincronizar lee la asistencia congelada en NominaDetalle y la config
            // congelada en SnapshotConfiguracionJson (fusión completa, sin prenómina).
            // English: calculation: Sincronizar reads the frozen attendance on NominaDetalle and
            // the frozen config on SnapshotConfiguracionJson (fusion complete, no prenomina).
            await SincronizarNominaAsync(nomina.Id);
            await Cargar();
            await CargarDetalles();
            await CargarDesgloseValesAsync();
            ok = "Captura cerrada y nómina recalculada.";
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    // "Reabrir captura": limpia FechaCierreCaptura para volver a editar la asistencia (Fase A).
    // No se permite si la nómina está Aprobada/Pagada (bloqueada). / "Reopen capture": clears
    // FechaCierreCaptura to edit attendance again (Phase A). Not allowed if the nómina is
    // Approved/Paid (locked).
    private async Task ReabrirCapturaAsync()
    {
        error = ok = null;
        if (nominaSeleccionada == null)
            return;

        if (!PuedeModificarNominaSeleccionada)
        {
            error = ObtenerMensajeBloqueoNomina(nominaSeleccionada.Estatus);
            return;
        }

        guardando = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var nomina = await db.Nominas.SingleAsync(n => n.Id == nominaSeleccionada.Id);
            nomina.FechaCierreCaptura = null;
            nomina.CerradaCapturaPor = null;
            nomina.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            await AuditService.LogAsync("Reabrir captura nómina", nameof(Nomina), nomina.Id,
                "Captura del periodo reabierta.", _empresaId);
            await Cargar();
            await CargarDetalles();
            ok = "Captura reabierta; ya puedes editar la asistencia del periodo.";
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    // Filtro de visualización (sólo render; no muta detallesNomina, así los badges de resumen
    // siguen sumando sobre todos). Acepta nombre, n° de empleado o código de checador.
    // English: Display-only filter (render only; doesn't mutate detallesNomina, so the summary
    // badges still sum over everyone). Matches name, employee number, or clock code.
    private IEnumerable<NominaDetalle> ObtenerDetallesVisiblesNomina()
    {
        var filtro = filtroEmpleadosNomina?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(filtro))
            return detallesNomina;

        return detallesNomina.Where(d =>
            (d.Empleado?.NombreCompleto ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase)
            || (d.Empleado?.NumeroEmpleado ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase)
            || (d.Empleado?.CodigoChecador ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase));
    }

    // Réplica de RrhhTiempoExtraPolicy.ObtenerMinutosDescuentoTotal: retardo + salida +
    // faltante descontable + descuento manual. / Mirrors
    // RrhhTiempoExtraPolicy.ObtenerMinutosDescuentoTotal: tardiness + early-leave +
    // deductible missing + manual discount.
    private static int ObtenerMinutosDescuentoTotal(NominaDetalle detalle)
        => Math.Max(0, detalle.MinutosRetardo)
            + Math.Max(0, detalle.MinutosSalidaAnticipada)
            + Math.Max(0, detalle.MinutosFaltanteDescontable)
            + Math.Max(0, detalle.MinutosDescuentoManual);

    private static string FormatearHorasResumen(decimal horas) => horas.ToString("0.##");

    // "Hrs Pagadas" del periodo = MinutosBasePagadaPeriodo del resumen neteo (mismo batch que
    // Asistencia Semanal). Fija: jornada programada − deducciones netas; PorHoras: trabajado −
    // extra aprobado. 0 si el empleado no tiene resumen (p.ej. sin asistencias en el periodo).
    // English: period "Paid Hrs" = MinutosBasePagadaPeriodo from the netted summary (same batch
    // as Weekly Attendances). Fija: scheduled jornada − net deductions; PorHoras: worked −
    // approved extra. 0 when the employee has no summary (e.g. no attendances in the period).
    private int ObtenerMinutosBasePagadaPeriodo(Guid empleadoId)
        => resumenNeteoPorEmpleado.GetValueOrDefault(empleadoId)?.MinutosBasePagadaPeriodo ?? 0;

    private string ObtenerHorasPagadasResumen(Guid empleadoId)
        => FormatearHorasResumen(ObtenerMinutosBasePagadaPeriodo(empleadoId) / 60m);

    private static string ObtenerNombreDiaSemana(DayOfWeek dia) => dia switch
    {
        DayOfWeek.Sunday => "Domingo",
        DayOfWeek.Monday => "Lunes",
        DayOfWeek.Tuesday => "Martes",
        DayOfWeek.Wednesday => "Miércoles",
        DayOfWeek.Thursday => "Jueves",
        DayOfWeek.Friday => "Viernes",
        DayOfWeek.Saturday => "Sábado",
        _ => dia.ToString()
    };

    // Etiqueta del día de corte configurado para la periodicidad de la nómina seleccionada.
    // English: Label of the configured cutoff day for the selected nómina's periodicity.
    private string ObtenerEtiquetaCorteNomina()
        => nominaSeleccionada == null ? string.Empty : ObtenerEtiquetaCorte(nominaSeleccionada.PeriodicidadPago);

    private string ObtenerEtiquetaCorte(PeriodicidadPago periodicidadPago)
    {
        var corte = ObtenerCortePeriodo(periodicidadPago);
        if (periodicidadPago == PeriodicidadPago.Semanal)
            return $"Corte: {ObtenerNombreDiaSemana(corte.DiaCorteSemana)}";
        return corte.DiaCorteMes >= 28 ? "Corte: fin de mes" : $"Corte: día {corte.DiaCorteMes}";
    }

    // Fusión prenómina→nómina (Etapa 3): el cálculo lee la asistencia directamente de NominaDetalle
    // (cargada desde el snapshot de asistencias y congelada al cerrar la captura) y la configuración
    // congelada de Nomina.SnapshotConfiguracionJson. Ya no carga ni requiere una prenómina. Los
    // bonos/percepciones se toman de los NominaBono/NominaPercepcion ya persistidos (capturados
    // directamente en la nómina) y de los bonos distribuidos por periodo; ya no hay promoción desde
    // la prenómina. English: prenómina→nómina fusion (Stage 3): calculation reads attendance
    // straight from NominaDetalle (loaded from the attendance snapshot and frozen at capture-close)
    // and the frozen config from Nomina.SnapshotConfiguracionJson. It no longer loads or requires a
    // prenomina. Bonuses/perceptions come from already-persisted NominaBono/NominaPerceptron
    // (captured directly on the nómina) and from period-distributed bonuses; there's no longer
    // promotion from the prenomina.
    private async Task SincronizarNominaAsync(Guid nominaId)
    {
        await CargarConfiguracionNominaAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        var nomina = await db.Nominas.FirstOrDefaultAsync(n => n.Id == nominaId);
        if (nomina == null)
        {
            return;
        }

        var inicio = nomina.FechaInicio.Date;
        var fin = nomina.FechaFin.Date;

        // Fase 7 — gate duro: no se calcula la nómina con tiempo extra detectado sin resolución
        // Autorizada del periodo (backstop del paso de dinero). Un periodo sin extra no se bloquea.
        if (reglasPrenomina.RequiereResolucionAutorizadaParaNomina)
        {
            var sinAutorizar = await ResolucionPeriodo.ObtenerEmpleadosConExtraSinAutorizarAsync(
                db, nomina.EmpresaId, nomina.PeriodicidadPago, inicio, fin);
            if (sinAutorizar.Count > 0)
            {
                throw new InvalidOperationException(ObtenerMensajeResolucionRequerida(sinAutorizar.Count));
            }
        }

        // Fusión: la configuración congelada al cerrar la captura vive en la propia nómina
        // (SnapshotConfiguracionJson). Si existe, se calcula con la config vigente al cierre;
        // si no, se mantiene la configuración viva cargada arriba.
        // English: Fusion: the config frozen at capture-close lives on the nómina itself
        // (SnapshotConfiguracionJson). If present, calculation uses the config in effect at close;
        // otherwise the live config loaded above is kept.
        if (!string.IsNullOrWhiteSpace(nomina.SnapshotConfiguracionJson))
        {
            try
            {
                var snapshotConfig = System.Text.Json.JsonSerializer.Deserialize<NominaConfiguracion>(nomina.SnapshotConfiguracionJson);
                if (snapshotConfig != null)
                {
                    configuracionNomina = snapshotConfig;
                }
            }
            catch
            {
                // Si el snapshot no se puede deserializar, se mantiene la configuración viva.
            }
        }

        // La asistencia congelada vive en NominaDetalle (cargada con "Cargar empleados desde
        // asistencias" o por el backfill de la fusión). El cálculo itera esos detalles y lee la
        // asistencia directamente de ellos — ya no hay prenómina como fuente.
        // English: The frozen attendance lives on NominaDetalle (loaded by "Load employees from
        // attendances" or by the fusion backfill). Calculation iterates those details and reads
        // attendance straight from them — there's no longer a prenomina as a source.
        var detallesExistentes = await db.NominaDetalles
            .Where(d => d.NominaId == nominaId)
            .ToListAsync();

        var detallesPorEmpleado = detallesExistentes
            .GroupBy(d => d.EmpleadoId)
            .ToDictionary(g => g.Key, g => g.First());

        var detalleIdsExistentes = detallesExistentes.Select(d => d.Id).ToList();
        var empleadoIds = detallesExistentes.Select(d => d.EmpleadoId).Distinct().ToList();
        var empleadosPorId = await db.Empleados
            .Where(e => empleadoIds.Contains(e.Id))
            .ToDictionaryAsync(e => e.Id);
        var montoBonoPorDetalle = detalleIdsExistentes.Count == 0
            ? new Dictionary<Guid, decimal>()
            : await db.NominasBonos
                .Include(b => b.Detalles)
                .Where(b => b.IsActive && detalleIdsExistentes.Contains(b.NominaDetalleId))
                .ToDictionaryAsync(b => b.NominaDetalleId, b => b.Detalles.Where(d => d.IsActive).Sum(d => d.Importe));
        var percepcionesConfigurablesReferenciaPrefijo = "CONCEPTO_CONFIG:";
        var detalleConPercepcionesPersistidas = detalleIdsExistentes.Count == 0
            ? []
            : await db.NominasPercepciones
                .Where(p => p.IsActive && detalleIdsExistentes.Contains(p.NominaDetalleId))
                .Select(p => p.NominaDetalleId)
                .Distinct()
                .ToHashSetAsync();
        var montoPercepcionesPorDetalle = detalleIdsExistentes.Count == 0
            ? new Dictionary<Guid, decimal>()
            : await db.NominasPercepciones
                .Where(p => p.IsActive
                    && detalleIdsExistentes.Contains(p.NominaDetalleId)
                    && !(p.Origen == OrigenPercepcionNomina.Ajuste
                        && p.Referencia != null
                        && p.Referencia.StartsWith(percepcionesConfigurablesReferenciaPrefijo)))
                .GroupBy(p => p.NominaDetalleId)
                .ToDictionaryAsync(g => g.Key, g => g.Sum(p => p.Importe));
        var deduccionesPorDetalle = detalleIdsExistentes.Count == 0
            ? new Dictionary<Guid, decimal>()
            : await db.NominasDeducciones
                .Where(d => d.IsActive && detalleIdsExistentes.Contains(d.NominaDetalleId))
                .GroupBy(d => d.NominaDetalleId)
                .ToDictionaryAsync(g => g.Key, g => g.Sum(d => d.Importe));
        var conceptosDeduccionPorDetalle = detalleIdsExistentes.Count == 0
            ? new Dictionary<Guid, string?>()
            : await db.NominasDeducciones
                .Include(d => d.TipoDeduccion)
                .Where(d => d.IsActive && detalleIdsExistentes.Contains(d.NominaDetalleId))
                .GroupBy(d => d.NominaDetalleId)
                .ToDictionaryAsync(
                    g => g.Key,
                    g => g.Count() == 1
                        ? g.Select(d => d.TipoDeduccion.Nombre).FirstOrDefault()
                        : "Deducciones estructuradas");
        var bonosNominaExistentes = detalleIdsExistentes.Count == 0
            ? new List<NominaBono>()
            : await db.NominasBonos
                .Include(b => b.Detalles)
                .Where(b => detalleIdsExistentes.Contains(b.NominaDetalleId))
                .ToListAsync();
        var bonosDistribuidosPeriodo = await db.BonosDistribucionesPeriodoRrhh
            .AsNoTracking()
            .Include(b => b.BonoEstructuraRrhh)
                .ThenInclude(e => e.Detalles)
                    .ThenInclude(d => d.BonoRubroRrhh)
            .Include(b => b.Detalles)
                .ThenInclude(d => d.Detalles)
                    .ThenInclude(r => r.BonoRubroRrhh)
            .Where(b => b.IsActive && b.FechaInicio == inicio && b.FechaFin == fin)
            .ToListAsync();
        var bonosDistribuidosPorEmpleado = bonosDistribuidosPeriodo
            .SelectMany(b => b.Detalles.Where(d => d.IsActive), (b, d) => new { Captura = b, Detalle = d })
            .ToDictionary(x => x.Detalle.EmpleadoId, x => x);
        var conceptosEmpleadoActivos = await db.EmpleadosConceptosRrhh
            .Include(c => c.ConceptoConfig)
            .Where(c => c.EmpresaId == nomina.EmpresaId
                && c.IsActive
                && c.ConceptoConfig.IsActive
                && (!c.FechaInicio.HasValue || c.FechaInicio.Value <= fin)
                && (!c.FechaFin.HasValue || c.FechaFin.Value >= inicio))
            .ToListAsync();
        var conceptosActivosPorEmpleado = conceptosEmpleadoActivos
            .GroupBy(c => c.EmpleadoId)
            .ToDictionary(g => g.Key, g => g.OrderBy(c => c.ConceptoConfig.Orden).ThenBy(c => c.ConceptoConfig.Nombre).ToList());
        var percepcionesNominaExistentes = detalleIdsExistentes.Count == 0
            ? new List<NominaPercepcion>()
            : await db.NominasPercepciones
                .Where(p => detalleIdsExistentes.Contains(p.NominaDetalleId))
                .ToListAsync();
        var tiposPercepcionPorClave = await db.NominasPercepcionesTipos
            .Where(t => t.IsActive)
            .ToDictionaryAsync(t => t.Clave);
        var tipoPercepcionOtrosIngresos = await ObtenerOCrearTipoPercepcionOtrosIngresosAsync(db, tiposPercepcionPorClave);
        if (detalleIdsExistentes.Count > 0)
        {
            var provisionesExistentes = await db.NominasProvisionesDetalleRrhh
                .Where(p => detalleIdsExistentes.Contains(p.NominaDetalleId))
                .ToListAsync();

            if (provisionesExistentes.Count > 0)
            {
                db.NominasProvisionesDetalleRrhh.RemoveRange(provisionesExistentes);
            }
        }
        if (detalleIdsExistentes.Count > 0)
        {
            var movimientosBancoNomina = await db.RrhhBancoHorasMovimientos
                .Where(m => m.TipoMovimiento == TipoMovimientoBancoHorasRrhh.GeneradoPorHorasExtra
                    && m.NominaDetalleId.HasValue
                    && detalleIdsExistentes.Contains(m.NominaDetalleId.Value))
                .ToListAsync();

            if (movimientosBancoNomina.Count > 0)
            {
                db.RrhhBancoHorasMovimientos.RemoveRange(movimientosBancoNomina);
            }
        }

        if (detalleIdsExistentes.Count > 0)
        {
            var valesLigadosActuales = await db.ValesDestajo
                .Where(v => v.NominaDetalleId.HasValue
                    && detalleIdsExistentes.Contains(v.NominaDetalleId.Value)
                    && v.Estatus == EstatusValeDestajo.EnNomina)
                .ToListAsync();

            foreach (var vale in valesLigadosActuales)
            {
                vale.NominaDetalleId = null;
                vale.Estatus = EstatusValeDestajo.Aprobado;
                vale.UpdatedAt = DateTime.UtcNow;
            }
        }

        // Load approved vales for the period
        var valesAprobados = await db.ValesDestajo
            .Include(v => v.Detalles)
            .Where(v => v.IsActive
                && (v.Estatus == EstatusValeDestajo.Aprobado
                    || (v.Estatus == EstatusValeDestajo.EnNomina
                        && v.NominaDetalleId.HasValue
                        && detalleIdsExistentes.Contains(v.NominaDetalleId.Value)))
                && v.Fecha >= inicio && v.Fecha <= fin)
            .ToListAsync();

        var valesPorEmp = valesAprobados
            .GroupBy(v => v.EmpleadoId)
            .ToDictionary(g => g.Key, g => g.ToList());

        // Load active scheme assignments
        var asignaciones = await db.EmpleadosEsquemaPago
            .Include(a => a.EsquemaPago)
            .Where(a => a.VigenteDesde <= fin && (a.VigenteHasta == null || a.VigenteHasta >= inicio))
            .ToListAsync();

        var esquemaPorEmp = asignaciones
            .GroupBy(a => a.EmpleadoId)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(a => a.VigenteDesde).First());

        var festivosPeriodo = await db.FestivosRrhh
            .AsNoTracking()
            .Where(f => f.IsActive && f.Fecha >= inicio && f.Fecha <= fin && f.AplicaPrimaEspecial)
            .ToListAsync();

        var factoresFestivoPorFecha = festivosPeriodo
            .GroupBy(f => DateOnly.FromDateTime(f.Fecha.Date))
            .ToDictionary(
                g => g.Key,
                g => configuracionNomina.ObtenerFactorFestivoTrabajado(g.OrderByDescending(f => f.FactorPago).Select(f => (decimal?)f.FactorPago).FirstOrDefault()));

        var fechasFestivas = factoresFestivoPorFecha.Keys.ToList();
        var sumaFactorFestivoPorEmpleado = new Dictionary<Guid, decimal>();
        if (fechasFestivas.Count > 0)
        {
            var asistenciasFestivoTrabajado = await db.RrhhAsistencias
                .AsNoTracking()
                .Where(a => empleadoIds.Contains(a.EmpleadoId)
                    && a.Fecha >= DateOnly.FromDateTime(inicio)
                    && a.Fecha <= DateOnly.FromDateTime(fin)
                    && fechasFestivas.Contains(a.Fecha)
                    && (a.Estatus == RrhhAsistenciaEstatus.AsistenciaNormal
                        || a.Estatus == RrhhAsistenciaEstatus.Retardo
                        || a.Estatus == RrhhAsistenciaEstatus.Incompleta
                        || a.Estatus == RrhhAsistenciaEstatus.DescansoTrabajado
                        || a.Estatus == RrhhAsistenciaEstatus.TrabajadoPorHoras))
                .Select(a => new { a.EmpleadoId, a.Fecha })
                .ToListAsync();

            sumaFactorFestivoPorEmpleado = asistenciasFestivoTrabajado
                .GroupBy(a => a.EmpleadoId)
                .ToDictionary(
                    g => g.Key,
                    g => g.Sum(a => factoresFestivoPorFecha.TryGetValue(a.Fecha, out var factor) ? factor : configuracionNomina.ObtenerFactorFestivoTrabajado()));
        }

        // Fase 5.5 — resoluciones por periodo autorizadas para esta nómina (fuente
        // autoritativa del tiempo extra). Una sola consulta por nómina, indexada por
        // empleado. Si no hay resolución Autorizada para un empleado, el sourcing cae
        // a la incidencia de prenómina (comportamiento histórico).
        var resolucionesPeriodo = await db.RrhhResolucionesTiempoExtraPeriodo
            .Include(r => r.Lineas)
            .Where(r => r.EmpresaId == nomina.EmpresaId
                && r.PeriodicidadPago == nomina.PeriodicidadPago
                && r.AnioPeriodo == nomina.AnioPeriodo
                && r.NumeroPeriodo == nomina.NumeroPeriodo
                && r.Estatus == RrhhResolucionPeriodoEstatus.Autorizada
                && r.IsActive)
            .ToDictionaryAsync(r => r.EmpleadoId);

        // Fusión: se itera sobre los NominaDetalle existentes (cargados desde el snapshot de
        // asistencias y congelados al cerrar la captura). Ya no se crean renglones aquí — la
        // carga vive en CargarEmpleadosDesdeSnapshotAsync; el cálculo sólo lee y persiste
        // resultados sobre los renglones presentes.
        // English: Fusion: iterate over the existing NominaDetalle rows (loaded from the
        // attendance snapshot and frozen at capture-close). Rows are no longer created here —
        // loading lives in CargarEmpleadosDesdeSnapshotAsync; calculation only reads and
        // persists results onto the present rows.
        foreach (var detalle in detallesPorEmpleado.Values)
        {
            if (!empleadosPorId.TryGetValue(detalle.EmpleadoId, out var empleado))
            {
                // El detalle pertenece a un empleado que ya no existe (baja); se conserva el
                // renglón congelado sin recalcular. No debería ocurrir en operación normal.
                // English: the detail belongs to an employee that no longer exists (terminated);
                // the frozen row is kept without recalculation. Should not happen in normal use.
                continue;
            }

            var asignacion = esquemaPorEmp.GetValueOrDefault(empleado.Id);
            var esquema = asignacion?.EsquemaPago;
            var resolucionPeriodo = resolucionesPeriodo.GetValueOrDefault(empleado.Id);
            // La asistencia congelada se lee del propio NominaDetalle; el sourcing la consume
            // igual que antes consumía la incidencia de prenómina.
            // English: the frozen attendance is read from the NominaDetalle itself; sourcing
            // consumes it just as it previously consumed the prenomina incidence.
            var sourcing = NominaTiempoExtraSourcing.Source(
                NominaTiempoExtraSourcing.InputFrom(detalle),
                resolucionPeriodo, configuracionNomina, detalle.FactorPagoTiempoExtra);
            detalle.EsquemaPagoId ??= esquema?.Id;
            detalle.TipoPago = empleado.TipoNomina;
            // Días/asistencia: ya congelados en el detalle (cargados desde el snapshot).
            // English: days/attendance: already frozen on the detail (loaded from the snapshot).
            var diasPagados = detalle.DiasPagados;
            var diasVacaciones = detalle.DiasVacaciones;
            // Fase 5.5 — tiempo extra y deducciones vienen de la resolución por periodo
            // autorizada (fuente autoritativa; alivia la deducción de los minutos que el
            // extra absorbió) o, si no existe, del propio detalle (histórico congelado).
            // English: Phase 5.5 — overtime and deductions come from the authorized period
            // resolution (authoritative source; eases the deduction of the minutes the extra
            // absorbed) or, if none exists, from the detail itself (frozen history).
            detalle.HorasExtra = sourcing.HorasExtra;
            detalle.HorasExtraBase = sourcing.HorasExtraBase;
            detalle.HorasExtraBanco = sourcing.HorasExtraBanco;
            detalle.HorasExtraDobles = sourcing.HorasExtraDobles;
            detalle.HorasExtraTriples = sourcing.HorasExtraTriples;
            detalle.FactorPagoTiempoExtra = sourcing.FactorPagoTiempoExtra;
            detalle.HorasExtraFactoradas = sourcing.HorasExtraFactoradas;
            detalle.MinutosFaltanteDescontable = sourcing.MinutosFaltanteDescontable;
            detalle.MinutosRetardo = sourcing.MinutosRetardo;
            detalle.MinutosSalidaAnticipada = sourcing.MinutosSalidaAnticipada;
            detalle.MinutosDescuentoManual = sourcing.MinutosDescuentoManual;
            detalle.MinutosPerdonadosManual = sourcing.MinutosPerdonadosManual;
            detalle.AplicaImss = empleado.AplicaImss && detalle.AplicaImss;

            var sueldoReferencia = NominaLegalPolicy.ObtenerSueldoReferencia(empleado, asignacion);
            var incluyeSueldoBase = NominaLegalPolicy.IncluyeSueldoBase(asignacion);
            // F4b: factor festivo se necesita antes del sueldo base (la parte PorHoras festivo va
            // al base por minutos × factor). Se calcula una vez aquí y se reusa en el calculator.
            var sumaFactorFestivo = sumaFactorFestivoPorEmpleado.GetValueOrDefault(empleado.Id);
            var factorFestivoAplicado = detalle.DiasFestivoTrabajado > 0 && sumaFactorFestivo > 0m
                ? Math.Round(sumaFactorFestivo / detalle.DiasFestivoTrabajado, 4)
                : configuracionNomina.ObtenerFactorFestivoTrabajado();
            // F4b: festivo efectivo (sólo Fija) para no duplicar el festivo PorHoras (ya va en el
            // base por minutos × factor). En puro Fija sigue al total de DiasFestivoTrabajado para
            // respetar correcciones manuales del campo congelado (sin regresión vs. calc previo).
            // English: F4b: effective holiday (Fija only) to avoid duplicating the PorHoras holiday
            // (already in base by minutes × factor). In pure Fija it follows the total
            // DiasFestivoTrabajado to respect manual corrections of the frozen field (no regression).
            var diasFestivoTrabajadoEfectivo = detalle.DiasPorHorasTrabajados == 0
                ? detalle.DiasFestivoTrabajado
                : detalle.DiasFestivoTrabajadoFija;
            // F4b: sueldo base mixto Fija (días × sueldo diario) + PorHoras (minutos × sueldo hora).
            detalle.SueldoBase = NominaSueldoBasePolicy.Calcular(new SueldoBaseInput
            {
                PeriodicidadPago = empleado.PeriodicidadPago,
                IncluyeSueldoBase = incluyeSueldoBase,
                SueldoReferencia = sueldoReferencia,
                DiasPagados = diasPagados,
                DiasPorHorasTrabajados = detalle.DiasPorHorasTrabajados,
                MinutosPorHorasNetos = detalle.MinutosPorHorasNetos,
                MinutosPorHorasFestivoNetos = detalle.MinutosPorHorasFestivoNetos,
                FactorFestivo = factorFestivoAplicado,
                Configuracion = configuracionNomina
            }).SueldoBase;

            if (valesPorEmp.TryGetValue(empleado.Id, out var valesEmp))
            {
                detalle.TotalPiezas = valesEmp.Sum(v => v.Detalles.Sum(d => d.Cantidad));
                detalle.MontoDestajo = valesEmp.Sum(v => v.Detalles.Sum(d => d.Importe));

                // Link vales to this detalle and set status
                foreach (var vale in valesEmp.Where(v => v.Estatus == EstatusValeDestajo.Aprobado))
                {
                    vale.NominaDetalleId = detalle.Id;
                    vale.Estatus = EstatusValeDestajo.EnNomina;
                }
            }
            else
            {
                detalle.TotalPiezas = 0;
                detalle.MontoDestajo = 0;
            }

            detalle.ComplementoSalarioMinimo = NominaLegalPolicy.CalcularComplementoSalarioMinimo(detalle.SueldoBase, detalle.MontoDestajo, diasPagados, configuracionNomina);

            // Fusión: ya no hay bonos/percepciones de prenómina que promover. Los bonos vienen
            // de la distribución por periodo (capturados directo en nómina) o de NominaBono ya
            // persistido; las percepciones manuales de NominaPercepcion ya persistido.
            // English: Fusion: no more prenomina bonuses/perceptions to promote. Bonuses come
            // from the period distribution (captured directly on the nómina) or from already-
            // persisted NominaBono; manual perceptions from already-persisted NominaPercepcion.
            var bonoDistribuido = bonosDistribuidosPorEmpleado.GetValueOrDefault(empleado.Id);
            // Resolución del bono con precedencia clara: (1) distribución capturada del periodo
            // (Bonos distribuidos — el valor NUEVO, incluso si es 0 porque el empleado capturó
            // 0%); (2) bono estructurado ya persistido de un cálculo previo (NominaBonoDetalle);
            // (3) bono manual/legacy congelado en NominaDetalle.MontoBono (se preserva). Antes
            // esto era un `??` sobre decimal? que trataba el 0 de la distribución como "sin
            // valor" y caía al structured, y además el calculator recibía detalle.MontoBono
            // (stale) en vez de este montoBono resuelto → el neto/ISR/IMSS se calculaban con el
            // bono viejo aunque la línea del bono sí se actualizara después (SincronizarBonos-
            // Distribuidos corre DESPUÉS del Calculate). Ahora estampamos detalle.MontoBono =
            // montoBono ANTES del cálculo para que calculator, baseCalculoConceptos y el campo
            // congelado usen el mismo valor nuevo.
            // English: bonus resolution with clear precedence: (1) period capture (the NEW value,
            // even 0 if the employee captured 0%); (2) already-persisted structured bonus
            // (NominaBonoDetalle); (3) manual/legacy frozen MontoBono (preserved). Previously a
            // `??` over decimal? treated the distribution's 0 as "no value" and fell through to
            // structured, and the calculator received detalle.MontoBono (stale) instead of this
            // resolved montoBono → neto/ISR/IMSS were computed with the old bonus even though the
            // bonus line was updated afterward (SincronizarBonosDistribuidos runs AFTER Calculate).
            // Now we stamp detalle.MontoBono = montoBono BEFORE the calculation so calculator,
            // baseCalculoConceptos and the frozen field all use the same new value.
            decimal montoBono;
            if (bonoDistribuido is not null)
                // Sumamos los rubros capturados (Σ MontoAsignado de los rubros activos) en vez de
                // leer el campo denormalizado BonoDistribucionEmpleadoRrhh.MontoAsignado. Ese campo
                // es un cache que puede quedar stale (ej. el bote/pot cambió y no se re-grabó) y
                // diverger del total real capturado — eso hacía que el neto se calculara con el
                // bote viejo mientras el recibo (SincronizarBonosDistribuidos, que SÍ suma rubros)
                // mostraba la captura nueva → nómina inconsistente (neto ≠ percepciones del recibo).
                // Usamos la MISMA fuente que CargarEmpleados (montoBonoPorEmpleado) y
                // SincronizarBonosDistribuidos → las tres lecturas nunca divergen. // English: sum
                // the captured rubros (Σ active rubros' MontoAsignado) instead of reading the
                // denormalized BonoDistribucionEmpleadoRrhh.MontoAsignado field. That field is a
                // cache that can go stale (e.g. the pot changed and wasn't re-saved) and diverge
                // from the real captured total — that made the neto compute with the old pot while
                // the receipt (SincronizarBonosDistribuidos, which DOES sum rubros) showed the new
                // capture → inconsistent nómina (neto ≠ receipt percepciones). We use the SAME
                // source as CargarEmpleados (montoBonoPorEmpleado) and SincronizarBonosDistribuidos
                // → the three reads never diverge.
                montoBono = bonoDistribuido.Detalle.Detalles.Where(r => r.IsActive).Sum(r => r.MontoAsignado);
            else if (montoBonoPorDetalle.TryGetValue(detalle.Id, out var importeEstructurado))
                montoBono = importeEstructurado;
            else
                montoBono = detalle.MontoBono;
            detalle.MontoBono = montoBono;
            var conceptosEmpleado = conceptosActivosPorEmpleado.GetValueOrDefault(empleado.Id) ?? [];
            var baseCalculoConceptos = detalle.SueldoBase + detalle.MontoDestajo + montoBono + detalle.MontoFestivoTrabajado
                + detalle.MontoDescansoTrabajado + detalle.MontoPrimaDominical + detalle.MontoPrimaVacacional + detalle.ComplementoSalarioMinimo
                + detalle.MontoHorasExtra;
            var percepcionesConfigurables = ConstruirPercepcionesConfigurablesEmpleado(conceptosEmpleado, baseCalculoConceptos, tipoPercepcionOtrosIngresos.Id, tiposPercepcionPorClave);
            var totalPercepcionesConfigurables = percepcionesConfigurables.Sum(p => p.Importe);
            var percepcionesManual = montoPercepcionesPorDetalle.TryGetValue(detalle.Id, out var totalPercepcionesManual)
                ? totalPercepcionesManual
                : detalleConPercepcionesPersistidas.Contains(detalle.Id)
                    ? 0m
                    : detalle.Bonos;
            var totalDeducciones = deduccionesPorDetalle.TryGetValue(detalle.Id, out var deduccionesCalculadas) ? deduccionesCalculadas : 0m;
            var conceptoDeduccionBase = conceptosDeduccionPorDetalle.TryGetValue(detalle.Id, out var conceptoDeduccion) ? conceptoDeduccion : null;
            detalle.ConceptoDeducciones = conceptoDeduccionBase;

            var aniosServicio = CalcularAniosServicio(empleado, fin);
            var cicloVacacional = NominaLegalPolicy.ObtenerCicloVacacional(empleado, fin, configuracionNomina);
            var resultado = NominaCalculator.Calculate(new NominaCalculationInput
            {
                Empleado = empleado,
                Configuracion = configuracionNomina,
                SueldoReferencia = incluyeSueldoBase ? sueldoReferencia : 0m,
                SueldoBaseOverride = detalle.SueldoBase,
                DiasPagados = diasPagados,
                DiasVacaciones = diasVacaciones,
                DiasDescansoTrabajado = detalle.DiasDescansoTrabajado,
                DiasDomingoTrabajado = detalle.DiasDomingoTrabajado,
                DiasFestivoTrabajado = diasFestivoTrabajadoEfectivo,
                MinutosDescuento = detalle.MinutosRetardo + detalle.MinutosSalidaAnticipada + detalle.MinutosFaltanteDescontable + detalle.MinutosDescuentoManual,
                AplicaImss = detalle.AplicaImss,
                AplicaIsr = empleado.AplicaIsr,
                HorasExtraBase = detalle.HorasExtraBase,
                HorasExtraDobles = detalle.HorasExtraDobles,
                HorasExtraTriples = detalle.HorasExtraTriples,
                HorasExtraBanco = detalle.HorasExtraBanco,
                HorasExtra = detalle.HorasExtra,
                FactorPagoTiempoExtra = detalle.FactorPagoTiempoExtra,
                HorasExtraFactoradas = detalle.HorasExtraFactoradas,
                MontoDestajo = detalle.MontoDestajo,
                MontoBono = montoBono,
                MontoPercepcionesManuales = percepcionesManual + totalPercepcionesConfigurables,
                MontoDeducciones = totalDeducciones,
                ComplementoSalarioMinimo = detalle.ComplementoSalarioMinimo,
                FactorFestivo = factorFestivoAplicado,
                AniosServicio = aniosServicio,
                DiasVacacionesAnualesOverride = cicloVacacional.DiasVacacionesEquivalentes
            });

            AplicarResultadoCalculo(detalle, resultado);
            AplicarConceptosConfigurablesEmpleado(db, nomina, detalle, conceptosEmpleado, totalDeducciones, conceptoDeduccionBase);

            if (bonoDistribuido is not null)
                SincronizarBonosDistribuidos(db, bonosNominaExistentes, detalle, bonoDistribuido.Detalle, nomina.EmpresaId);

            SincronizarPercepcionesConfigurables(db, percepcionesNominaExistentes, detalle, percepcionesConfigurables, nomina.EmpresaId, percepcionesConfigurablesReferenciaPrefijo);
        }

        nomina.UpdatedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
    }

    private async Task GuardarCambiosDetalle(NominaDetalle detalle)
    {
        error = ok = null;
        guardando = true;

        try
        {
            if (!_puedeEditar)
            {
                error = "No tienes permisos para modificar nóminas.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var existente = await db.NominaDetalles.FirstOrDefaultAsync(x => x.Id == detalle.Id);
            if (existente == null)
            {
                error = "No se encontró el detalle de nómina.";
                return;
            }

            var nominaActual = await db.Nominas.AsNoTracking().FirstOrDefaultAsync(n => n.Id == existente.NominaId);
            if (nominaActual == null)
            {
                error = "No se encontró la nómina del detalle.";
                return;
            }

            if (EstaBloqueadaNomina(nominaActual.Estatus))
            {
                error = ObtenerMensajeBloqueoNomina(nominaActual.Estatus);
                return;
            }

            existente.MinutosRetardo = detalle.MinutosRetardo;
            existente.MinutosSalidaAnticipada = detalle.MinutosSalidaAnticipada;
            existente.MinutosFaltanteDescontable = detalle.MinutosFaltanteDescontable;
            existente.MinutosDescuentoManual = detalle.MinutosDescuentoManual;
            existente.Bonos = detalle.Bonos;
            existente.Deducciones = detalle.Deducciones;
            // Override de observaciones del recibo: NotasManual vacío/blank = null (usa la
            // sugerencia automática Notas). No afecta TotalPagar ni el cálculo. English:
            // receipt observations override — blank NotasManual = null (uses auto Notas).
            existente.NotasManual = string.IsNullOrWhiteSpace(detalle.NotasManual) ? null : detalle.NotasManual.Trim();

            var empleado = await db.Empleados.FirstOrDefaultAsync(x => x.Id == existente.EmpleadoId);

            if (empleado != null)
            {
                AplicarResultadoCalculo(existente, CalcularResultadoPreview(existente, empleado));
            }

            await db.SaveChangesAsync();
            await Cargar();
            await CargarDetalles();
            await CargarDesgloseValesAsync();
            ok = "Detalle de nómina actualizado.";
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    // Limpia el override manual de observaciones para que el recibo vuelva a usar la
    // sugerencia automática (Notas). Sólo efecto en memoria + UI; persiste al "Guardar
    // detalle". English: clears the manual observations override so the receipt falls back
    // to the auto-suggested Notas. In-memory + UI only; persists on "Guardar detalle".
    private void RestaurarNotasRecibo(NominaDetalle detalle)
    {
        detalle.NotasManual = null;
    }

    private async Task GuardarNomina()
    {
        error = ok = null; guardando = true;
        try
        {
            if (!_puedeEditar)
            {
                error = "No tienes permisos para guardar nóminas.";
                return;
            }

            if (string.IsNullOrWhiteSpace(editando.Periodo)) { error = "Periodo es requerido."; return; }

            var empresaId = _empresaId;
            if (empresaId == Guid.Empty) { error = "No hay empresa activa."; return; }

            await using var db = await DbFactory.CreateDbContextAsync();
            var periodoActual = NominaPeriodoHelper.ObtenerPeriodo(editando.PeriodicidadPago, editando.FechaFin == default ? DateTime.Today : editando.FechaFin, ObtenerCortePeriodo(editando.PeriodicidadPago));
            editando.PeriodicidadPago = periodoActual.PeriodicidadPago;
            editando.AnioPeriodo = periodoActual.AnioPeriodo;
            editando.NumeroPeriodo = periodoActual.NumeroPeriodo;
            editando.Periodo = periodoActual.Periodo;
            editando.NumeroNomina = periodoActual.NumeroNomina;
            editando.FechaInicio = periodoActual.Inicio;
            editando.FechaFin = periodoActual.Fin;

            var periodo = editando.Periodo.Trim();
            var numeroNomina = string.IsNullOrWhiteSpace(editando.NumeroNomina) ? null : editando.NumeroNomina.Trim();

            // Fase 7 — gate duro: no se guarda la nómina con tiempo extra detectado sin resolución
            // Autorizada del periodo. Un periodo sin extra no se bloquea.
            // English: Phase 7 — hard gate: the nómina is not saved with detected overtime lacking
            // an Authorized period resolution. A period with no overtime is not blocked.
            if (reglasPrenomina.RequiereResolucionAutorizadaParaNomina)
            {
                var sinAutorizar = await ResolucionPeriodo.ObtenerEmpleadosConExtraSinAutorizarAsync(
                    db, empresaId, editando.PeriodicidadPago, editando.FechaInicio.Date, editando.FechaFin.Date);
                if (sinAutorizar.Count > 0)
                {
                    error = ObtenerMensajeResolucionRequerida(sinAutorizar.Count);
                    return;
                }
            }

            if (await db.Nominas.AnyAsync(n => n.EmpresaId == empresaId
                && n.Id != editando.Id
                && n.PeriodicidadPago == editando.PeriodicidadPago
                && n.AnioPeriodo == editando.AnioPeriodo
                && n.NumeroPeriodo == editando.NumeroPeriodo))
            {
                error = "Ya existe una nómina para ese período calendario y periodicidad.";
                return;
            }

            if (editando.Id == Guid.Empty)
            {
                editando.Folio = string.IsNullOrWhiteSpace(editando.Folio)
                    ? await CodigoNegocio.GetNextPeriodFolioAsync(empresaId, "NOM", "Consecutivo:Nomina", editando.FechaInicio)
                    : editando.Folio.Trim();
                // Fusión: la nómina nace sin prenómina ligada y con los NominaDetalle vacíos; la
                // carga de empleados y el cálculo se disparan desde la Fase A ("Cargar empleados"
                // + "Cerrar periodo y calcular").
                // English: Fusion: the nómina is born with no linked prenomina and empty
                // NominaDetalle; loading employees and calculation are triggered from Phase A.
                var nueva = new Nomina
                {
                    EmpresaId = empresaId, Folio = editando.Folio, NumeroNomina = numeroNomina, PeriodicidadPago = editando.PeriodicidadPago, AnioPeriodo = editando.AnioPeriodo, NumeroPeriodo = editando.NumeroPeriodo, Periodo = periodo,
                    FechaInicio = editando.FechaInicio, FechaFin = editando.FechaFin,
                    FechaPago = editando.FechaPago, Estatus = editando.Estatus, Notas = editando.Notas?.Trim()
                };
                db.Nominas.Add(nueva);
                await db.SaveChangesAsync();
                await AuditService.LogAsync("Crear nómina", nameof(Nomina), nueva.Id, $"Nómina {nueva.Periodo} creada.", empresaId);
                ok = "Nómina guardada. Usa «Cargar empleados desde asistencias» para traer el periodo y luego «Cerrar periodo y calcular».";
                mostrarForm = false; await Cargar();
                return;
            }
            else
            {
                var ex = await db.Nominas.FirstOrDefaultAsync(n => n.Id == editando.Id);
                if (ex == null) return;
                if (EstaBloqueadaNomina(ex.Estatus))
                {
                    error = ObtenerMensajeBloqueoNomina(ex.Estatus);
                    _nominaEditandoBloqueada = true;
                    return;
                }

                ex.Folio = string.IsNullOrWhiteSpace(editando.Folio) ? ex.Folio : editando.Folio.Trim();
                ex.NumeroNomina = numeroNomina;
                ex.PeriodicidadPago = editando.PeriodicidadPago;
                ex.AnioPeriodo = editando.AnioPeriodo;
                ex.NumeroPeriodo = editando.NumeroPeriodo;
                ex.Periodo = periodo; ex.FechaInicio = editando.FechaInicio;
                ex.FechaFin = editando.FechaFin; ex.FechaPago = editando.FechaPago;
                ex.Estatus = editando.Estatus; ex.Notas = editando.Notas?.Trim(); ex.UpdatedAt = DateTime.UtcNow;
                await db.SaveChangesAsync();
                // El recálculo vive en la Fase A ("Cerrar periodo y calcular"); al guardar sólo
                // cabecera no se recalcula para no pisar la captura en curso.
                // English: recalculation lives in Phase A ("Close period and calculate"); saving
                // the header only does not recalculate, to avoid clobbering the in-progress capture.
                await AuditService.LogAsync("Editar nómina", nameof(Nomina), ex.Id, $"Nómina {ex.Periodo} actualizada.", empresaId);
                ok = "Nómina guardada."; mostrarForm = false; await Cargar();
                return;
            }
        }
        catch (Exception ex) { error = ex.InnerException?.Message ?? ex.Message; }
        finally { guardando = false; }
    }

    private async Task GuardarDetalle()
    {
        error = ok = null; guardando = true;
        try
        {
            if (!_puedeEditar)
            {
                error = "No tienes permisos para modificar nóminas.";
                return;
            }

            if (nominaSeleccionada != null && EstaBloqueadaNomina(nominaSeleccionada.Estatus))
            {
                error = ObtenerMensajeBloqueoNomina(nominaSeleccionada.Estatus);
                return;
            }

            if (nominaSeleccionada == null || editandoDetalle.EmpleadoId == Guid.Empty)
            { error = "Seleccione un empleado."; return; }

            await using var db = await DbFactory.CreateDbContextAsync();
            var empleado = await db.Empleados.AsNoTracking().FirstOrDefaultAsync(e => e.Id == editandoDetalle.EmpleadoId);
            if (empleado == null)
            {
                error = "No se encontró el empleado seleccionado.";
                return;
            }

            if (empleado.PeriodicidadPago != nominaSeleccionada.PeriodicidadPago)
            {
                error = "El empleado no coincide con la periodicidad de esta nómina.";
                return;
            }

            db.NominaDetalles.Add(new NominaDetalle
            {
                NominaId = nominaSeleccionada.Id, EmpleadoId = editandoDetalle.EmpleadoId,
                SueldoBase = editandoDetalle.SueldoBase,
                HorasExtra = editandoDetalle.HorasExtra, MontoHorasExtra = editandoDetalle.MontoHorasExtra,
                Bonos = editandoDetalle.Bonos, Deducciones = editandoDetalle.Deducciones,
                ConceptoDeducciones = editandoDetalle.ConceptoDeducciones, Notas = editandoDetalle.Notas
            });
            await db.SaveChangesAsync();
            ok = "Empleado agregado."; mostrarFormDetalle = false;
            await Cargar(); await CargarDetalles();
        }
        catch (Exception ex) { error = ex.InnerException?.Message ?? ex.Message; }
        finally { guardando = false; }
    }

    private async Task EliminarDetalle(Guid id)
    {
        error = ok = null;
        try
        {
            if (!_puedeEditar)
            {
                error = "No tienes permisos para modificar nóminas.";
                return;
            }

            if (nominaSeleccionada != null && EstaBloqueadaNomina(nominaSeleccionada.Estatus))
            {
                error = ObtenerMensajeBloqueoNomina(nominaSeleccionada.Estatus);
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var d = await db.NominaDetalles.FirstOrDefaultAsync(x => x.Id == id);
            if (d != null) { db.NominaDetalles.Remove(d); await db.SaveChangesAsync(); }
            await Cargar(); await CargarDetalles();
        }
        catch (Exception ex) { error = ex.InnerException?.Message ?? ex.Message; }
    }

