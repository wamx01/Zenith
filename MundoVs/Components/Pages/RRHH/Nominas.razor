@page "/rrhh/nominas"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MundoVs.Core.Entities
@using MundoVs.Core.Entities.Serigrafia
@using MundoVs.Core.Interfaces
@using MundoVs.Core.Services
@using MundoVs.Infrastructure.Data
@inject IJSRuntime JSRuntime
@inject IDbContextFactory<CrmDbContext> DbFactory
@inject IAppConfigRepository AppConfig
@inject INominaCalculator NominaCalculator
@inject INominaLegalPolicyService NominaLegalPolicy
@inject INominaSueldoBasePolicy NominaSueldoBasePolicy
@inject INominaResumenBuilder NominaResumenBuilder
@inject CodigoNegocioService CodigoNegocio
@inject IAuditService AuditService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IRrhhResolucionPeriodoService ResolucionPeriodo
@inject IRrhhNominaSnapshotService PrenominaSnapshotService
@rendermode InteractiveServer

<PageTitle>Nóminas</PageTitle>

<div class="container-fluid px-4">
    @if (!_puedeVer)
    {
        <div class="alert alert-warning mt-3">No tienes permisos para ver nóminas.</div>
    }
    else
    {
    <div class="d-flex align-items-center justify-content-between mb-3 gap-2 flex-wrap">
        <h1 class="display-6 fw-bold"><i class="bi bi-wallet2 me-2"></i>Nóminas</h1>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" href="/rrhh/asistencias"><i class="bi bi-calendar-check me-1"></i>Ir a asistencias</a>
            @if (_puedeEditar)
            {
                <button class="btn btn-primary" @onclick="NuevaNomina"><i class="bi bi-plus-circle me-1"></i>Nueva Nómina</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger">@error</div> }
    @if (!string.IsNullOrEmpty(ok)) { <div class="alert alert-success">@ok</div> }

    @* ══ FORMULARIO NÓMINA ══ *@
    @if (mostrarForm)
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">@(editando.Id == Guid.Empty ? "Nueva Nómina" : "Editar Nómina")</h5></div>
            <div class="card-body">
                <EditForm Model="editando" OnValidSubmit="GuardarNomina">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Periodicidad</label>
                            <InputSelect class="form-select" @bind-Value="editando.PeriodicidadPago" @bind-Value:after="OnPeriodicidadNominaChangedAsync" disabled="@(editando.Id != Guid.Empty || !PuedeModificarNominaEditando)">
                                @foreach (var periodicidad in PeriodicidadesDisponibles)
                                {
                                    <option value="@periodicidad">@periodicidad</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha de referencia</label>
                            <InputDate class="form-control" @bind-Value="fechaReferenciaNomina" @bind-Value:after="OnFechaReferenciaNominaChangedAsync" disabled="@(editando.Id != Guid.Empty || !PuedeModificarNominaEditando)" />
                            <div class="form-text">@ObtenerAyudaFechaReferencia(editando.PeriodicidadPago)</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Folio</label>
                            <InputText class="form-control" @bind-Value="editando.Folio" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Número nómina</label>
                            <InputText class="form-control" @bind-Value="editando.NumeroNomina" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Periodo</label>
                            <InputText class="form-control" @bind-Value="editando.Periodo" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Ciclo</label>
                            <input class="form-control" value="@ObtenerClavePeriodo(editando.PeriodicidadPago, editando.AnioPeriodo, editando.NumeroPeriodo)" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Inicio</label>
                            <InputDate class="form-control" @bind-Value="editando.FechaInicio" disabled="true" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Fin</label>
                            <InputDate class="form-control" @bind-Value="editando.FechaFin" disabled="true" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estatus</label>
                            <InputSelect class="form-select" @bind-Value="editando.Estatus" disabled="@(!PuedeModificarNominaEditando)">
                                @foreach (var e in Enum.GetValues<EstatusNomina>()) { <option value="@e">@e</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Pago</label>
                            <InputDate class="form-control" @bind-Value="editando.FechaPago" disabled="@(!PuedeModificarNominaEditando)" />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Notas</label>
                            <InputText class="form-control" @bind-Value="editando.Notas" disabled="@(!PuedeModificarNominaEditando)" />
                        </div>
                        @if (festivosPeriodo.Count > 0)
                        {
                            <div class="col-12">
                                <div class="alert alert-info py-2 small mb-0">
                                    <strong>Festivos en el período:</strong>
                                    @string.Join(", ", festivosPeriodo.OrderBy(f => f.Fecha).Select(f => $"{f.Fecha:dd/MM} {f.Nombre}"))
                                </div>
                            </div>
                        }
                        <div class="col-12 d-flex gap-2">
                            <button class="btn btn-success" type="submit" disabled="@(guardando || !PuedeModificarNominaEditando)"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => mostrarForm = false">Cancelar</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @* ══ DETALLE DE NÓMINA (empleados) ══ *@
    @if (nominaSeleccionada != null)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-people-fill me-1"></i>Detalle — @(string.IsNullOrWhiteSpace(nominaSeleccionada.NumeroNomina) ? nominaSeleccionada.Periodo : $"{nominaSeleccionada.NumeroNomina} · {nominaSeleccionada.Periodo}")</h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-primary">@detallesNomina.Count empleados</span>
                    <a class="btn btn-sm btn-outline-light" href="/configuracion/nomina"><i class="bi bi-sliders me-1"></i>Config nómina</a>
                    <a class="btn btn-sm btn-outline-light" href="/rrhh/bonos-distribuidos"><i class="bi bi-percent me-1"></i>Distribución</a>
                    <button class="btn btn-sm btn-outline-light" @onclick="ImprimirTodosRecibos" disabled="@(detallesNomina.Count == 0)"><i class="bi bi-printer me-1"></i>Imprimir todo</button>
                    @if (PuedeModificarNominaSeleccionada)
                    {
                        <button class="btn btn-sm btn-light" @onclick="RecalcularNominaSeleccionada" disabled="@(guardando || !PuedeModificarNominaSeleccionada)"><i class="bi bi-arrow-repeat me-1"></i>Recalcular</button>
                    }
                </div>
            </div>

            <div class="card-body border-bottom py-2">
                @if (festivosPeriodo.Count > 0)
                {
                    <div class="alert alert-info py-2 small mb-2">
                        <strong>Festivos del período:</strong>
                        @string.Join(", ", festivosPeriodo.OrderBy(f => f.Fecha).Select(f => $"{f.Fecha:dd/MM} {f.Nombre}"))
                    </div>
                }
                <div class="d-flex flex-wrap gap-2 small">
                    <span class="badge text-bg-light">Sueldo base: @resumenNomina.TotalSueldoBase.ToString("C2")</span>
                    <span class="badge text-bg-light">Destajo: @resumenNomina.TotalDestajo.ToString("C2")</span>
                    <span class="badge text-bg-light">Bono: @resumenNomina.TotalBono.ToString("C2")</span>
                    <span class="badge text-bg-light">Festivo trabajado: @resumenNomina.TotalFestivoTrabajado.ToString("C2")</span>
                     <span class="badge text-bg-light">Descanso trabajado: @resumenNomina.TotalDescansoTrabajado.ToString("C2")</span>
                    <span class="badge text-bg-light">Prima dominical: @resumenNomina.TotalPrimaDominical.ToString("C2")</span>
                    <span class="badge text-bg-light">Prima vacacional: @resumenNomina.TotalPrimaVacacional.ToString("C2")</span>
                    <span class="badge text-bg-light">Comp. salario mín.: @resumenNomina.TotalComplementoSalarioMinimo.ToString("C2")</span>
                    <span class="badge text-bg-light">Hrs dobles: @resumenNomina.TotalHorasExtraDobles.ToString("0.##")</span>
                    <span class="badge text-bg-light">Hrs triples: @resumenNomina.TotalHorasExtraTriples.ToString("0.##")</span>
                    <span class="badge text-bg-light">Hrs banco: @resumenNomina.TotalHorasExtraBanco.ToString("0.##")</span>
                    <span class="badge text-bg-light">Horas extra: @resumenNomina.TotalHorasExtra.ToString("C2")</span>
                    <span class="badge text-bg-light">Percep. manuales: @resumenNomina.TotalPercepcionesManuales.ToString("C2")</span>
                    <span class="badge text-bg-light">IMSS obrero: @resumenNomina.TotalImssObrero.ToString("C2")</span>
                    <span class="badge text-bg-light">ISR: @resumenNomina.TotalIsr.ToString("C2")</span>
                    <span class="badge text-bg-light">IMSS patronal: @resumenNomina.TotalImssPatronal.ToString("C2")</span>
                    <span class="badge text-bg-light">Terceros: @resumenNomina.TotalObligacionesTerceros.ToString("C2")</span>
                    <span class="badge text-bg-light">Provisiones: @resumenNomina.TotalProvisiones.ToString("C2")</span>
                    <span class="badge text-bg-light">Costo empresa: @resumenNomina.TotalCostoEmpresa.ToString("C2")</span>
                    <span class="badge text-bg-danger">Infonavit: @resumenNomina.TotalInfonavit.ToString("C2")</span>
                    <span class="badge text-bg-danger">Deducciones: @resumenNomina.TotalDeducciones.ToString("C2")</span>
                     <span class="badge text-bg-danger">Desc. minutos: @resumenNomina.TotalDescuentoMinutos.ToString("C2")</span>
                    <span class="badge text-bg-success">Total: @resumenNomina.TotalNeto.ToString("C2")</span>
                </div>
                <div class="row g-2 mt-2 small">
                    <div class="col-xl-3 col-md-6">
                        <div class="border rounded p-2 h-100 bg-white">
                            <div class="text-muted text-uppercase small fw-semibold">Neto empleado</div>
                            <div class="fw-bold text-success fs-6">@resumenNomina.TotalNeto.ToString("C2")</div>
                            <div>Sueldo, destajo, bonos y percepciones menos descuentos del trabajador.</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="border rounded p-2 h-100 bg-white">
                            <div class="text-muted text-uppercase small fw-semibold">Obligaciones a terceros</div>
                            <div class="fw-bold fs-6">@resumenNomina.TotalObligacionesTerceros.ToString("C2")</div>
                            <div>ISR @resumenNomina.TotalIsr.ToString("C2") · IMSS obrero @resumenNomina.TotalImssObrero.ToString("C2") · Infonavit @resumenNomina.TotalInfonavit.ToString("C2")</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="border rounded p-2 h-100 bg-white">
                            <div class="text-muted text-uppercase small fw-semibold">Aportaciones patronales</div>
                            <div class="fw-bold fs-6">@resumenNomina.TotalAportacionesPatronales.ToString("C2")</div>
                            <div>IMSS patronal @resumenNomina.TotalImssPatronal.ToString("C2")</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="border rounded p-2 h-100 bg-white">
                            <div class="text-muted text-uppercase small fw-semibold">Provisiones y costo</div>
                            <div class="fw-bold fs-6">@resumenNomina.TotalCostoEmpresa.ToString("C2")</div>
                            <div>Prov. @resumenNomina.TotalProvisiones.ToString("C2") · Costo empresa total</div>
                        </div>
                    </div>
                </div>
                <div class="small text-muted mt-2">Total neto = sueldo base + destajo + bono + festivo trabajado + descanso trabajado + prima dominical + prima vacacional + complemento salario mínimo + horas extra + percepciones manuales - descuentos por minutos - IMSS obrero - Infonavit - deducciones estructuradas.</div>
            </div>

            @* ══ FASE A — Resumen y captura del periodo (fusión prenómina→nómina) ══
               La asistencia se carga directo desde el snapshot de Asistencias Semanal (periodo
               cerrado). "Cerrar periodo y calcular" congela la captura y dispara el cálculo
               (SincronizarNominaAsync lee NominaDetalle + la config congelada); "Reabrir captura"
               la vuelve editable. Las observaciones (Notas) NO van en esta tabla: se muestran
               aparte en la sección "Observaciones del periodo" de abajo.
               English: Phase A — Period summary and capture (prenómina→nómina fusion).
               Attendance loads straight from the Weekly Attendances snapshot (closed period).
               "Close period and calculate" freezes capture and runs the calculation
               (SincronizarNominaAsync reads NominaDetalle + the frozen config); "Reopen capture"
               makes it editable again. Observations (Notas) are NOT in this table: shown
               separately in the "Period observations" section below. *@
            <div class="card-body border-bottom">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <h6 class="mb-0"><i class="bi bi-clipboard-data me-1"></i>Fase A — Resumen y captura del periodo</h6>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge @(CapturaCerradaNominaSeleccionada ? "bg-success" : "bg-warning text-dark")">@(CapturaCerradaNominaSeleccionada ? "Captura cerrada" : "Captura abierta")</span>
                        <span class="badge text-bg-light">@ObtenerEtiquetaCorteNomina()</span>
                        @if (CapturaCerradaNominaSeleccionada && !string.IsNullOrWhiteSpace(nominaSeleccionada.CerradaCapturaPor))
                        {
                            <span class="small text-muted">Cerrada por @nominaSeleccionada.CerradaCapturaPor · @(nominaSeleccionada.FechaCierreCaptura?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? string.Empty)</span>
                        }
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-2">
                    @if (PuedeModificarCapturaNominaSeleccionada)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="CargarEmpleadosDesdeSnapshotAsync" disabled="@(cargandoSnapshot || guardando)">
                            <i class="bi bi-cloud-download me-1"></i>@(cargandoSnapshot ? "Cargando…" : "Cargar empleados desde asistencias")
                        </button>
                        <button class="btn btn-sm btn-success" @onclick="CerrarCapturaYCalcularAsync" disabled="@(guardando || cargandoSnapshot || detallesNomina.Count == 0)">
                            <i class="bi bi-lock-fill me-1"></i>Cerrar periodo y calcular
                        </button>
                    }
                    @if (CapturaCerradaNominaSeleccionada && PuedeModificarNominaSeleccionada)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ReabrirCapturaAsync" disabled="@guardando">
                            <i class="bi bi-unlock me-1"></i>Reabrir captura
                        </button>
                    }
                </div>

                @if (detallesNomina.Count == 0)
                {
                    <div class="alert alert-light small mb-0 py-2">
                        <i class="bi bi-info-circle me-1"></i>No hay empleados cargados. Presiona <strong>"Cargar empleados desde asistencias"</strong> para traer el snapshot del periodo cerrado (@nominaSeleccionada.FechaInicio.ToString("dd/MM/yyyy") – @nominaSeleccionada.FechaFin.ToString("dd/MM/yyyy")).
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <input class="form-control form-control-sm" style="max-width: 22rem;" placeholder="Filtrar por nombre, n° empleado o checador…" @bind="filtroEmpleadosNomina" />
                        <span class="small text-muted">@ObtenerDetallesVisiblesNomina().Count() de @detallesNomina.Count empleados</span>
                    </div>

                    @* Hint: los ingresos/descuentos en dinero se calculan al "Cerrar periodo y calcular".
                       Mientras la captura está abierta la tabla unificada muestra valores pendientes
                       (sueldo $0, descuento minutos $0). English: money incomes/deductions are
                       calculated on "Close period and calculate". While capture is open the unified
                       table shows pending values (salary $0, minutes discount $0). *@
                    @if (!CapturaCerradaNominaSeleccionada)
                    {
                        <div class="alert alert-warning small mb-2 py-2">
                            <i class="bi bi-info-circle me-1"></i>Los <strong>ingresos y descuentos en dinero</strong> (sueldo, horas extra, descuento por minutos, IMSS, ISR) se calculan al presionar <strong>"Cerrar periodo y calcular"</strong>. Mientras la captura esté abierta, la tabla muestra los valores pendientes de cálculo (sueldo $0.00, descuento $0.00).
                        </div>
                    }

                    @* Tabla de 18 columnas por empleado: SEMANA · Periodo del · Al · Total Hrs Pagadas ·
                       Entró a Banco · Usaste Banco · Saldo Banco · Hrs Adic a Pagar · Pago Hrs Adic ·
                       DESEMPEÑO % · INCENTIVOS · ASUETO · IMSS · Descuento por Falta · Total Ingresos ·
                       Abono a Deuda · Saldo Deuda · Total a Pagar. El desglose granular día a día y el
                       recibo viven en el modal "Detalle" (botón en la celda Empleado). Descuento por
                       Falta = MontoDescuentoMinutos en $ (antes sólo se veía en minutos). English:
                       18-column per-employee table. Day-by-day detail and the receipt live in the
                       "Detalle" modal (button in the Empleado cell). Descuento por Falta =
                       MontoDescuentoMinutos in $ (previously only shown in minutes). *@
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0 align-middle small text-center text-nowrap">
                            <thead class="table-light text-center">
                                <tr>
                                    <th class="text-start" style="min-width:14rem;">Empleado</th>
                                    <th>SEM.</th>
                                    <th>Periodo del</th>
                                    <th>Al</th>
                                    <th>Total Hrs. Pagadas</th>
                                    <th>Entró a Banco de Hrs</th>
                                    <th>Usaste Banco de Hrs</th>
                                    <th>Saldo de Hrs Banco</th>
                                    <th>Total Hrs Adic. a Pagar</th>
                                    <th>Pago de Hrs Adicionales</th>
                                    <th>DESEMPEÑO %</th>
                                    <th>INCENTIVOS</th>
                                    <th>ASUETO</th>
                                    <th>IMSS</th>
                                    <th>Descuento por Falta</th>
                                    <th>Total de Ingresos</th>
                                    <th>Abono a Deuda</th>
                                    <th>Saldo Deuda</th>
                                    <th>Total a Pagar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in ObtenerDetallesVisiblesNomina())
                                {
                                    <tr class="@(d.DiasConMarcacion == 0 ? "table-warning" : null)">
                                        <td class="text-start align-top">
                                            <div class="fw-semibold">
                                                @d.Empleado.Nombre @d.Empleado.ApellidoPaterno
                                                <button class="btn btn-sm btn-outline-primary ms-1 py-0 px-1" type="button" @onclick="() => AbrirDetalleEmpleado(d)" title="Detalle día a día"><i class="bi bi-pencil-square"></i></button>
                                                <a class="btn btn-sm btn-outline-secondary py-0 px-1" href="@($"/rrhh/nominas/recibo/{d.Id}")" target="_blank" title="Recibo de nómina"><i class="bi bi-printer"></i></a>
                                            </div>
                                            <div class="text-muted">#@d.Empleado.NumeroEmpleado · Checador @d.Empleado.CodigoChecador</div>
                                            <div class="text-muted">@ObtenerNombreEsquema(d.EsquemaPagoId) · @d.Empleado.PeriodicidadPago</div>
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @if (TieneFestivosAplicados(d.EmpleadoId))
                                                {
                                                    <span class="badge text-bg-light" title="@ObtenerTextoFestivosAplicados(d.EmpleadoId)"><i class="bi bi-info-circle me-1"></i>Festivos</span>
                                                }
                                                @if (TieneDiferenciaAsistenciaNomina(d))
                                                {
                                                    <span class="badge text-bg-warning">Revisar asistencia</span>
                                                }
                                            </div>
                                        </td>
                                        <td>@ObtenerNumeroSemanaIso()</td>
                                        <td>@(nominaSeleccionada?.FechaInicio.ToString("dd-MMM"))</td>
                                        <td>@(nominaSeleccionada?.FechaFin.ToString("dd-MMM"))</td>
                                        <td>@ObtenerHorasPagadasResumen(d.EmpleadoId)</td>
                                        <td>@FormatearHorasResumen(d.HorasExtraBanco)</td>
                                        <td>@FmtHorasNeg(d.HorasBancoConsumidas)</td>
                                        <td>@FormatearHorasResumen(d.HorasBancoSaldoActual)</td>
                                        <td>@FormatearHorasResumen(d.HorasExtra)</td>
                                        <td class="text-end">@FmtDineroPos(ObtenerMontoHorasExtraPreview(d))</td>
                                        <td>@ObtenerDesempenoPct(d)</td>
                                        <td class="text-end">@FmtDineroPos(ObtenerIncentivos(d))</td>
                                        <td class="text-end">@FmtDineroPos(d.MontoFestivoTrabajado)</td>
                                        <td class="text-end text-danger">@FmtDineroNeg(d.CuotaImssObrera)</td>
                                        <td class="text-end text-danger">@FmtDineroNeg(d.MontoDescuentoMinutos)</td>
                                        <td class="text-end fw-semibold">@ObtenerTotalIngresos(d).ToString("C2")</td>
                                        <td class="text-end text-danger">@FmtDineroNeg(ObtenerAbonoDeuda(d))</td>
                                        <td>—</td>
                                        <td class="text-end fw-bold">@ObtenerTotalPagarPreview(d).ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td class="text-end" colspan="18">Total (@detallesNomina.Count):</td>
                                    <td class="text-end">@resumenNomina.TotalNeto.ToString("C2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="small text-muted mt-1"><i class="bi bi-info-circle me-1"></i>Fila en amarillo = empleado sin marcas en el periodo. Descuento por Falta = tiempo no laborado (retardo/salida/faltante) en $. El desglose día a día y el recibo se abren con <i class="bi bi-pencil-square"></i> en la celda Empleado.</div>
                }
            </div>

            @* Observaciones (NotasRecibo) aparte — no van en la tabla de asistencia para
               mantenerla compacta (sólo horas/días). Se listan los empleados con observaciones
               no vacías. NotasManual (override) gana sobre Notas (auto). English: observations
               (NotasRecibo) kept separate — kept out of the attendance table to keep it compact
               (hours/days only). Lists employees with non-empty observations. NotasManual
               (override) wins over Notas (auto). *@
            @{
                var detallesConNotas = detallesNomina
                    .Where(d => !string.IsNullOrWhiteSpace(d.NotasRecibo))
                    .OrderBy(d => d.Empleado.Nombre)
                    .ToList();
            }
            @if (detallesConNotas.Count > 0)
            {
                <div class="card-body border-bottom">
                    <details>
                        <summary class="fw-semibold small mb-2"><i class="bi bi-journal-text me-1"></i>Observaciones del periodo (@detallesConNotas.Count)</summary>
                        <ul class="list-group list-group-flush small mb-0">
                            @foreach (var d in detallesConNotas)
                            {
                                <li class="list-group-item px-0 py-1">
                                    <span class="fw-semibold">@d.Empleado.Nombre @d.Empleado.ApellidoPaterno</span>
                                    <span class="text-muted"> · #@d.Empleado.NumeroEmpleado</span>
                                    <div class="text-muted">@d.NotasRecibo</div>
                                </li>
                            }
                        </ul>
                    </details>
                </div>
            }


            @if (detalleModalSeleccionado != null)
            {
                var valesModal = ObtenerValesEmpleado(detalleModalSeleccionado.EmpleadoId);
                <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.45);" @onclick="CerrarDetalleEmpleado">
                    <div class="modal-dialog modal-xl modal-dialog-scrollable" @onclick:stopPropagation="true">
                        <div class="modal-content">
                            <div class="modal-header">
                                <div>
                                    <h5 class="modal-title mb-1">@detalleModalSeleccionado.Empleado.NombreCompleto</h5>
                                    <div class="small text-muted">@ObtenerNombreEsquema(detalleModalSeleccionado.EsquemaPagoId) · @detalleModalSeleccionado.Empleado.PeriodicidadPago</div>
                                </div>
                                <button type="button" class="btn-close" aria-label="Close" @onclick="CerrarDetalleEmpleado"></button>
                            </div>
                            <div class="modal-body">
                                <div class="d-flex flex-wrap gap-2 small mb-3">
                                    <span class="badge text-bg-light">Neto @ObtenerTotalPagarPreview(detalleModalSeleccionado).ToString("C2")</span>
                                    <span class="badge text-bg-light">Trab @detalleModalSeleccionado.DiasTrabajados</span>
                                    <span class="badge text-bg-light">Pag @detalleModalSeleccionado.DiasPagados</span>
                                    <span class="badge text-bg-light">Vac @detalleModalSeleccionado.DiasVacaciones</span>
                                    <span class="badge text-bg-light">Netas asistencia @ObtenerHorasTrabajadasNetasAsistencia(detalleModalSeleccionado.EmpleadoId).ToString("0.##") h</span>
                                    <span class="badge text-bg-light">Extra @detalleModalSeleccionado.HorasExtra.ToString("0.##") h</span>
                                    <span class="badge text-bg-light">Falt. desc. @detalleModalSeleccionado.MinutosFaltanteDescontable min</span>
                                    @if (TieneFestivosAplicados(detalleModalSeleccionado.EmpleadoId))
                                    {
                                        <span class="badge text-bg-light" title="@ObtenerTextoFestivosAplicados(detalleModalSeleccionado.EmpleadoId)">
                                            <i class="bi bi-info-circle me-1"></i>Festivos
                                        </span>
                                    }
                                </div>

                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    @if (PuedeModificarNominaSeleccionada)
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => EditarPercepcionesDetalleAsync(detalleModalSeleccionado)">
                                            <i class="bi bi-cash-coin me-1"></i>Percepciones
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EditarDeduccionesDetalleAsync(detalleModalSeleccionado)">
                                            <i class="bi bi-dash-circle me-1"></i>Deducciones
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => AbrirDistribucionBonos(detalleModalSeleccionado)">
                                            <i class="bi bi-percent me-1"></i>Distribución
                                        </button>
                                        <button class="btn btn-sm btn-primary" @onclick="() => GuardarCambiosDetalle(detalleModalSeleccionado)" disabled="@(guardando || !PuedeModificarNominaSeleccionada)">
                                            <i class="bi bi-save me-1"></i>Guardar detalle
                                        </button>
                                    }
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/rrhh/nominas/recibo/{detalleModalSeleccionado.Id}")" target="_blank">
                                        <i class="bi bi-printer me-1"></i>Recibo
                                    </a>
                                </div>

                                <div class="card border-info mb-3">
                                    <div class="card-header bg-info-subtle fw-semibold"><i class="bi bi-eye me-1"></i>Vista previa del recibo</div>
                                    <div class="card-body">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-semibold mb-1">Observaciones del recibo</label>
                                                <InputTextArea class="form-control form-control-sm" rows="3" @bind-Value="detalleModalSeleccionado.NotasManual" disabled="@(!PuedeModificarNominaSeleccionada)" placeholder="@detalleModalSeleccionado.Notas"></InputTextArea>
                                                <div class="d-flex justify-content-between align-items-center mt-1 small">
                                                    <span class="text-muted">Vacío = se usa la sugerencia automática.</span>
                                                    @if (PuedeModificarNominaSeleccionada)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-link py-0 px-1" @onclick="() => RestaurarNotasRecibo(detalleModalSeleccionado)">Restaurar sugerencia</button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="text-muted small mb-1">Así aparecerá en el recibo:</div>
                                                <div class="border rounded p-2 bg-light small">
                                                    <strong>Observaciones:</strong>
                                                    @(string.IsNullOrWhiteSpace(detalleModalSeleccionado.NotasRecibo) ? "(sin observaciones)" : detalleModalSeleccionado.NotasRecibo)
                                                </div>
                                                <div class="text-muted small mt-2"><i class="bi bi-qr-code me-1"></i>El QR del recibo se genera automático al exportar el PDF y apunta a este recibo.</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-lg-6">
                                        <div class="card h-100">
                                            <div class="card-header fw-semibold">Incidencias y tiempo</div>
                                            <div class="card-body">
                                                <div class="row g-2">
                                                    <div class="col-md-4">
                                                        <label class="form-label small mb-1">Trabajados</label>
                                                        <InputNumber class="form-control form-control-sm text-center" @bind-Value="detalleModalSeleccionado.DiasTrabajados" disabled="true" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small mb-1">Pagados</label>
                                                        <InputNumber class="form-control form-control-sm text-center" @bind-Value="detalleModalSeleccionado.DiasPagados" disabled="true" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small mb-1">Vacaciones</label>
                                                        <InputNumber class="form-control form-control-sm text-center" @bind-Value="detalleModalSeleccionado.DiasVacaciones" disabled="true" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small mb-1">Horas netas asistencia</label>
                                                        <input class="form-control form-control-sm text-end" value="@($"{ObtenerHorasTrabajadasNetasAsistencia(detalleModalSeleccionado.EmpleadoId):0.##}")" readonly />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small mb-1">Extra detectada</label>
                                                        <InputNumber class="form-control form-control-sm text-end" @bind-Value="detalleModalSeleccionado.HorasExtraBase" disabled="true" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small mb-1">Extra aprobada banco</label>
                                                        <InputNumber class="form-control form-control-sm text-end" @bind-Value="detalleModalSeleccionado.HorasExtraBanco" disabled="true" />
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="small text-muted">El tiempo neto trabajado viene de Asistencias. El tiempo extra solo se paga o manda a banco cuando existe resolución aprobada.</div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small mb-1">Extra aprobada pago</label>
                                                        <InputNumber class="form-control form-control-sm text-end" @bind-Value="detalleModalSeleccionado.HorasExtra" disabled="true" />
                                                    </div>
                                                    <div class="col-md-8">
                                                        @if (TieneDiferenciaAsistenciaNomina(detalleModalSeleccionado))
                                                        {
                                                            <div class="alert alert-warning py-2 small mb-0">@ObtenerMensajeDiferenciaAsistenciaNomina(detalleModalSeleccionado)</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="alert alert-success py-2 small mb-0">Tiempo aprobado sincronizado con Asistencias.</div>
                                                        }
                                                    </div>
                                                    @if (ObtenerDiasTiempoExtraPendiente(detalleModalSeleccionado.EmpleadoId) > 0)
                                                    {
                                                        <div class="col-12">
                                                            <div class="alert alert-info py-2 small mb-0">Hay @ObtenerDiasTiempoExtraPendiente(detalleModalSeleccionado.EmpleadoId) día(s) con tiempo extra pendiente de aprobación en Asistencias. Ese tiempo no se paga automáticamente.</div>
                                                        </div>
                                                    }
                                                    <div class="col-md-4">
                                                        <label class="form-label small mb-1">Tiempo descontado total (min)</label>
                                                        <input class="form-control form-control-sm text-end" value="@ObtenerMinutosDescuentoPreview(detalleModalSeleccionado)" readonly />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small mb-1">Minutos perdonados</label>
                                                        <input class="form-control form-control-sm text-end" value="@detalleModalSeleccionado.MinutosPerdonadosManual" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card h-100">
                                            <div class="card-header fw-semibold">Resumen legal y pago</div>
                                            <div class="card-body">
                                                <div class="row g-2 small">
                                                    <div class="col-md-6"><div class="border rounded p-2">Sueldo base<br /><strong>@detalleModalSeleccionado.SueldoBase.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Horas extra<br /><strong>@ObtenerMontoHorasExtraPreview(detalleModalSeleccionado).ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Destajo<br /><strong>@detalleModalSeleccionado.MontoDestajo.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Bono<br /><strong>@detalleModalSeleccionado.MontoBono.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Percepciones<br /><strong>@detalleModalSeleccionado.Bonos.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Complemento sal. mín.<br /><strong>@detalleModalSeleccionado.ComplementoSalarioMinimo.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Festivo<br /><strong>@detalleModalSeleccionado.MontoFestivoTrabajado.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Descanso<br /><strong>@detalleModalSeleccionado.MontoDescansoTrabajado.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Prima dominical<br /><strong>@detalleModalSeleccionado.MontoPrimaDominical.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Prima vacacional<br /><strong>@detalleModalSeleccionado.MontoPrimaVacacional.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Descuento por minutos<br /><strong class="text-danger">@detalleModalSeleccionado.MontoDescuentoMinutos.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Deducciones<br /><strong>@detalleModalSeleccionado.Deducciones.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">IMSS obrero<br /><strong>@detalleModalSeleccionado.CuotaImssObrera.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">ISR<br /><strong>@detalleModalSeleccionado.RetencionIsr.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Infonavit<br /><strong>@detalleModalSeleccionado.MontoInfonavit.ToString("C2")</strong></div></div>
                                                    <div class="col-md-6"><div class="border rounded p-2">Neto<br /><strong class="text-success">@ObtenerTotalPagarPreview(detalleModalSeleccionado).ToString("C2")</strong></div></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="card border-primary">
                                            <div class="card-header bg-primary-subtle fw-semibold">Desglose administrativo</div>
                                            <div class="card-body">
                                                <div class="row g-3 small">
                                                    <div class="col-lg-3 col-md-6">
                                                        <div class="border rounded p-3 h-100">
                                                            <div class="text-muted text-uppercase small fw-semibold">Neto empleado</div>
                                                            <div class="fw-bold text-success fs-6">@ObtenerTotalPagarPreview(detalleModalSeleccionado).ToString("C2")</div>
                                                            <div class="mt-2">Pago final del trabajador después de ISR, IMSS obrero, Infonavit y deducciones.</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-3 col-md-6">
                                                        <div class="border rounded p-3 h-100">
                                                            <div class="text-muted text-uppercase small fw-semibold">Obligaciones a terceros</div>
                                                            <div class="fw-bold fs-6">@detalleModalSeleccionado.TotalObligacionesTerceros.ToString("C2")</div>
                                                            <ul class="list-unstyled mt-2 mb-0">
                                                                <li>ISR: @detalleModalSeleccionado.RetencionIsr.ToString("C2")</li>
                                                                <li>IMSS obrero: @detalleModalSeleccionado.CuotaImssObrera.ToString("C2")</li>
                                                                <li>Infonavit: @detalleModalSeleccionado.MontoInfonavit.ToString("C2")</li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-3 col-md-6">
                                                        <div class="border rounded p-3 h-100">
                                                            <div class="text-muted text-uppercase small fw-semibold">Aportaciones patronales</div>
                                                            <div class="fw-bold fs-6">@detalleModalSeleccionado.TotalAportacionesPatronales.ToString("C2")</div>
                                                            <ul class="list-unstyled mt-2 mb-0">
                                                                <li>IMSS patronal: @detalleModalSeleccionado.CuotaImssPatronal.ToString("C2")</li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-3 col-md-6">
                                                        <div class="border rounded p-3 h-100">
                                                            <div class="text-muted text-uppercase small fw-semibold">Provisiones y costo</div>
                                                            <div class="fw-bold fs-6">@detalleModalSeleccionado.CostoEmpresa.ToString("C2")</div>
                                                            <ul class="list-unstyled mt-2 mb-0">
                                                                <li>Aguinaldo: @detalleModalSeleccionado.AguinaldoProvision.ToString("C2")</li>
                                                                <li>Prima vacacional: @detalleModalSeleccionado.PrimaVacacionalProvision.ToString("C2")</li>
                                                                <li>Otras provisiones: @ObtenerProvisionesConfigurables(detalleModalSeleccionado).ToString("C2")</li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>

                                                @if (detalleModalSeleccionado.ProvisionesDetalle.Any())
                                                {
                                                    <div class="table-responsive mt-3">
                                                        <table class="table table-sm table-bordered align-middle mb-0">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Concepto</th>
                                                                    <th class="text-end">Base</th>
                                                                    <th class="text-end">Cantidad</th>
                                                                    <th class="text-end">Tarifa</th>
                                                                    <th class="text-end">Importe</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var provision in detalleModalSeleccionado.ProvisionesDetalle.Where(p => p.IsActive).OrderBy(p => p.ConceptoConfig.Orden).ThenBy(p => p.ConceptoConfig.Nombre))
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            <div class="fw-semibold">@provision.ConceptoConfig.Nombre</div>
                                                                            <div class="small text-muted">@provision.ConceptoConfig.Clave</div>
                                                                        </td>
                                                                        <td class="text-end">@provision.BaseCalculo.ToString("C2")</td>
                                                                        <td class="text-end">@provision.Cantidad.ToString("0.####")</td>
                                                                        <td class="text-end">@provision.Tarifa.ToString("0.####")</td>
                                                                        <td class="text-end fw-semibold">@provision.Importe.ToString("C2")</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-header fw-semibold">Vales de destajo</div>
                                            <div class="card-body">
                                                @if (!valesModal.Any())
                                                {
                                                    <div class="small text-muted">No hay vales ligados en este período.</div>
                                                }
                                                else
                                                {
                                                    <div class="d-flex flex-column gap-2 small">
                                                        @foreach (var vale in valesModal)
                                                        {
                                                            <div class="border rounded px-2 py-2 bg-light">
                                                                <div class="fw-semibold">@vale.Folio · @vale.Fecha.ToString("dd/MM/yyyy")</div>
                                                                <div class="text-muted">@vale.TotalPiezas pz · @vale.Resumen</div>
                                                                @if (vale.RegistrosOrigen > 0)
                                                                {
                                                                    <div class="text-muted">@vale.RegistrosOrigen registro(s) de producción consolidados</div>
                                                                }
                                                                <div class="fw-semibold text-success">@vale.TotalImporte.ToString("C2")</div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    @if (detallePercepcionSeleccionado?.Id == detalleModalSeleccionado.Id)
                                    {
                                        <div class="col-12">
                                            <div class="card border-success">
                                                <div class="card-header bg-success-subtle d-flex justify-content-between align-items-center">
                                                    <strong>Percepciones manuales</strong>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CerrarEditorPercepciones">Cerrar</button>
                                                </div>
                                                <div class="card-body">
                                                    @if (tiposPercepcion.Count == 0)
                                                    {
                                                        <div class="alert alert-warning mb-0">No hay tipos de percepción configurados. Configúralos en <a href="/configuracion/nomina">Configuración de Nómina</a>.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="table-responsive mb-3">
                                                            <table class="table table-sm table-bordered align-middle mb-0">
                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <th>Tipo</th><th>Descripción</th><th>Referencia</th><th>Origen</th><th class="text-end">Importe</th><th></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (percepcionesEditando.Count == 0)
                                                                    {
                                                                        <tr><td colspan="6" class="text-center text-muted py-3">No hay percepciones manuales capturadas.</td></tr>
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var item in percepcionesEditando.OrderBy(p => p.Orden).ThenBy(p => p.TipoNombre))
                                                                        {
                                                                            <tr>
                                                                                <td><InputSelect class="form-select form-select-sm" @bind-Value="item.TipoPercepcionId" @bind-Value:after="() => OnTipoPercepcionChanged(item)" disabled="@(!PuedeModificarNominaSeleccionada)">@foreach (var tipo in tiposPercepcion) { <option value="@tipo.Id">@tipo.Nombre</option> }</InputSelect></td>
                                                                                <td><InputText class="form-control form-control-sm" @bind-Value="item.Descripcion" disabled="@(!PuedeModificarNominaSeleccionada)" /></td>
                                                                                <td><InputText class="form-control form-control-sm" @bind-Value="item.Referencia" disabled="@(!PuedeModificarNominaSeleccionada)" /></td>
                                                                                <td><InputSelect class="form-select form-select-sm" @bind-Value="item.Origen" disabled="@(!PuedeModificarNominaSeleccionada)">@foreach (var origen in Enum.GetValues<OrigenPercepcionNomina>()) { <option value="@origen">@origen</option> }</InputSelect></td>
                                                                                <td class="text-end"><InputNumber class="form-control form-control-sm text-end" @bind-Value="item.Importe" disabled="@(!PuedeModificarNominaSeleccionada)" /></td>
                                                                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => QuitarPercepcionManual(item)" disabled="@(!PuedeModificarNominaSeleccionada)"><i class="bi bi-trash"></i></button></td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-md-6">
                                                                <select class="form-select form-select-sm" @bind="tipoPercepcionSeleccionadoId" disabled="@(!PuedeModificarNominaSeleccionada)">
                                                                    <option value="">Seleccionar tipo...</option>
                                                                    @foreach (var tipo in tiposPercepcion)
                                                                    {
                                                                        <option value="@tipo.Id">@tipo.Nombre</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-md-2">
                                                                <button class="btn btn-sm btn-success w-100" @onclick="AgregarPercepcionManual" disabled="@(!PuedeModificarNominaSeleccionada)"><i class="bi bi-plus"></i></button>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                        <button class="btn btn-success" @onclick="GuardarPercepcionesDetalleAsync" disabled="@(guardando || !PuedeModificarNominaSeleccionada)"><i class="bi bi-save me-1"></i>Guardar percepciones</button>
                                                            <button class="btn btn-outline-secondary" @onclick="CerrarEditorPercepciones" disabled="@guardando">Cancelar</button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (detalleDeduccionSeleccionado?.Id == detalleModalSeleccionado.Id)
                                    {
                                        <div class="col-12">
                                            <div class="card border-danger">
                                                <div class="card-header bg-danger-subtle d-flex justify-content-between align-items-center">
                                                    <strong>Deducciones estructuradas</strong>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CerrarEditorDeducciones">Cerrar</button>
                                                </div>
                                                <div class="card-body">
                                                    @if (tiposDeduccion.Count == 0)
                                                    {
                                                        <div class="alert alert-warning mb-0">No hay tipos de deducción configurados. Configúralos en <a href="/configuracion/nomina">Configuración de Nómina</a>.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="table-responsive mb-3">
                                                            <table class="table table-sm table-bordered align-middle mb-0">
                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <th>Tipo</th><th>Descripción</th><th class="text-center">Legal</th><th class="text-end">Importe</th><th></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (deduccionesEditando.Count == 0)
                                                                    {
                                                                        <tr><td colspan="5" class="text-center text-muted py-3">No hay deducciones capturadas.</td></tr>
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var item in deduccionesEditando.OrderBy(d => d.Orden).ThenBy(d => d.TipoNombre))
                                                                        {
                                                                            <tr>
                                                                                <td><InputSelect class="form-select form-select-sm" @bind-Value="item.TipoDeduccionId" @bind-Value:after="() => OnTipoDeduccionChanged(item)" disabled="@(!PuedeModificarNominaSeleccionada)">@foreach (var tipo in tiposDeduccion) { <option value="@tipo.Id">@tipo.Nombre</option> }</InputSelect></td>
                                                                                <td><InputText class="form-control form-control-sm" @bind-Value="item.Descripcion" disabled="@(!PuedeModificarNominaSeleccionada)" /></td>
                                                                                <td class="text-center"><InputCheckbox class="form-check-input" @bind-Value="item.EsRetencionLegal" disabled="@(!PuedeModificarNominaSeleccionada)" /></td>
                                                                                <td class="text-end"><InputNumber class="form-control form-control-sm text-end" @bind-Value="item.Importe" disabled="@(!PuedeModificarNominaSeleccionada)" /></td>
                                                                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => QuitarDeduccion(item)" disabled="@(!PuedeModificarNominaSeleccionada)"><i class="bi bi-trash"></i></button></td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-md-6">
                                                                <select class="form-select form-select-sm" @bind="tipoDeduccionSeleccionadoId" disabled="@(!PuedeModificarNominaSeleccionada)">
                                                                    <option value="">Seleccionar tipo...</option>
                                                                    @foreach (var tipo in tiposDeduccion)
                                                                    {
                                                                        <option value="@tipo.Id">@tipo.Nombre</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-md-2">
                                                                <button class="btn btn-sm btn-danger w-100" @onclick="AgregarDeduccion" disabled="@(!PuedeModificarNominaSeleccionada)"><i class="bi bi-plus"></i></button>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                        <button class="btn btn-danger" @onclick="GuardarDeduccionesDetalleAsync" disabled="@(guardando || !PuedeModificarNominaSeleccionada)"><i class="bi bi-save me-1"></i>Guardar deducciones</button>
                                                            <button class="btn btn-outline-secondary" @onclick="CerrarEditorDeducciones" disabled="@guardando">Cancelar</button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="modal-footer">
                                <div class="small text-muted me-auto">Los cambios del empleado se aplican con <strong>Guardar detalle</strong> o con los botones de percepciones y deducciones.</div>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CerrarDetalleEmpleado">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ══ TABLA NÓMINAS ══ *@
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Folio</th><th>Nómina</th><th>Ciclo</th><th>Periodo</th><th>Inicio</th><th>Fin</th><th>Pago</th>
                        <th class="text-center">Estatus</th><th class="text-end">Total</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in nominas)
                    {
                        var total = n.Detalles.Sum(d => d.TotalPagar);
                        <tr class="@(nominaSeleccionada?.Id == n.Id ? "table-active" : "")">
                            <td class="fw-semibold">@(string.IsNullOrWhiteSpace(n.Folio) ? "—" : n.Folio)</td>
                            <td class="fw-semibold">@(string.IsNullOrWhiteSpace(n.NumeroNomina) ? "—" : n.NumeroNomina)</td>
                            <td><span class="badge text-bg-light">@ObtenerClavePeriodo(n.PeriodicidadPago, n.AnioPeriodo, n.NumeroPeriodo)</span></td>
                            <td class="fw-semibold">@n.Periodo</td>
                            <td>@n.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@n.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td>@(n.FechaPago?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span class="badge @EstatusBadge(n.Estatus)">@n.Estatus</span>
                                </div>
                            </td>
                            <td class="text-end fw-bold">@total.ToString("C2")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => VerDetalle(n)" title="Ver detalle"><i class="bi bi-eye"></i></button>
                                @if (_puedeEditar && !EstaBloqueadaNomina(n.Estatus))
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarNomina(n)" title="Editar"><i class="bi bi-pencil"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
</div>

@code {
    private List<Nomina> nominas = [];
    private List<NominaDetalle> detallesNomina = [];
    private Dictionary<Guid, ResumenAsistenciaNominaVm> resumenAsistenciaPorEmpleado = [];
    // Resumen neteo del periodo por empleado (el mismo batch que Asistencia Semanal) para mostrar
    // "Hrs Pagadas" (MinutosBasePagadaPeriodo) en la Fase A — horas base pagadas, no el total
    // trabajado. Es display; el cálculo de nómina sigue pagando sueldoDiario×diasPagados (Fija) o
    // minutos×sueldoHora (PorHoras). / Period netted summary per employee (same batch as Weekly
    // Attendances) to show "Paid Hrs" (MinutosBasePagadaPeriodo) in Phase A — paid base hours, not
    // total worked. Display-only; payroll still pays sueldoDiario×diasPagados (Fija) or
    // minutes×hourlyRate (PorHoras).
    private IReadOnlyDictionary<Guid, RrhhResolucionPeriodoResumen> resumenNeteoPorEmpleado = new Dictionary<Guid, RrhhResolucionPeriodoResumen>();
    private Dictionary<Guid, List<ValeResumenVm>> valesPorEmpleado = [];
    private Dictionary<Guid, string> esquemaNombrePorId = [];
    private List<Empleado> empleados = [];
    private List<NominaPercepcionTipo> tiposPercepcion = [];
    private List<DeduccionTipoRrhh> tiposDeduccion = [];
    private NominaConfiguracion configuracionNomina = new();
    private NominaCorteRrhh corteSemanal = new() { PeriodicidadPago = PeriodicidadPago.Semanal, DiaCorteSemana = DayOfWeek.Sunday, DiaPagoSugerido = DayOfWeek.Friday, IsActive = true };
    private NominaCorteRrhh corteQuincenal = new() { PeriodicidadPago = PeriodicidadPago.Quincenal, DiaCorteMes = 15, DiaPagoSugerido = DayOfWeek.Friday, IsActive = true };
    private NominaCorteRrhh corteMensual = new() { PeriodicidadPago = PeriodicidadPago.Mensual, DiaCorteMes = 31, DiaPagoSugerido = DayOfWeek.Friday, IsActive = true };
    private DateTime fechaReferenciaNomina = DateTime.Today;
    private List<FestivoRrhh> festivosPeriodo = [];
    private Dictionary<Guid, List<FestivoAplicadoVm>> festivosAplicadosPorEmpleado = [];
    private NominaDetalle detalleModalSeleccionado = null!;
    private Nomina editando = new();
    private NominaDetalle editandoDetalle = new();
    private NominaDetalle detallePercepcionSeleccionado = null!;
    private NominaDetalle detalleDeduccionSeleccionado = null!;
    private List<PercepcionManualEditor> percepcionesEditando = [];
    private string tipoPercepcionSeleccionadoId = string.Empty;
    private List<DeduccionEditor> deduccionesEditando = [];
    private string tipoDeduccionSeleccionadoId = string.Empty;
    private Nomina nominaSeleccionada = null!;
    private NominaResumenResult resumenNomina = new();
    private bool mostrarForm, mostrarFormDetalle, guardando;
    private string? error, ok;
    private bool _puedeVer;
    private bool _puedeEditar;
    private bool _nominaEditandoBloqueada;
    private Guid _empresaId;
    private ReglasPrenominaConfiguracion reglasPrenomina = new();

    // Fusión prenómina→nómina — Fase A "Resumen y captura del periodo". Filtro de empleados
    // y bandera de carga del snapshot de asistencias. English: prenómina→nómina fusion —
    // Phase A "Period summary and capture". Employee filter + snapshot-loading flag.
    private string filtroEmpleadosNomina = string.Empty;
    private bool cargandoSnapshot;

    private decimal TotalPercepcionesManualesEditando => percepcionesEditando.Sum(p => p.Importe);
    private decimal TotalDeduccionesEditando => deduccionesEditando.Sum(d => d.Importe);
    private bool PuedeModificarNominaEditando => _puedeEditar && !_nominaEditandoBloqueada;
    private bool PuedeModificarNominaSeleccionada => _puedeEditar && nominaSeleccionada is not null && !EstaBloqueadaNomina(nominaSeleccionada.Estatus);

    // Captura congelada = la nómina tiene FechaCierreCaptura (se estampó "Cerrar periodo y
    // calcular"). En Fase A esto vuelve read-only la asistencia. Reabrir captura la limpia.
    // English: frozen capture = the nómina has FechaCierreCaptura (stamped by "Close period
    // and calculate"). In Phase A this makes attendance read-only. Reopening clears it.
    private bool CapturaCerradaNominaSeleccionada => nominaSeleccionada is not null && nominaSeleccionada.FechaCierreCaptura.HasValue;
    private bool PuedeModificarCapturaNominaSeleccionada => PuedeModificarNominaSeleccionada && !CapturaCerradaNominaSeleccionada;
    private static IReadOnlyList<PeriodicidadPago> PeriodicidadesDisponibles { get; } = [PeriodicidadPago.Semanal, PeriodicidadPago.Quincenal, PeriodicidadPago.Mensual];

    protected override async Task OnInitializedAsync()
    {
        await CargarAcceso();
        if (_puedeVer)
        {
            await CargarConfiguracionNominaAsync();
            await Cargar();
        }
    }

    private async Task CargarConfiguracionNominaAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        configuracionNomina = await NominaConfiguracionLoader.LoadAsync(db);
        reglasPrenomina = configuracionNomina.ObtenerReglasPrenomina();

        corteSemanal = await CargarCortePeriodoAsync(db, PeriodicidadPago.Semanal, 31);
        corteQuincenal = await CargarCortePeriodoAsync(db, PeriodicidadPago.Quincenal, 15);
        corteMensual = await CargarCortePeriodoAsync(db, PeriodicidadPago.Mensual, 31);
    }

    private async Task CargarAcceso()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _puedeVer = state.User.HasClaim("Capacidad", "nominas.ver");
        _puedeEditar = state.User.HasClaim("Capacidad", "nominas.editar");
        _ = Guid.TryParse(state.User.FindFirst("EmpresaId")?.Value, out _empresaId);
    }

    private async Task Cargar()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        nominas = await db.Nominas.Include(n => n.Detalles).OrderByDescending(n => n.FechaInicio).AsNoTracking().ToListAsync();
        empleados = await db.Empleados.Where(e => e.IsActive).OrderBy(e => e.Nombre).AsNoTracking().ToListAsync();
        esquemaNombrePorId = await db.EsquemasPago.AsNoTracking().ToDictionaryAsync(e => e.Id, e => e.Nombre);
        tiposPercepcion = await db.NominasPercepcionesTipos.Where(t => t.IsActive).OrderBy(t => t.Orden).ThenBy(t => t.Nombre).AsNoTracking().ToListAsync();
        tiposDeduccion = await db.DeduccionesTiposRrhh.Where(t => t.IsActive).OrderBy(t => t.Orden).ThenBy(t => t.Nombre).AsNoTracking().ToListAsync();
    }

    private async Task CargarDetalles()
    {
        if (nominaSeleccionada == null)
        {
            detallesNomina = [];
            resumenAsistenciaPorEmpleado = [];
            resumenNeteoPorEmpleado = new Dictionary<Guid, RrhhResolucionPeriodoResumen>();
            RecalcularResumenNomina();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        detallesNomina = await db.NominaDetalles
            .Include(d => d.Empleado)
                .ThenInclude(e => e.Posicion)
                    .ThenInclude(p => p!.BonoEstructuraRrhh)
                        .ThenInclude(e => e!.Detalles)
                            .ThenInclude(d => d.BonoRubroRrhh)
            .Include(d => d.ProvisionesDetalle.Where(p => p.IsActive))
            .Where(d => d.NominaId == nominaSeleccionada.Id)
            .OrderBy(d => d.Empleado.Nombre)
            .AsNoTracking()
            .ToListAsync();
        await CargarResumenAsistenciaNominaAsync(nominaSeleccionada.FechaInicio, nominaSeleccionada.FechaFin, detallesNomina.Select(d => d.EmpleadoId));
        await CargarFestivosAplicadosAsync(nominaSeleccionada.FechaInicio, nominaSeleccionada.FechaFin, detallesNomina.Select(d => d.EmpleadoId));
        await CargarResumenNeteoPeriodoAsync();
        RecalcularResumenNomina();
    }

    // Carga el resumen neteo del periodo (el mismo batch que usa Asistencia Semanal) para mostrar
    // "Hrs Pagadas" = MinutosBasePagadaPeriodo en la Fase A. Una sola pasada por nómina; si el
    // periodo no tiene asistencias el resumen viene vacío y la columna muestra 0.
    // English: loads the period netted summary (the same batch Weekly Attendances uses) to show
    // "Paid Hrs" = MinutosBasePagadaPeriodo in Phase A. One pass per nómina; if the period has no
    // attendances the summary is empty and the column shows 0.
    private async Task CargarResumenNeteoPeriodoAsync()
    {
        var ids = detallesNomina.Select(d => d.EmpleadoId).Distinct().Where(id => id != Guid.Empty).ToList();
        if (ids.Count == 0 || nominaSeleccionada == null)
        {
            resumenNeteoPorEmpleado = new Dictionary<Guid, RrhhResolucionPeriodoResumen>();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var calendario = NominaPeriodoHelper.ObtenerPeriodo(
            nominaSeleccionada.PeriodicidadPago,
            nominaSeleccionada.FechaFin == default ? DateTime.Today : nominaSeleccionada.FechaFin,
            ObtenerCortePeriodo(nominaSeleccionada.PeriodicidadPago));
        resumenNeteoPorEmpleado = await ResolucionPeriodo.ObtenerResumenesPeriodoBatchAsync(
            db, _empresaId, ids,
            DateOnly.FromDateTime(nominaSeleccionada.FechaInicio),
            DateOnly.FromDateTime(nominaSeleccionada.FechaFin),
            nominaSeleccionada.PeriodicidadPago,
            calendario);
    }

    private async Task CargarResumenAsistenciaNominaAsync(DateTime inicio, DateTime fin, IEnumerable<Guid> empleadoIds)
    {
        var ids = empleadoIds.Distinct().Where(id => id != Guid.Empty).ToList();
        if (ids.Count == 0)
        {
            resumenAsistenciaPorEmpleado = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var asistencias = await db.RrhhAsistencias
            .AsNoTracking()
            .Where(a => ids.Contains(a.EmpleadoId)
                && a.Fecha >= DateOnly.FromDateTime(inicio)
                && a.Fecha <= DateOnly.FromDateTime(fin))
            .ToListAsync();

        resumenAsistenciaPorEmpleado = asistencias
            .GroupBy(a => a.EmpleadoId)
            .ToDictionary(
                g => g.Key,
                g => new ResumenAsistenciaNominaVm
                {
                    HorasTrabajadasNetas = Math.Round(g.Sum(a => RrhhTiempoExtraPolicy.ObtenerMinutosNetoEfectivo(a)) / 60m, 2),
                    HorasExtraDetectadas = Math.Round(g.Sum(a => Math.Max(0, a.MinutosExtra)) / 60m, 2),
                    HorasExtraAprobadasPago = Math.Round(g.Sum(a => Math.Max(0, a.MinutosExtraAutorizadosPago)) / 60m, 2),
                    HorasExtraAprobadasBanco = Math.Round(g.Sum(a => Math.Max(0, a.MinutosExtraAutorizadosBanco)) / 60m, 2),
                    DiasConTiempoExtraPendiente = g.Count(a => a.MinutosExtra > 0
                        && a.MinutosExtraAutorizadosPago == 0
                        && a.MinutosExtraAutorizadosBanco == 0
                        && string.IsNullOrWhiteSpace(a.ResolucionTiempoExtra))
                });
    }

    private async Task CargarDesgloseValesAsync()
    {
        valesPorEmpleado = [];

        if (nominaSeleccionada == null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var inicio = nominaSeleccionada.FechaInicio.Date;
        var fin = nominaSeleccionada.FechaFin.Date;

        var vales = await db.ValesDestajo 
            .Include(v => v.Detalles).ThenInclude(d => d.TipoProceso)
            .Include(v => v.Detalles).ThenInclude(d => d.RegistrosOrigen)
            .Where(v => v.IsActive
                && (v.Estatus == EstatusValeDestajo.Aprobado
                    || v.Estatus == EstatusValeDestajo.EnNomina
                    || v.Estatus == EstatusValeDestajo.Pagado)
                && v.Fecha >= inicio && v.Fecha <= fin)
            .OrderBy(v => v.EmpleadoId)
            .ThenBy(v => v.Fecha)
            .AsNoTracking()
            .ToListAsync();

        valesPorEmpleado = vales
            .GroupBy(v => v.EmpleadoId)
            .ToDictionary(
                g => g.Key,
                g => g.Select(v => new ValeResumenVm
                {
                    Folio = v.Folio,
                    Fecha = v.Fecha,
                    TotalPiezas = v.Detalles.Sum(d => d.Cantidad),
                    TotalImporte = v.Detalles.Sum(d => d.Importe),
                    RegistrosOrigen = v.Detalles.Sum(d => d.RegistrosOrigen.Count),
                    Resumen = string.Join(" + ", v.Detalles.Select(d => $"{d.TipoProceso?.Nombre} {d.Cantidad}pz"))
                }).ToList());
    }

    private async Task NuevaNomina()
    {
        if (!_puedeEditar)
        {
            error = "No tienes permisos para crear nóminas.";
            return;
        }

        error = ok = null;
        editando = new()
        {
            Id = Guid.Empty,
            Folio = null,
            PeriodicidadPago = PeriodicidadPago.Semanal
        };
        fechaReferenciaNomina = DateTime.Today;
        _nominaEditandoBloqueada = false;
        await AplicarPeriodoNominaAsync(editando.PeriodicidadPago, fechaReferenciaNomina);

        await using var db = await DbFactory.CreateDbContextAsync();
        var existente = await BuscarNominaExistenteAsync(db, editando.PeriodicidadPago, editando.AnioPeriodo, editando.NumeroPeriodo);
        if (existente != null)
        {
            await EditarNomina(existente);
            ok = $"Ya existe una nómina activa para el ciclo {ObtenerClavePeriodo(existente.PeriodicidadPago, existente.AnioPeriodo, existente.NumeroPeriodo)}. Se abrió el registro actual.";
            return;
        }

        mostrarForm = true;
    }

    private async Task EditarNomina(Nomina n)
    {
        if (!_puedeEditar)
        {
            error = "No tienes permisos para editar nóminas.";
            return;
        }

        if (EstaBloqueadaNomina(n.Estatus))
        {
            error = ObtenerMensajeBloqueoNomina(n.Estatus);
            return;
        }

        error = ok = null;
        _nominaEditandoBloqueada = false;
        editando = new()
        {
            Id = n.Id, Folio = n.Folio, NumeroNomina = n.NumeroNomina, PeriodicidadPago = n.PeriodicidadPago, AnioPeriodo = n.AnioPeriodo, NumeroPeriodo = n.NumeroPeriodo, Periodo = n.Periodo, FechaInicio = n.FechaInicio,
            FechaFin = n.FechaFin, FechaPago = n.FechaPago,
            Estatus = n.Estatus, Notas = n.Notas
        };
        await CargarFestivosPeriodoAsync(n.FechaInicio, n.FechaFin);
        mostrarForm = true;
    }

    private async Task VerDetalle(Nomina n)
    {
        nominaSeleccionada = n;
        detalleModalSeleccionado = null;
        detallePercepcionSeleccionado = null;
        percepcionesEditando = [];
        tipoPercepcionSeleccionadoId = string.Empty;
        detalleDeduccionSeleccionado = null;
        deduccionesEditando = [];
        tipoDeduccionSeleccionadoId = string.Empty;
        await CargarFestivosPeriodoAsync(n.FechaInicio, n.FechaFin);
        await CargarDetalles();
        await CargarDesgloseValesAsync();
        mostrarForm = false;
    }

    private void AbrirDistribucionBonos(NominaDetalle detalle)
    {
        error = ok = null;
        if (nominaSeleccionada == null)
            return;

        var estructura = detalle.Empleado.Posicion?.BonoEstructuraRrhh;
        if (detalle.Empleado.PosicionId is not Guid posicionId || estructura?.TipoCaptura != TipoCapturaBonoNomina.TotalDistribuido)
        {
            error = "Este empleado no usa bono distribuido. La distribución solo aplica a posiciones con esquema total distribuido.";
            return;
        }

        var inicio = Uri.EscapeDataString(nominaSeleccionada.FechaInicio.ToString("yyyy-MM-dd"));
        var fin = Uri.EscapeDataString(nominaSeleccionada.FechaFin.ToString("yyyy-MM-dd"));
        var empleadoId = Uri.EscapeDataString(detalle.EmpleadoId.ToString());
        var posicion = Uri.EscapeDataString(posicionId.ToString());
        Navigation.NavigateTo($"/rrhh/bonos-distribuidos?inicio={inicio}&fin={fin}&posicionId={posicion}&empleadoId={empleadoId}&autocargar=true");
    }

    private async Task EditarPercepcionesDetalleAsync(NominaDetalle detalle)
    {
        error = ok = null;
        detalleDeduccionSeleccionado = null;
        deduccionesEditando = [];
        tipoDeduccionSeleccionadoId = string.Empty;
        detallePercepcionSeleccionado = detalle;
        tipoPercepcionSeleccionadoId = string.Empty;

        await using var db = await DbFactory.CreateDbContextAsync();
        var percepciones = await db.NominasPercepciones
            .AsNoTracking()
            .Include(p => p.TipoPercepcion)
            .Where(p => p.NominaDetalleId == detalle.Id && p.IsActive)
            .OrderBy(p => p.CreatedAt)
            .ToListAsync();

        percepcionesEditando = percepciones.Select((p, index) => new PercepcionManualEditor
